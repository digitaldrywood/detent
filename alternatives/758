  "definition/table/authorizations": "[\"table\",\"authorizations\",\"authorizations\",\"CREATE TABLE authorizations (\\n  binding TEXT PRIMARY KEY,\\n  session_hash TEXT NOT NULL REFERENCES sessions(token_hash),\\n  organization_id TEXT NOT NULL,\\n  identity_json TEXT NOT NULL CHECK (json_valid(identity_json)),\\n  created_at TEXT NOT NULL,\\n  expires_at TEXT NOT NULL,\\n  revoked_at TEXT\\n, support INTEGER NOT NULL DEFAULT 0 CHECK (support IN (0, 1)), effective_email TEXT NOT NULL DEFAULT '', access_token TEXT NOT NULL DEFAULT '', refresh_token TEXT NOT NULL DEFAULT '')\"]",
