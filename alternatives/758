  "definition/table/oauth_clients": "[\"table\",\"oauth_clients\",\"oauth_clients\",\"CREATE TABLE oauth_clients (\\n    id TEXT PRIMARY KEY,\\n    name TEXT NOT NULL,\\n    auth_method TEXT NOT NULL CHECK (auth_method IN ('none','client_secret_post','client_secret_basic')),\\n    secret_hash TEXT NOT NULL,\\n    created_at TEXT NOT NULL\\n)\"]",
  "definition/table/oauth_grants": "[\"table\",\"oauth_grants\",\"oauth_grants\",\"CREATE TABLE oauth_grants (\\n    id TEXT PRIMARY KEY,\\n    client_id TEXT NOT NULL REFERENCES oauth_clients(id),\\n    owner_subject TEXT NOT NULL,\\n    owner_email TEXT NOT NULL,\\n    organization_id TEXT NOT NULL,\\n    permission TEXT NOT NULL CHECK (permission IN ('read','write','admin')),\\n    resource TEXT NOT NULL,\\n    created_at TEXT NOT NULL,\\n    last_used_at TEXT,\\n    revoked_at TEXT,\\n    access_hash TEXT UNIQUE,\\n    access_expires_at TEXT\\n)\"]",
