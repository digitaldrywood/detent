  "definition/table/access_key_organizations": "[\"table\",\"access_key_organizations\",\"access_key_organizations\",\"CREATE TABLE access_key_organizations (\\n    key_id TEXT NOT NULL REFERENCES access_keys(id) ON DELETE CASCADE,\\n    organization_id TEXT NOT NULL,\\n    blocked INTEGER NOT NULL DEFAULT 0 CHECK (blocked IN (0,1)),\\n    blocked_projects_json TEXT NOT NULL DEFAULT '[]',\\n    reached_at TEXT,\\n    last_used_at TEXT, approved_at TEXT,\\n    PRIMARY KEY (key_id, organization_id)\\n)\"]",
