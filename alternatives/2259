CREATE TABLE platform.organizations (
    id TEXT PRIMARY KEY CHECK (id LIKE 'org\_%' ESCAPE '\' AND length(id) <= 64),
    provider_id TEXT NOT NULL DEFAULT '' CHECK (length(provider_id) <= 128),
    name TEXT NOT NULL CHECK (length(name) BETWEEN 1 AND 120),
    state TEXT NOT NULL CHECK (state IN ('requested', 'allocating', 'ready', 'failed', 'disabled', 'deleting', 'deleted')),
    endpoint TEXT NOT NULL,
    generation BIGINT NOT NULL CHECK (generation >= 1),
    managed BOOLEAN NOT NULL DEFAULT false,
    creator_subject TEXT NOT NULL DEFAULT '',
    creator_email TEXT NOT NULL DEFAULT '',
    step TEXT NOT NULL DEFAULT '',
    attempts BIGINT NOT NULL DEFAULT 0,
    next_attempt_at TIMESTAMPTZ,
    error_code TEXT NOT NULL DEFAULT '',
    created_at TIMESTAMPTZ NOT NULL,
    updated_at TIMESTAMPTZ NOT NULL,
    error_detail TEXT NOT NULL DEFAULT '' CHECK (length(error_detail) <= 300),
    slug TEXT NOT NULL DEFAULT '',
    checkout_price TEXT NOT NULL DEFAULT ''
);

CREATE INDEX organizations_creator ON platform.organizations(creator_subject, state);

CREATE UNIQUE INDEX organizations_provider ON platform.organizations(provider_id) WHERE provider_id != '';

CREATE UNIQUE INDEX organizations_slug_idx ON platform.organizations(slug) WHERE slug <> '';

CREATE TABLE platform.organization_events (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    organization_id TEXT NOT NULL REFERENCES platform.organizations(id),
    event TEXT NOT NULL,
    generation BIGINT NOT NULL,
    recorded_at TIMESTAMPTZ NOT NULL,
    PRIMARY KEY(organization_id,id)
);

CREATE TABLE platform.organization_intents (
    subject TEXT NOT NULL,
    idempotency_key TEXT NOT NULL,
    fingerprint TEXT NOT NULL,
    organization_id TEXT NOT NULL UNIQUE REFERENCES platform.organizations(id),
    created_at TIMESTAMPTZ NOT NULL,
    PRIMARY KEY (subject, idempotency_key)
);

CREATE TABLE platform.organization_slugs (
    slug TEXT NOT NULL,
    organization_id TEXT NOT NULL REFERENCES platform.organizations(id) ON UPDATE CASCADE ON DELETE CASCADE,
    PRIMARY KEY (slug)
);

CREATE TABLE platform.billing_customers (
    mode TEXT NOT NULL CHECK (mode IN ('test', 'live')),
    account_id TEXT NOT NULL,
    customer_id TEXT NOT NULL,
    organization_id TEXT NOT NULL REFERENCES platform.organizations(id),
    created_at TIMESTAMPTZ NOT NULL,
    PRIMARY KEY (organization_id,mode, account_id, customer_id),
    UNIQUE(mode,account_id,customer_id)
);

CREATE UNIQUE INDEX billing_customers_organization ON platform.billing_customers(mode, account_id, organization_id);

CREATE TABLE platform.billing_events (
    event_id TEXT PRIMARY KEY,
    mode TEXT NOT NULL CHECK (mode IN ('test', 'live')),
    event_type TEXT NOT NULL,
    customer_id TEXT NOT NULL,
    charge_id TEXT NOT NULL DEFAULT '',
    organization_id TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL CHECK (status IN ('pending', 'delivered', 'quarantined', 'ignored')),
    attempts BIGINT NOT NULL DEFAULT 0,
    received_at TIMESTAMPTZ NOT NULL,
    updated_at TIMESTAMPTZ NOT NULL
);

CREATE INDEX billing_events_pending ON platform.billing_events(status, received_at) WHERE status = 'pending';

CREATE TABLE platform.entitlement_changes (
    organization_id TEXT NOT NULL REFERENCES platform.organizations(id),
    idempotency_key TEXT NOT NULL CHECK (length(idempotency_key) BETWEEN 1 AND 128),
    action TEXT NOT NULL CHECK (action IN ('grant', 'revoke', 'create_plan', 'base', 'subscription', 'end_subscription')),
    grant_id TEXT NOT NULL,
    plan_id TEXT NOT NULL,
    plan_version BIGINT NOT NULL,
    expires_at TIMESTAMPTZ,
    reason TEXT NOT NULL CHECK (length(reason) BETWEEN 1 AND 500),
    staff_email TEXT NOT NULL,
    staff_subject TEXT NOT NULL,
    recorded_at TIMESTAMPTZ NOT NULL,
    PRIMARY KEY (organization_id, idempotency_key)
);

CREATE INDEX entitlement_changes_grant ON platform.entitlement_changes(organization_id, grant_id, action);

CREATE TABLE platform.platform_members (
    email TEXT PRIMARY KEY,
    role TEXT NOT NULL CHECK (role IN ('admin','support','billing','viewer')),
    added_by TEXT NOT NULL,
    added_at TIMESTAMPTZ NOT NULL,
    updated_at TIMESTAMPTZ NOT NULL
);

CREATE TABLE platform.platform_member_changes (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    email TEXT NOT NULL,
    action TEXT NOT NULL CHECK (action IN ('added','role_changed','removed','seeded')),
    previous_role TEXT NOT NULL DEFAULT '',
    role TEXT NOT NULL DEFAULT '',
    actor_email TEXT NOT NULL,
    actor_subject TEXT NOT NULL,
    reason TEXT NOT NULL,
    recorded_at TIMESTAMPTZ NOT NULL
);

CREATE INDEX platform_member_changes_recorded_at ON platform.platform_member_changes(recorded_at);

CREATE TABLE platform.platform_notifications (
    event TEXT NOT NULL CHECK (event IN ('signup', 'organization')),
    entity_id TEXT NOT NULL,
    email TEXT NOT NULL,
    name TEXT NOT NULL,
    plan TEXT NOT NULL,
    occurred_at TIMESTAMPTZ NOT NULL,
    attempted_at TIMESTAMPTZ,
    PRIMARY KEY (event, entity_id)
);

CREATE INDEX platform_notifications_pending ON platform.platform_notifications(occurred_at) WHERE attempted_at IS NULL;

CREATE TABLE platform.archive_storage_bindings (
    organization_id TEXT NOT NULL REFERENCES platform.organizations(id),
    id TEXT NOT NULL,
    revision BIGINT NOT NULL CHECK(revision>=0),
    backend TEXT NOT NULL CHECK(backend IN ('hosted','s3')),
    endpoint TEXT NOT NULL,
    region TEXT NOT NULL,
    bucket TEXT NOT NULL,
    prefix TEXT NOT NULL,
    credential_reference TEXT NOT NULL,
    versioned BOOLEAN,
    PRIMARY KEY(organization_id,id),
    UNIQUE(organization_id,revision)
);

CREATE INDEX archive_storage_binding_origins ON platform.archive_storage_bindings(organization_id, lower(endpoint));

CREATE TABLE platform.archive_deletion_receipts (
    organization_id TEXT NOT NULL REFERENCES platform.organizations(id),
    binding_id TEXT NOT NULL,
    complete BOOLEAN NOT NULL,
    truncated BOOLEAN NOT NULL,
    attempts BIGINT NOT NULL,
    updated_at TIMESTAMPTZ NOT NULL,
    PRIMARY KEY(organization_id,binding_id)
);

CREATE TABLE platform.archive_deletion_failures (
    organization_id TEXT NOT NULL,
    binding_id TEXT NOT NULL,
    ordinal BIGINT NOT NULL,
    object_key TEXT NOT NULL,
    version_id TEXT NOT NULL,
    error_code TEXT NOT NULL,
    PRIMARY KEY(organization_id,binding_id,ordinal),
    FOREIGN KEY(organization_id,binding_id) REFERENCES platform.archive_deletion_receipts(organization_id,binding_id)
);

CREATE TABLE platform.sessions (
    token_hash TEXT PRIMARY KEY,
    subject TEXT NOT NULL,
    email TEXT NOT NULL,
    csrf_secret TEXT NOT NULL,
    identity_subject TEXT NOT NULL,
    provider_organization_id TEXT NOT NULL DEFAULT '',
    provider_session_id TEXT NOT NULL,
    identity_created_at TIMESTAMPTZ NOT NULL,
    identity_expires_at TIMESTAMPTZ NOT NULL,
    support_actor TEXT NOT NULL DEFAULT '',
    support_reason TEXT NOT NULL DEFAULT '',
    created_at TIMESTAMPTZ NOT NULL,
    expires_at TIMESTAMPTZ NOT NULL,
    revoked_at TIMESTAMPTZ,
    CHECK (subject=identity_subject)
);

CREATE TABLE platform.authorizations (
    binding TEXT NOT NULL,
    session_hash TEXT NOT NULL REFERENCES platform.sessions(token_hash),
    organization_id TEXT NOT NULL REFERENCES platform.organizations(id),
    identity_subject TEXT NOT NULL,
    provider_organization_id TEXT NOT NULL DEFAULT '',
    provider_session_id TEXT NOT NULL,
    identity_created_at TIMESTAMPTZ NOT NULL,
    identity_expires_at TIMESTAMPTZ NOT NULL,
    support_actor TEXT NOT NULL DEFAULT '',
    support_reason TEXT NOT NULL DEFAULT '',
    created_at TIMESTAMPTZ NOT NULL,
    expires_at TIMESTAMPTZ NOT NULL,
    revoked_at TIMESTAMPTZ,
    support BOOLEAN NOT NULL DEFAULT false,
    effective_email TEXT NOT NULL DEFAULT '',
    access_token TEXT NOT NULL DEFAULT '',
    refresh_token TEXT NOT NULL DEFAULT '',
    CHECK(support=(support_actor<>'')),
    PRIMARY KEY(organization_id,binding),
    UNIQUE(organization_id,session_hash,binding)
);

CREATE TABLE platform.transactions (
    token_hash TEXT PRIMARY KEY,
    transaction_id TEXT NOT NULL UNIQUE,
    state TEXT NOT NULL,
    verifier TEXT NOT NULL,
    organization_id TEXT NOT NULL DEFAULT '',
    return_path TEXT NOT NULL DEFAULT '',
    invitation_token TEXT NOT NULL DEFAULT '',
    invitation_organization TEXT NOT NULL DEFAULT '',
    expires_at TIMESTAMPTZ NOT NULL,
    consumed_at TIMESTAMPTZ,
    support_actor TEXT NOT NULL DEFAULT '',
    support_session TEXT NOT NULL DEFAULT '',
    support_reason TEXT NOT NULL DEFAULT ''
);

CREATE TABLE platform.audit (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    subject TEXT NOT NULL,
    organization_id TEXT NOT NULL,
    event TEXT NOT NULL,
    event_object_key TEXT,
    retry_identity TEXT,
    amount_usd NUMERIC,
    reason TEXT,
    recorded_at TIMESTAMPTZ NOT NULL,
    query_length BIGINT
);

CREATE INDEX audit_subject_event ON platform.audit(subject, event);

CREATE TABLE platform.access_keys (
    id TEXT PRIMARY KEY,
    token_hash TEXT NOT NULL UNIQUE,
    name TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('personal','service')),
    owner_subject TEXT NOT NULL,
    owner_email TEXT NOT NULL,
    permission TEXT NOT NULL CHECK (permission IN ('read','write','admin')),
    access_context TEXT NOT NULL CHECK (access_context IN ('global','selected','project')),
    service_organization_id TEXT REFERENCES platform.organizations(id),
    created_at TIMESTAMPTZ NOT NULL,
    expires_at TIMESTAMPTZ,
    revoked_at TIMESTAMPTZ
);

CREATE INDEX access_keys_owner ON platform.access_keys(owner_subject, created_at);

CREATE TABLE platform.organization_key_policy (
    organization_id TEXT PRIMARY KEY REFERENCES platform.organizations(id),
    personal_keys TEXT NOT NULL DEFAULT 'allowed' CHECK (personal_keys IN ('allowed','approval','blocked'))
);

CREATE TABLE platform.access_key_organizations (
    key_id TEXT NOT NULL REFERENCES platform.access_keys(id) ON DELETE CASCADE,
    organization_id TEXT NOT NULL REFERENCES platform.organizations(id),
    blocked BOOLEAN NOT NULL DEFAULT false,
    project_access TEXT NOT NULL DEFAULT 'all' CHECK (project_access IN ('all','selected','project')),
    selected BOOLEAN NOT NULL DEFAULT false,
    reached_at TIMESTAMPTZ,
    last_used_at TIMESTAMPTZ,
    approved_at TIMESTAMPTZ,
    PRIMARY KEY (organization_id, key_id)
);

CREATE INDEX access_key_selected_organizations ON platform.access_key_organizations(key_id,organization_id) WHERE selected;

CREATE TABLE platform.access_key_notifications (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    owner_subject TEXT NOT NULL,
    key_id TEXT NOT NULL,
    organization_id TEXT NOT NULL,
    project_id TEXT NOT NULL DEFAULT '',
    created_at TIMESTAMPTZ NOT NULL,
    PRIMARY KEY(organization_id,id),
    FOREIGN KEY(organization_id,key_id) REFERENCES platform.access_key_organizations(organization_id,key_id) ON DELETE CASCADE
);

CREATE TABLE platform.github_user_connections (
    owner_subject TEXT PRIMARY KEY,
    id TEXT NOT NULL UNIQUE,
    access_token TEXT NOT NULL,
    expires_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL,
    revoked_at TIMESTAMPTZ
);

CREATE TABLE platform.oauth_clients (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    auth_method TEXT NOT NULL CHECK (auth_method IN ('none','client_secret_post','client_secret_basic')),
    secret_hash TEXT NOT NULL,
    created_at TIMESTAMPTZ NOT NULL
);

CREATE TABLE platform.oauth_client_redirect_uris (
    client_id TEXT NOT NULL REFERENCES platform.oauth_clients(id) ON DELETE CASCADE,
    position BIGINT NOT NULL,
    uri TEXT NOT NULL,
    PRIMARY KEY (client_id, position)
);

CREATE TABLE platform.oauth_grants (
    id TEXT NOT NULL,
    client_id TEXT NOT NULL REFERENCES platform.oauth_clients(id),
    owner_subject TEXT NOT NULL,
    owner_email TEXT NOT NULL,
    organization_id TEXT NOT NULL REFERENCES platform.organizations(id),
    permission TEXT NOT NULL CHECK (permission IN ('read','write','admin')),
    resource TEXT NOT NULL,
    created_at TIMESTAMPTZ NOT NULL,
    last_used_at TIMESTAMPTZ,
    revoked_at TIMESTAMPTZ,
    access_hash TEXT UNIQUE,
    access_expires_at TIMESTAMPTZ,
    PRIMARY KEY(organization_id,id),
    UNIQUE(organization_id,id,client_id)
);

CREATE TABLE platform.oauth_refresh_tokens (
    token_hash TEXT NOT NULL,
    grant_id TEXT NOT NULL,
    expires_at TIMESTAMPTZ NOT NULL,
    organization_id TEXT NOT NULL,
    FOREIGN KEY(organization_id,grant_id) REFERENCES platform.oauth_grants(organization_id,id) ON DELETE CASCADE,
    PRIMARY KEY(organization_id,token_hash),
    UNIQUE(token_hash),
    UNIQUE(organization_id,grant_id)
);

CREATE TABLE platform.oauth_requests (
    id TEXT PRIMARY KEY,
    client_id TEXT NOT NULL REFERENCES platform.oauth_clients(id),
    redirect_uri TEXT NOT NULL,
    challenge TEXT NOT NULL,
    resource TEXT NOT NULL,
    code_hash TEXT NOT NULL UNIQUE,
    code_expires_at TIMESTAMPTZ NOT NULL,
    grant_id TEXT NOT NULL,
    consumed_at TIMESTAMPTZ,
    organization_id TEXT NOT NULL,
    FOREIGN KEY(organization_id,grant_id,client_id) REFERENCES platform.oauth_grants(organization_id,id,client_id) ON DELETE CASCADE
);

CREATE TABLE platform.oauth_spent_refresh_tokens (
    token_hash TEXT NOT NULL,
    grant_id TEXT NOT NULL,
    expires_at TIMESTAMPTZ NOT NULL,
    organization_id TEXT NOT NULL,
    FOREIGN KEY(organization_id,grant_id) REFERENCES platform.oauth_grants(organization_id,id) ON DELETE CASCADE,
    PRIMARY KEY(organization_id,token_hash),
    UNIQUE(token_hash)
);

CREATE TABLE platform.auth_notifications (
    event TEXT NOT NULL CHECK (event IN ('signup', 'organization')),
    entity_id TEXT NOT NULL,
    email TEXT NOT NULL,
    name TEXT NOT NULL,
    plan TEXT NOT NULL,
    occurred_at TIMESTAMPTZ NOT NULL,
    attempted_at TIMESTAMPTZ,
    PRIMARY KEY (event, entity_id)
);

CREATE INDEX auth_notifications_pending ON platform.auth_notifications(occurred_at) WHERE attempted_at IS NULL;

CREATE UNIQUE INDEX authorizations_active ON platform.authorizations(organization_id,session_hash) WHERE revoked_at IS NULL;
CREATE INDEX authorizations_session ON platform.authorizations(session_hash,organization_id,binding) WHERE revoked_at IS NULL;
CREATE INDEX sessions_owner ON platform.sessions(subject,token_hash) WHERE revoked_at IS NULL;
CREATE INDEX oauth_grants_owner ON platform.oauth_grants(organization_id,owner_subject,created_at,id);
CREATE INDEX oauth_spent_refresh_tokens_grant ON platform.oauth_spent_refresh_tokens(organization_id,grant_id);
CREATE TABLE platform.access_key_projects (
    organization_id TEXT NOT NULL,
    key_id TEXT NOT NULL,
    project_id TEXT NOT NULL,
    PRIMARY KEY(organization_id,key_id,project_id),
    FOREIGN KEY(organization_id,key_id) REFERENCES platform.access_key_organizations(organization_id,key_id) ON DELETE CASCADE
);
CREATE TABLE platform.access_key_blocked_projects (
    organization_id TEXT NOT NULL,
    key_id TEXT NOT NULL,
    project_id TEXT NOT NULL,
    PRIMARY KEY(organization_id,key_id,project_id),
    FOREIGN KEY(organization_id,key_id) REFERENCES platform.access_key_organizations(organization_id,key_id) ON DELETE CASCADE
);
