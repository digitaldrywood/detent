  "definition/table/archive_deletion_failures": "[\"table\",\"archive_deletion_failures\",\"archive_deletion_failures\",\"CREATE TABLE archive_deletion_failures (\\n organization_id TEXT NOT NULL,\\n binding_id TEXT NOT NULL,\\n ordinal INTEGER NOT NULL,\\n object_key TEXT NOT NULL,\\n version_id TEXT NOT NULL,\\n error_code TEXT NOT NULL,\\n PRIMARY KEY(organization_id,binding_id,ordinal),\\n FOREIGN KEY(organization_id,binding_id) REFERENCES archive_deletion_receipts(organization_id,binding_id)\\n)\"]",
  "definition/table/archive_deletion_receipts": "[\"table\",\"archive_deletion_receipts\",\"archive_deletion_receipts\",\"CREATE TABLE archive_deletion_receipts (\\n organization_id TEXT NOT NULL REFERENCES organizations(id),\\n binding_id TEXT NOT NULL,\\n complete INTEGER NOT NULL CHECK(complete IN (0,1)),\\n truncated INTEGER NOT NULL CHECK(truncated IN (0,1)),\\n attempts INTEGER NOT NULL,\\n updated_at TEXT NOT NULL,\\n PRIMARY KEY(organization_id,binding_id)\\n)\"]",
  "definition/table/archive_storage_bindings": "[\"table\",\"archive_storage_bindings\",\"archive_storage_bindings\",\"CREATE TABLE archive_storage_bindings (\\n organization_id TEXT NOT NULL REFERENCES organizations(id),\\n id TEXT NOT NULL,\\n revision INTEGER NOT NULL CHECK(revision\\u003e=0),\\n backend TEXT NOT NULL CHECK(backend IN ('hosted','s3')),\\n endpoint TEXT NOT NULL,\\n region TEXT NOT NULL,\\n bucket TEXT NOT NULL,\\n prefix TEXT NOT NULL,\\n credential_reference TEXT NOT NULL,\\n versioned INTEGER CHECK(versioned IN (0,1)),\\n PRIMARY KEY(organization_id,id),\\n UNIQUE(organization_id,revision)\\n)\"]",
  "definition/table/billing_customers": "[\"table\",\"billing_customers\",\"billing_customers\",\"CREATE TABLE billing_customers (\\n  mode TEXT NOT NULL CHECK (mode IN ('test', 'live')),\\n  account_id TEXT NOT NULL,\\n  customer_id TEXT NOT NULL,\\n  organization_id TEXT NOT NULL REFERENCES organizations(id),\\n  created_at TEXT NOT NULL,\\n  PRIMARY KEY (mode, account_id, customer_id)\\n)\"]",
  "definition/table/billing_events": "[\"table\",\"billing_events\",\"billing_events\",\"CREATE TABLE billing_events (\\n  event_id TEXT PRIMARY KEY,\\n  mode TEXT NOT NULL CHECK (mode IN ('test', 'live')),\\n  event_type TEXT NOT NULL,\\n  customer_id TEXT NOT NULL,\\n  charge_id TEXT NOT NULL DEFAULT '',\\n  organization_id TEXT NOT NULL DEFAULT '',\\n  status TEXT NOT NULL CHECK (status IN ('pending', 'delivered', 'quarantined', 'ignored')),\\n  attempts INTEGER NOT NULL DEFAULT 0,\\n  received_at TEXT NOT NULL,\\n  updated_at TEXT NOT NULL\\n)\"]",
  "definition/table/entitlement_changes": "[\"table\",\"entitlement_changes\",\"entitlement_changes\",\"CREATE TABLE \\\"entitlement_changes\\\" (\\n  organization_id TEXT NOT NULL REFERENCES organizations(id),\\n  idempotency_key TEXT NOT NULL CHECK (length(idempotency_key) BETWEEN 1 AND 128),\\n  action TEXT NOT NULL CHECK (action IN ('grant', 'revoke', 'create_plan', 'base', 'subscription', 'end_subscription')),\\n  grant_id TEXT NOT NULL,\\n  plan_id TEXT NOT NULL,\\n  plan_version INTEGER NOT NULL,\\n  expires_at TEXT NOT NULL DEFAULT '',\\n  reason TEXT NOT NULL CHECK (length(reason) BETWEEN 1 AND 500),\\n  staff_email TEXT NOT NULL,\\n  staff_subject TEXT NOT NULL,\\n  recorded_at TEXT NOT NULL,\\n  PRIMARY KEY (organization_id, idempotency_key)\\n)\"]",
  "definition/table/entry_schema_version": "[\"table\",\"entry_schema_version\",\"entry_schema_version\",\"CREATE TABLE entry_schema_version (\\n\\t\\tid INTEGER PRIMARY KEY AUTOINCREMENT,\\n\\t\\tversion_id INTEGER NOT NULL,\\n\\t\\tis_applied INTEGER NOT NULL,\\n\\t\\ttstamp TIMESTAMP DEFAULT (datetime('now'))\\n\\t)\"]",
  "definition/table/organization_events": "[\"table\",\"organization_events\",\"organization_events\",\"CREATE TABLE \\\"organization_events\\\" (\\n  id INTEGER PRIMARY KEY,\\n  organization_id TEXT NOT NULL REFERENCES \\\"organizations\\\"(id),\\n  event TEXT NOT NULL,\\n  generation INTEGER NOT NULL,\\n  recorded_at TEXT NOT NULL\\n)\"]",
  "definition/table/organization_intents": "[\"table\",\"organization_intents\",\"organization_intents\",\"CREATE TABLE organization_intents (\\n  subject TEXT NOT NULL,\\n  idempotency_key TEXT NOT NULL,\\n  fingerprint TEXT NOT NULL,\\n  organization_id TEXT NOT NULL UNIQUE REFERENCES organizations(id),\\n  created_at TEXT NOT NULL,\\n  PRIMARY KEY (subject, idempotency_key)\\n)\"]",
  "definition/table/organization_slugs": "[\"table\",\"organization_slugs\",\"organization_slugs\",\"CREATE TABLE organization_slugs (slug TEXT NOT NULL, organization_id TEXT NOT NULL REFERENCES organizations(id) ON UPDATE CASCADE ON DELETE CASCADE, PRIMARY KEY (slug))\"]",
  "definition/table/organizations": "[\"table\",\"organizations\",\"organizations\",\"CREATE TABLE \\\"organizations\\\" (\\n  id TEXT PRIMARY KEY CHECK (id GLOB 'org_*' AND length(id) \\u003c= 64),\\n  provider_id TEXT NOT NULL DEFAULT '' CHECK (length(provider_id) \\u003c= 128),\\n  name TEXT NOT NULL CHECK (length(name) BETWEEN 1 AND 120),\\n  state TEXT NOT NULL CHECK (state IN ('requested', 'allocating', 'ready', 'failed', 'disabled', 'deleting', 'deleted')),\\n  endpoint TEXT NOT NULL,\\n  generation INTEGER NOT NULL CHECK (generation \\u003e= 1),\\n  managed INTEGER NOT NULL DEFAULT 0 CHECK (managed IN (0, 1)),\\n  creator_subject TEXT NOT NULL DEFAULT '',\\n  creator_email TEXT NOT NULL DEFAULT '',\\n  step TEXT NOT NULL DEFAULT '',\\n  attempts INTEGER NOT NULL DEFAULT 0,\\n  next_attempt_at TEXT NOT NULL DEFAULT '',\\n  error_code TEXT NOT NULL DEFAULT '',\\n  created_at TEXT NOT NULL,\\n  updated_at TEXT NOT NULL\\n, error_detail TEXT NOT NULL DEFAULT '' CHECK (length(error_detail) \\u003c= 300), slug TEXT NOT NULL DEFAULT '', checkout_price TEXT NOT NULL DEFAULT '')\"]",
  "definition/table/platform_member_changes": "[\"table\",\"platform_member_changes\",\"platform_member_changes\",\"CREATE TABLE platform_member_changes (\\n  id INTEGER PRIMARY KEY,\\n  email TEXT NOT NULL,\\n  action TEXT NOT NULL CHECK (action IN ('added','role_changed','removed','seeded')),\\n  previous_role TEXT NOT NULL DEFAULT '',\\n  role TEXT NOT NULL DEFAULT '',\\n  actor_email TEXT NOT NULL,\\n  actor_subject TEXT NOT NULL,\\n  reason TEXT NOT NULL,\\n  recorded_at TEXT NOT NULL\\n)\"]",
  "definition/table/platform_members": "[\"table\",\"platform_members\",\"platform_members\",\"CREATE TABLE platform_members (\\n  email TEXT PRIMARY KEY,\\n  role TEXT NOT NULL CHECK (role IN ('admin','support','billing','viewer')),\\n  added_by TEXT NOT NULL,\\n  added_at TEXT NOT NULL,\\n  updated_at TEXT NOT NULL\\n)\"]",
  "definition/table/platform_notifications": "[\"table\",\"platform_notifications\",\"platform_notifications\",\"CREATE TABLE platform_notifications (\\n  event TEXT NOT NULL CHECK (event IN ('signup', 'organization')),\\n  entity_id TEXT NOT NULL,\\n  email TEXT NOT NULL,\\n  name TEXT NOT NULL,\\n  plan TEXT NOT NULL,\\n  occurred_at TEXT NOT NULL,\\n  attempted_at TEXT,\\n  PRIMARY KEY (event, entity_id)\\n)\"]",
  "definition/table/sqlite_sequence": "[\"table\",\"sqlite_sequence\",\"sqlite_sequence\",\"CREATE TABLE sqlite_sequence(name,seq)\"]",
  "definition/trigger/archive_storage_binding_immutable": "[\"trigger\",\"archive_storage_binding_immutable\",\"archive_storage_bindings\",\"CREATE TRIGGER archive_storage_binding_immutable BEFORE UPDATE ON archive_storage_bindings\\nBEGIN SELECT RAISE(ABORT,'immutable storage binding'); END\"]",
  "definition/trigger/billing_customer_delete": "[\"trigger\",\"billing_customer_delete\",\"billing_customers\",\"CREATE TRIGGER billing_customer_delete BEFORE DELETE ON billing_customers\\nBEGIN\\n  SELECT RAISE(ABORT, 'billing customer mappings are retained');\\nEND\"]",
  "definition/trigger/billing_customer_immutable": "[\"trigger\",\"billing_customer_immutable\",\"billing_customers\",\"CREATE TRIGGER billing_customer_immutable BEFORE UPDATE ON billing_customers\\nBEGIN\\n  SELECT RAISE(ABORT, 'billing customer mappings are immutable');\\nEND\"]",
  "definition/trigger/entitlement_change_delete": "[\"trigger\",\"entitlement_change_delete\",\"entitlement_changes\",\"CREATE TRIGGER entitlement_change_delete BEFORE DELETE ON entitlement_changes\\nBEGIN\\n  SELECT RAISE(ABORT, 'entitlement change records are retained');\\nEND\"]",
  "definition/trigger/entitlement_change_immutable": "[\"trigger\",\"entitlement_change_immutable\",\"entitlement_changes\",\"CREATE TRIGGER entitlement_change_immutable BEFORE UPDATE ON entitlement_changes\\nBEGIN\\n  SELECT RAISE(ABORT, 'entitlement change records are immutable');\\nEND\"]",
  "definition/trigger/organization_delete": "[\"trigger\",\"organization_delete\",\"organizations\",\"CREATE TRIGGER organization_delete BEFORE DELETE ON organizations\\nBEGIN\\n  SELECT RAISE(ABORT, 'organization records are retained');\\nEND\"]",
  "definition/trigger/organization_identity_immutable": "[\"trigger\",\"organization_identity_immutable\",\"organizations\",\"CREATE TRIGGER organization_identity_immutable BEFORE UPDATE ON organizations\\nWHEN NEW.id IS NOT OLD.id\\n  OR (OLD.provider_id != '' AND NEW.provider_id IS NOT OLD.provider_id)\\n  OR NEW.generation \\u003c OLD.generation\\n  OR NEW.creator_subject IS NOT OLD.creator_subject\\n  OR (OLD.state = 'deleted' AND NEW.state IS NOT 'deleted')\\nBEGIN\\n  SELECT RAISE(ABORT, 'organization identity is immutable');\\nEND\"]",
  "definition/trigger/organizations_generate_slug": "[\"trigger\",\"organizations_generate_slug\",\"organizations\",\"CREATE TRIGGER organizations_generate_slug AFTER INSERT ON organizations WHEN NEW.slug = '' BEGIN\\n INSERT INTO organization_slugs (slug, organization_id)\\n WITH RECURSIVE chars(pos, value) AS (\\n SELECT 1, '' UNION ALL\\n SELECT pos+1, value || CASE WHEN substr(lower(NEW.name), pos, 1) GLOB '[a-z0-9]' THEN substr(lower(NEW.name), pos, 1) WHEN value = '' OR substr(value, -1) = '-' THEN '' ELSE '-' END FROM chars WHERE pos \\u003c= length(NEW.name)\\n ), base(value) AS (\\n SELECT CASE WHEN trim(substr(value,1,60), '-') = '' THEN 'organization-organization' WHEN trim(substr(value,1,60), '-') IN ('work','settings','login','projects','organizations','organization','api','app','auth','chat','reports','activity','diagnostics','fleet','support','invite','logout','health','metrics','static','webhooks','design-system','setup','usage','billing','account','platform') THEN trim(substr(value,1,60), '-') || '-organization' ELSE trim(substr(value,1,60), '-') END FROM chars ORDER BY pos DESC LIMIT 1\\n ), candidates(n, value) AS (\\n SELECT 1, value FROM base UNION ALL SELECT n+1, (SELECT value FROM base) || '-' || (n+1) FROM candidates WHERE EXISTS(SELECT 1 FROM organization_slugs WHERE slug = candidates.value)\\n ) SELECT value, NEW.id FROM candidates ORDER BY n DESC LIMIT 1;\\n UPDATE organizations SET slug = (SELECT slug FROM organization_slugs WHERE organization_id = NEW.id) WHERE id = NEW.id;\\nEND\"]",
  "definition/trigger/platform_member_change_immutable": "[\"trigger\",\"platform_member_change_immutable\",\"platform_member_changes\",\"CREATE TRIGGER platform_member_change_immutable BEFORE UPDATE ON platform_member_changes\\nBEGIN\\n  SELECT RAISE(ABORT, 'platform member changes are immutable');\\nEND\"]",
