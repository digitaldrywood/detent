name: Prepare conversation assets
description: Build client and dashboard embed inputs from the checked-out source and lockfiles
runs:
  using: composite
  steps:
    - uses: actions/setup-node@v6
      with:
        node-version: '24'
        cache: npm
        cache-dependency-path: |
          web/conversation/package-lock.json
          package-lock.json
    - shell: bash
      run: make assets
