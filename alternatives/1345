package publication_test

import (
	"testing"

	"github.com/digitaldrywood/detent/internal/hubclient/internal/scenariotest"
	"github.com/digitaldrywood/detent/internal/hubclient/nativechange"
	"github.com/digitaldrywood/detent/internal/runner"
)

func TestPublicationSettlement(t *testing.T) {
	base := scenariotest.FixtureHead("a")
	head := scenariotest.FixtureHead("c")
	scenariotest.RunSettlement(t, []scenariotest.SettlementScenario{
		{Name: "required PR recovers historical confirmed push after stale forge read", RequiredPR: true, PublicationRecovery: true, PublicationReference: "previous", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed"},
		{Name: "required PR recovers historical push recorded by a later resume attempt", RequiredPR: true, PublicationRecovery: true, ResumedPush: true, PublicationReference: "previous", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed"},
		{Name: "required PR refuses historical push without checkpoint", RequiredPR: true, PublicationRecovery: true, RecoveredPushFault: "missing", PublicationReference: "previous", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed"},
		{Name: "required PR refuses historical push with tampered digest", RequiredPR: true, PublicationRecovery: true, RecoveredPushFault: "digest", PublicationReference: "previous", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed"},
		{Name: "required PR refuses historical push for different source", RequiredPR: true, PublicationRecovery: true, RecoveredPushFault: "source", PublicationReference: "previous", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed"},
		{Name: "required PR refuses historical push for different policy", RequiredPR: true, PublicationRecovery: true, RecoveredPushFault: "policy", PublicationReference: "previous", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed"},
		{Name: "required PR refuses historical push for different branch", RequiredPR: true, PublicationRecovery: true, RecoveredPushFault: "branch", PublicationReference: "previous", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed"},
		{Name: "required PR refuses historical push for different base", RequiredPR: true, PublicationRecovery: true, RecoveredPushFault: "base", PublicationReference: "previous", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed"},
		{Name: "required PR refuses historical proof for unknown remote head", RequiredPR: true, PublicationRecovery: true, RecoveredPushFault: "remote", PublicationReference: "previous", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed"},
		{Name: "required PR retains its publication receipt on historical versions", RequiredPR: true, PublicationHistory: true, Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md"), WantChanges: 1, WantVersions: 1},
		{Name: "required PR adopts a retained branch under human hold", RequiredPR: true, PublicationReference: "current", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", WantChanges: 1, WantVersions: 1},
		{Name: "required PR reuses the previous version PR after recommit", RequiredPR: true, PublicationReference: "previous", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", WantChanges: 1, WantVersions: 2},
		{Name: "required PR refuses an unknown retained branch head", RequiredPR: true, PublicationReference: "unknown", PublicationFailure: "identity", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", WantChanges: 1, WantVersions: 2},
		{Name: "required PR refuses unrelated ambiguous external effect", RequiredPR: true, PublicationUncertain: true, Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md"), WantChange: &runner.NativeChange{Changed: true, BaseSHA: base, HeadSHA: head, Files: 1}, WantChanges: 1, WantVersions: 1},
		{Name: "required PR no edit Rework preserves human hold", RequiredPR: true, CheckPRBeforeFinish: true, Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md"), WantChange: &runner.NativeChange{Changed: true, BaseSHA: base, HeadSHA: head, Files: 1}, WantChanges: 1, WantVersions: 1},
		{Name: "required PR reconciles a lost push already on the forge without another push or attempt", RequiredPR: true, LostPush: "present", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md"), WantChange: &runner.NativeChange{Changed: true, BaseSHA: base, HeadSHA: head, Files: 1}, WantChanges: 1, WantVersions: 1},
		{Name: "required PR retries a lost push absent from the forge", RequiredPR: true, LostPush: "absent", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md"), WantChange: &runner.NativeChange{Changed: true, BaseSHA: base, HeadSHA: head, Files: 1}, WantChanges: 1, WantVersions: 1},
		{Name: "required PR retries a lost push over its recorded head", RequiredPR: true, LostPush: "absent", PublicationReference: "previous", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", WantChanges: 1, WantVersions: 2},
		{Name: "required PR finishes a lost push over a diverged branch as head moved", RequiredPR: true, LostPush: "diverged", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md")},
		{Name: "required PR lost response adopts one PR under human hold", RequiredPR: true, LostPRResponse: true, Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md"), WantChange: &runner.NativeChange{Changed: true, BaseSHA: base, HeadSHA: head, Files: 1}, WantChanges: 1, WantVersions: 1},
		{Name: "required PR fences push", RequiredPR: true, PublicationFenceLoss: 2, Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md")},
		{Name: "required PR fences create", RequiredPR: true, PublicationFenceLoss: 3, Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md")},
		{Name: "required PR fences returning the verified receipt", RequiredPR: true, PublicationFenceLoss: 4, Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md")},
		{Name: "required PR records actionable authentication blocker", RequiredPR: true, PublicationFailure: "auth", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md")},
		{Name: "required PR records actionable push blocker", RequiredPR: true, PublicationFailure: "push", Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md")},
		{Name: "required PR finalizes existing staged repair under human hold", RequiredPR: true, PublicationStaged: true, Reviewer: true, Existing: true, Published: head, Role: runner.RoleRework, Outcome: "succeeded", Worktree: "unpushed", Source: scenariotest.FixtureDiff(head, "README.md"), WantChange: &runner.NativeChange{Changed: true}, WantChanges: 1, WantVersions: 1},
	}, scenariotest.Constructors{New: nativechange.NewExecution, Recovered: nativechange.NewRecoveredExecution}, scenariotest.SettlementChecks{})
}
