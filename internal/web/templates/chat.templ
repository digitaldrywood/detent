package templates

import (
 "fmt"
	chatpkg "github.com/digitaldrywood/detent/internal/chat"
	"github.com/digitaldrywood/detent/internal/operatortool"
	"github.com/digitaldrywood/detent/internal/web/ui/components/icon"
)

templ ChatPanelHost() {
	<div class="invisible fixed inset-0 z-50 bg-text/25 opacity-0 transition-[opacity,visibility] duration-200 data-[chat-open=true]:visible data-[chat-open=true]:opacity-100" data-chat-scrim data-chat-open="false"></div>
	<aside
		id="chat-panel"
		class="invisible fixed inset-y-0 right-0 z-50 flex w-full translate-x-full flex-col border-l border-line bg-page shadow-xl transition-[transform,visibility] duration-200 data-[chat-open=true]:visible data-[chat-open=true]:translate-x-0 sm:w-[28rem]"
		data-chat-panel
		data-chat-open="false"
		role="dialog"
		aria-modal="true"
		aria-label="Detent chat"
		aria-hidden="true"
	>
		<header class="flex h-12 flex-none items-center gap-3 border-b border-line px-4">
			<span class="grid size-7 place-items-center rounded-card bg-accent/15 text-accent">@icon.BotMessageSquare(icon.Props{Class: "size-4"})
</span>
			<div class="min-w-0 flex-1">
				<h2 class="text-sm font-semibold text-text">Detent chat</h2>
				<p class="text-2xs text-dim">Live board tools · actions require confirmation</p>
			</div>
			<button type="button" class="grid size-9 place-items-center rounded-card text-sec hover:bg-elev hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" data-chat-close aria-label="Close chat">@icon.X(icon.Props{Class: "size-4"})
</button>
		</header>
		<div id="chat-panel-body" class="min-h-0 flex-1 overflow-y-auto p-4" aria-live="polite">
			<div class="flex h-full items-center justify-center text-center text-xs text-sec">Loading conversation…</div>
		</div>
		<form
			class="flex flex-none items-end gap-2 border-t border-line p-3"
			hx-post="/api/v1/chat/messages"
			hx-target="#chat-panel-body"
			hx-swap="innerHTML"
			hx-disabled-elt="find button, find textarea"
			hx-on::after-request="if(event.detail.successful) this.reset()"
		>
			<label class="sr-only" for="chat-message">Message Detent</label>
			<textarea id="chat-message" name="message" rows="2" maxlength="8192" class="max-h-36 min-h-11 min-w-0 flex-1 resize-y rounded-card border border-line bg-surface px-3 py-2 text-sm text-text placeholder:text-dim focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" placeholder="Ask about the board or propose an action…" required></textarea>
			<button type="submit" class="grid size-11 flex-none place-items-center rounded-card bg-accent text-page hover:bg-accent/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:opacity-50" aria-label="Send message">@icon.Send(icon.Props{Class: "size-4"})
</button>
		</form>
	</aside>
}

templ ChatConversation(data ChatData) {
	<div class="flex min-h-full flex-col gap-3" data-chat-conversation>
		if data.Conversation.Unavailable {
			<div class="rounded-card border border-warn/50 bg-warn/10 p-3 text-xs text-warn" role="status">Chat is unavailable because no compatible Codex backend is configured. The board remains fully operational.</div>
		}
		if data.Error != "" {
			<div class="rounded-card border border-err/40 bg-err/10 p-3 text-xs text-err" role="alert">{ data.Error }</div>
		}
		if len(data.Conversation.Messages) == 0 {
			<div class="flex flex-1 flex-col items-center justify-center gap-3 px-6 py-12 text-center">
				<span class="grid size-10 place-items-center rounded-card bg-accent/15 text-accent">@icon.Sparkles(icon.Props{Class: "size-5"})
</span>
				<div>
					<p class="text-sm font-medium text-text">Operate the board in plain language</p>
					<p class="mt-1 text-xs leading-relaxed text-sec">Ask what is blocked, what merged, or where tokens are going. Detent always asks before changing anything.</p>
				</div>
			</div>
		} else {
			for _, message := range data.Conversation.Messages {
				<div class={ chatMessageClass(message) } data-chat-message={ message.Role }>
					<p class="whitespace-pre-wrap break-words">{ message.Content }</p>
				</div>
			}
		}
		for _, action := range data.Conversation.Actions {
			@ChatAction(action)
		}
	</div>
}

templ ChatAction(action chatpkg.Action) {
	<section class={ chatActionClass(action) } data-chat-action={ action.ID } data-chat-action-status={ string(action.Status) }>
		@ChatActionPreview(action)
		if action.Status == chatpkg.ActionPending {
			<div class="mt-3 flex justify-end gap-2">
				<button type="button" class="rounded-card border border-line px-3 py-1.5 text-xs font-medium text-sec hover:border-text hover:text-text" hx-post={ chatActionPath(action, "reject") } hx-target="#chat-panel-body" hx-swap="innerHTML" hx-disabled-elt="this">Cancel</button>
				<button type="button" class="rounded-card bg-accent px-3 py-1.5 text-xs font-medium text-page hover:bg-accent/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" hx-post={ chatActionPath(action, "confirm") } hx-target="#chat-panel-body" hx-swap="innerHTML" hx-disabled-elt="this">Confirm action</button>
			</div>
		}
	</section>
}

// ChatApproval is the portable form of the existing chat action affordance.
// It has no navigation entry or separate primary dashboard surface.
templ ChatApproval(data ChatData) {
 <!DOCTYPE html>
 <html lang="en">
  <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Detent operator approval</title><link rel="stylesheet" href={ data.approvalStylesheet() }/></head>
  <body class="bg-page text-text">
   <main class="mx-auto max-w-2xl p-6">
    if data.Conversation.RequireConfirmation {
     <h1 class="text-lg font-semibold">Review project change</h1>
    } else {
    <h1 class="text-lg font-semibold">Detent chat · operator approval</h1>
    <p class="mt-3 text-sm">Organization: { data.Conversation.OrganizationID } · Client: { data.Conversation.Client }</p>
    <p class="mt-1 text-sm">Connection: { data.Conversation.ConnectionID } · Mode: { string(data.Conversation.Mode) }</p>
    }
    if data.Error != "" {
 <p role="alert">{ data.Error }</p>
 }
    if !data.Conversation.RequireConfirmation {
    <form method="post" action={ chatApprovalPath(data) } class="my-4 flex gap-2">
     <input type="hidden" name="csrf" value={ data.CSRF }/>
     <input type="hidden" name="form_token" value={ data.FormToken }/>
     <input type="hidden" name="connection_id" value={ data.Conversation.ConnectionID }/>
     <input type="hidden" name="decision" value="mode"/>
     <label>Connection mode <select name="mode" class="rounded-card border border-line bg-surface p-2"><option value="confirmation" selected?={ data.Conversation.Mode != chatpkg.YOLOMode }>Confirmation</option><option value="yolo" selected?={ data.Conversation.Mode == chatpkg.YOLOMode }>YOLO · skip confirmations</option></select></label>
     <button type="submit" class="rounded-card bg-accent px-3 py-2 text-page">Set connection mode</button>
    </form>
    <p class="mb-4 text-xs text-sec">YOLO skips confirmation for this connection. Permissions and workflow rules still apply.</p>
    }
    for _, action := range data.Conversation.Actions {
     @ChatActionPreview(action)
     if action.Description != "" {
      <pre class="my-2 overflow-auto whitespace-pre-wrap break-words text-xs">{ action.Description }</pre>
     }
     if action.Status == chatpkg.ActionSucceeded && action.ResourceURL != "" && (action.Kind == chatpkg.ActionKind(operatortool.BillingCheckout) || action.Kind == chatpkg.ActionKind(operatortool.BillingPortal)) {
      <a href={ templ.SafeURL(action.ResourceURL) } class="my-2 inline-block text-accent underline" rel="noreferrer">Continue to billing</a>
     }
     if action.Kind != chatpkg.ActionIssueSplit {
      <pre class="my-2 overflow-auto whitespace-pre-wrap break-words text-xs">{ string(action.Arguments) }</pre>
     }
     if action.Status == chatpkg.ActionPending {
      <form method="post" action={ chatApprovalPath(data) } class="mb-4 flex gap-2">
       <input type="hidden" name="csrf" value={ data.CSRF }/>
     <input type="hidden" name="form_token" value={ data.ActionTokens[action.ID] }/>
       <input type="hidden" name="connection_id" value={ data.Conversation.ConnectionID }/>
       <input type="hidden" name="action_id" value={ action.ID }/>
       <button type="submit" name="decision" value="reject" class="rounded-card border border-line px-3 py-2">Cancel</button>
       <button type="submit" name="decision" value="confirm" class="rounded-card bg-accent px-3 py-2 text-page">Confirm action</button>
      </form>
     }
    }
   </main>
  </body>
 </html>
}

templ ChatActionPreview(action chatpkg.Action) {
		<div class="flex items-start gap-2">
			<span class="mt-0.5 grid size-6 flex-none place-items-center rounded-card bg-page text-warn">@icon.WandSparkles(icon.Props{Class: "size-3.5"})
</span>
			<div class="min-w-0 flex-1">
				<p class="text-2xs font-semibold uppercase tracking-[0.06em] text-dim">{ chatActionStatus(action) }</p>
				<p class="mt-1 break-words text-sm font-medium text-text">{ chatpkg.ActionSummary(action) }</p>
				if split := action.IssueSplit(); split != nil {
					@IssueSplitPreview(split)
				}
				if action.Reason != "" {
					<p class="mt-1 break-words text-xs text-sec">Reason: { action.Reason }</p>
				}
				if action.Result != "" {
					<p class="mt-1 break-words text-xs text-sec">{ action.Result }</p>
				}
			</div>
		</div>
}


templ IssueSplitPreview(split *chatpkg.IssueSplit) {
 <div class="mt-3 space-y-3" data-testid="issue-split-proposal">
  for position, child := range split.Children {
   <section class="rounded-card border border-line p-3">
    <h2 class="break-words text-sm font-medium">{ fmt.Sprintf("%d. %s", position+1, child.Title) }</h2>
    <p class="mt-1 text-xs text-sec">{ child.State } · { splitPriority(child.Priority) }</p>
    <p class="mt-2 whitespace-pre-wrap break-words text-xs text-sec">{ child.Description }</p>
   </section>
  }
  <div class="text-xs text-sec" role="group" aria-label="Dependency graph">
   <p class="font-medium">Dependency graph</p>
   <p>{ "Parent: " + split.ParentID }</p>
   for _, edge := range split.Edges {
    <p>{ splitNode(edge.Dependent, split) }{ " → blocked by → " }{ splitNode(edge.Blocker, split) }</p>
   }
   if len(split.Edges) == 0 {
    <p>No dependencies</p>
   }
  </div>
 </div>
}
