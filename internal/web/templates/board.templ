package templates

import (
	"net/url"
	"strconv"

	"github.com/digitaldrywood/detent/internal/web/ui/components/icon"
	"github.com/digitaldrywood/detent/internal/web/ui/primitives"
)

// BoardPage is the app's home: exception strip → figure row → fixed-height,
// independently-scrollable lanes. The page itself never scrolls.
templ BoardPage(data DashboardData) {
	@AppShell(BoardShellDataFromDashboard(data), boardScopeSelect(data)) {
		<main class="flex min-h-0 min-w-0 flex-1 flex-col">
			<div
				id="snapshot"
				class="flex min-h-0 min-w-0 flex-1 flex-col"
				sse-swap="snapshot"
				hx-swap="morph:innerHTML"
			>
				@BoardSnapshot(data)
			</div>
		</main>
		@boardAlertScript()
		@boardLaneScript()
		@boardKanbanDragScript()
	}
}

// BoardSnapshot is the morph target for SSE ticks. Every element carries a
// stable id so idiomorph preserves DOM (and lane scroll positions).
// First paint: an unconfigured instance gets the first-run state, a
// configured one waiting on its first snapshot gets lane skeletons —
// never again once data exists. A degraded refresh that still carries
// prior tracker data keeps the last-known lanes visible (via
// projectKanbanBoardLoaded) rather than flashing skeletons.
templ BoardSnapshot(data DashboardData) {
	{{ alerts := boardAlerts(data.Snapshot) }}
	if boardFirstRun(data) {
		if len(alerts) > 0 {
			<div class="flex-none px-5 pt-3.5">
				@boardAlertsBar(alerts)
			</div>
		}
		@primitives.FirstRun("Connect a repository to start orchestrating.", "Add project", "/settings", "projects are defined in the global config")
	} else if !projectKanbanBoardLoaded(data) {
		if len(alerts) > 0 {
			<div class="flex-none px-5 pt-3.5">
				@boardAlertsBar(alerts)
			</div>
		}
		if snapshotDegraded(data.Snapshot) {
			<div class="flex-none px-5 pt-4">
				@snapshotReadiness(data.Snapshot)
			</div>
		} else {
			@primitives.SkeletonLanes(4)
		}
	} else {
		@boardSnapshotBody(data, alerts)
	}
}

templ boardSnapshotBody(data DashboardData, alerts []boardAlert) {
	{{ view := boardViewFromDashboard(data) }}
	if len(view.Exceptions) > 0 {
		<div id="board-exceptions" class="flex-none px-5 pt-3.5">
			@primitives.ExceptionStrip(view.Exceptions)
		</div>
	}
	<p id="board-feedback" class={ "flex flex-none items-center gap-2 px-5 pt-3.5 text-xs " + boardFeedbackClass(data.Kanban.FeedbackKind) } role="status" aria-live="polite" hidden?={ data.Kanban.Feedback == "" }>
		if data.Kanban.Feedback != "" {
			<span aria-hidden="true">{ boardFeedbackGlyph(data.Kanban.FeedbackKind) }</span>
			{ data.Kanban.Feedback }
		}
	</p>
	<div id="board-figures" class="flex-none px-5 pb-3 pt-4">
		@primitives.FigureRow(view.Figures) {
			if len(alerts) > 0 {
				@boardAlertsBar(alerts)
			} else {
				<span id="board-freshness" class={ "min-w-0 truncate font-mono text-xs tabular-nums " + boardExtraTextClass(refreshFreshnessKind(data.Snapshot)) }>{ refreshFreshnessSummary(data.Snapshot) }</span>
			}
			@primitives.MonoFigure("fig-tps", view.TPS)
			@primitives.MonoFigure("fig-spend", view.Spend)
			@boardLanePicker(view)
		}
	</div>
	<div
		id="board-lane-position"
		class="flex flex-none items-center justify-center px-5 pb-2 font-mono text-2xs text-sec tabular-nums md:hidden"
		data-board-lane-position
		role="status"
		aria-live="polite"
		aria-label={ "Lane 1 of " + formatCount(view.Visible) }
	>
		<span aria-hidden="true"><span data-board-lane-position-current>1</span>/<span data-board-lane-position-total>{ formatCount(view.Visible) }</span></span>
	</div>
	<div
		id="board-lanes"
		class={ boardLanesClass(data) }
		data-board-lanes
		data-board-key={ view.Key }
		data-preserve-scroll="board-lanes"
	>
		for _, lane := range view.Lanes {
			@boardLaneView2(lane)
		}
	</div>
}

templ boardAlertsBar(alerts []boardAlert) {
	if len(alerts) > 0 {
		<section
			id="board-alerts"
			class={ boardAlertsClass(alerts) }
			role="alert"
			aria-live="polite"
			data-board-alert-count={ strconv.Itoa(len(alerts)) }
			data-board-alert-tone={ string(alerts[0].Tone) }
			if boardAlertKindActive(alerts, boardAlertKindLastKnown) {
				data-board-snapshot-stale="true"
			}
		>
			<button
				id="board-alerts-toggle"
				type="button"
				class="flex h-5 min-w-0 max-w-full items-center gap-1.5 px-2 text-left text-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-current"
				data-board-alerts-toggle
				aria-expanded="false"
				aria-controls="board-alerts-overlay"
				aria-label={ boardAlertButtonLabel(alerts) }
			>
				<span class="contents" data-board-alert-lead-glyph>
					@boardAlertGlyph(alerts[0], "size-3.5 shrink-0")
				</span>
				<span class="shrink-0 font-medium" data-board-alert-count-label>{ boardCountLabel(len(alerts), "fault", "faults") }</span>
				<span class="hidden shrink-0 text-current/60 md:inline" aria-hidden="true">·</span>
				<span class="hidden min-w-0 flex-1 truncate text-text md:inline" data-board-alert-lead-summary>{ alerts[0].TerseSummary }</span>
				if len(alerts) > 1 {
					<span class="shrink-0 font-medium" data-board-alert-overflow>{ "+" + strconv.Itoa(len(alerts)-1) }</span>
				}
				<span class="shrink-0 transition-transform duration-150 data-[open=true]:rotate-180" data-board-alerts-chevron data-open="false" aria-hidden="true">
					@icon.ChevronDown(icon.Props{Class: "size-3.5"})
				</span>
			</button>
			<template data-board-alerts-overlay-template>
				@boardAlertsOverlayContents(alerts)
			</template>
		</section>
	}
}

templ boardAlertsOverlayContents(alerts []boardAlert) {
	{{ dismissals := boardStalenessDismissals(alerts) }}
	<div class="divide-y divide-line" data-board-alerts-overlay-content>
		<header class="sticky top-0 z-10 flex h-10 items-center gap-2 border-b border-line bg-page px-3 text-sm">
			<span class="contents" data-board-alert-lead-glyph>
				@boardAlertGlyph(alerts[0], "size-4 shrink-0")
			</span>
			<p class="min-w-0 flex-1 truncate font-medium text-text" data-board-alert-count-label>{ boardCountLabel(len(alerts), "fault", "faults") }</p>
			for _, dismissal := range dismissals {
				<form
					class="shrink-0"
					hx-post={ "/api/v1/projects/" + url.PathEscape(dismissal.ProjectID) + "/staleness-warnings/acknowledge" }
					hx-swap="none"
					hx-confirm={ "Dismiss " + strconv.Itoa(len(dismissal.WarningIDs)) + " staleness warnings?" }
					data-staleness-dismiss-form
					data-staleness-dismiss-bulk
					data-staleness-project-id={ dismissal.ProjectID }
				>
					for _, warningID := range dismissal.WarningIDs {
						<input type="hidden" name="warning_id" value={ warningID }/>
					}
					<button type="submit" class="inline-flex shrink-0 items-center rounded-chip px-2 py-1 text-xs font-medium text-sec hover:bg-elev hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" data-staleness-dismiss-label>{ boardStalenessDismissalLabel(dismissal, len(dismissals)) }</button>
				</form>
			}
			<button
				type="button"
				class="inline-flex shrink-0 items-center gap-1 rounded-chip px-2 py-1 text-xs font-medium text-sec hover:bg-elev hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
				data-board-alerts-close
				aria-label="Collapse board alerts"
			>
				@icon.ChevronUp(icon.Props{Class: "size-3.5"})
				Close
			</button>
		</header>
		<div class="grid divide-y divide-line">
			for _, alert := range alerts {
				<section
					id={ alert.ID }
					class="grid min-w-0 gap-2 px-4 py-3"
					data-board-alert={ string(alert.Kind) }
					data-board-alert-summary={ alert.TerseSummary }
					data-board-alert-tone={ string(alert.Tone) }
					if alert.StalenessWarningID != "" {
						data-staleness-warning-id={ alert.StalenessWarningID }
						data-staleness-project-id={ alert.StalenessProjectID }
					}
				>
					<template data-board-alert-glyph-template>
						@boardAlertGlyph(alert, "size-3.5 shrink-0")
					</template>
					<div class="flex min-w-0 items-start gap-3">
						<div class="min-w-0 flex-1">
							<p class="font-medium text-text">{ alert.TerseSummary }</p>
							if alert.DetailSummary != "" {
								<p class="mt-0.5 text-xs text-sec">{ alert.DetailSummary }</p>
							}
						</div>
						if alert.DeepLink != "" {
							<a class="shrink-0 text-xs font-medium text-accent hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" href={ templ.SafeURL(alert.DeepLink) }>
								if alert.DeepLinkLabel != "" {
									{ alert.DeepLinkLabel }
								} else if alert.Overflow > 0 {
									{ "+" + strconv.Itoa(alert.Overflow) + " more · Health" }
								} else {
									Health
								}
							</a>
						}
					</div>
					if len(alert.DetailRows) > 0 {
						<div class="grid gap-2 pl-3">
							for _, row := range alert.DetailRows {
								<div id={ row.ID } class="min-w-0 border-l border-line pl-3 text-xs">
									<p class="flex min-w-0 flex-wrap items-baseline gap-x-2 text-text">
										if row.Link != "" {
											<a class="font-mono font-medium text-accent hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" href={ templ.SafeURL(row.Link) }>{ row.Label }</a>
										} else {
											<span class="font-mono font-medium">{ row.Label }</span>
										}
										if row.Summary != "" {
											<span class="text-sec">{ row.Summary }</span>
										}
									</p>
									if row.Detail != "" {
										<p class="mt-0.5 break-words text-sec">{ row.Detail }</p>
									}
								</div>
							}
						</div>
					}
					if alert.Action != nil {
						<form
							class="pl-3"
							hx-post={ alert.Action.Path }
							hx-target={ alert.Action.Target }
							hx-swap={ boardAlertActionSwap(alert.Action) }
							hx-confirm={ alert.Action.Confirm }
							if alert.StalenessWarningID != "" {
								data-staleness-dismiss-form
								data-staleness-warning-id={ alert.StalenessWarningID }
								data-staleness-project-id={ alert.StalenessProjectID }
							}
						>
							<input type="hidden" name="confirm" value="true"/>
							<button type="submit" class="inline-flex min-h-8 items-center justify-center rounded-card border border-current/40 bg-surface px-3 py-1.5 text-xs font-medium text-text hover:bg-current/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current/50">{ alert.Action.Label }</button>
						</form>
					}
				</section>
			}
		</div>
	</div>
}

func boardAlertActionSwap(action *boardAlertAction) string {
	if action != nil && action.Swap != "" {
		return action.Swap
	}
	return "innerHTML"
}

templ boardAlertGlyph(alert boardAlert, class string) {
	if alert.Tone == primitives.KindErr {
		@icon.TriangleAlert(icon.Props{Class: class})
	} else if alert.Tone == primitives.KindInfo {
		@icon.Info(icon.Props{Class: class})
	} else {
		@icon.CircleAlert(icon.Props{Class: class})
	}
}

templ boardAlertsOverlayHost() {
	<div
		id="board-alerts-overlay"
		class="fixed z-40 hidden max-h-[40vh] overflow-y-auto rounded-card border border-line bg-page shadow-lg"
		data-board-alerts-overlay-host
		aria-hidden="true"
		hidden
	></div>
}

templ boardAlertScript() {
	<script>
		(function () {
			var open = false;
			var positionFrame = 0;

			function alertsBar() {
				return document.getElementById("board-alerts");
			}

			function alertsToggle() {
				return document.querySelector("[data-board-alerts-toggle]");
			}

			function overlayHost() {
				return document.querySelector("[data-board-alerts-overlay-host]");
			}

			function overlayTemplate() {
				var bar = alertsBar();
				return bar ? bar.querySelector("template[data-board-alerts-overlay-template]") : null;
			}

			function setToggleState(expanded) {
				var toggle = alertsToggle();
				if (!toggle) return;
				toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
				var chevron = toggle.querySelector("[data-board-alerts-chevron]");
				if (chevron) chevron.setAttribute("data-open", expanded ? "true" : "false");
			}

			function renderOverlay() {
				var host = overlayHost();
				var template = overlayTemplate();
				if (!host || !(template instanceof HTMLTemplateElement)) return false;
				host.replaceChildren(template.content.cloneNode(true));
				if (window.htmx) window.htmx.process(host);
				return true;
			}

			function positionOverlay() {
				positionFrame = 0;
				if (!open) return;
				var bar = alertsBar();
				var host = overlayHost();
				if (!bar || !host) return;
				var rect = bar.getBoundingClientRect();
				var margin = 8;
				var width = Math.min(640, Math.max(0, window.innerWidth - margin * 2));
				var left = Math.min(Math.max(margin, rect.left), Math.max(margin, window.innerWidth - width - margin));
				host.style.left = Math.round(left) + "px";
				host.style.top = Math.round(rect.bottom + 4) + "px";
				host.style.width = Math.round(width) + "px";
			}

			function requestOverlayPosition() {
				if (positionFrame) return;
				positionFrame = requestAnimationFrame(positionOverlay);
			}

			function closeOverlay(restoreFocus) {
				open = false;
				var host = overlayHost();
				if (host) {
					host.hidden = true;
					host.classList.add("hidden");
					host.setAttribute("aria-hidden", "true");
				}
				setToggleState(false);
				if (restoreFocus) {
					var toggle = alertsToggle();
					if (toggle) toggle.focus();
				}
			}

			function openOverlay() {
				if (!renderOverlay()) return;
				open = true;
				var host = overlayHost();
				if (!host) return;
				host.hidden = false;
				host.classList.remove("hidden");
				host.setAttribute("aria-hidden", "false");
				setToggleState(true);
				positionOverlay();
			}

			function syncOverlayAfterMorph() {
				if (!open) {
					setToggleState(false);
					return;
				}
				if (!alertsBar()) {
					closeOverlay(false);
					return;
				}
				var host = overlayHost();
				var scrollTop = host ? host.scrollTop : 0;
				if (!renderOverlay()) {
					closeOverlay(false);
					return;
				}
				host = overlayHost();
				if (!host) return;
				host.hidden = false;
				host.classList.remove("hidden");
				host.setAttribute("aria-hidden", "false");
				host.scrollTop = scrollTop;
				setToggleState(true);
				positionOverlay();
			}

			function settledSnapshot(event) {
				var detailTarget = event.detail && event.detail.target;
				var target = detailTarget instanceof Element ? detailTarget : event.target;
				if (!(target instanceof Element)) return false;
				return target.id === "snapshot" || Boolean(target.closest("#snapshot"));
			}

			function dismissedWarningIDs(form) {
				var ids = [];
				var directID = form.dataset.stalenessWarningId || "";
				if (directID) ids.push(directID);
				form.querySelectorAll("input[name='warning_id']").forEach(function (input) {
					if (input.value && !ids.includes(input.value)) ids.push(input.value);
				});
				return ids;
			}

			function removeDismissedWarnings(root, projectID, warningIDs) {
				if (!root || typeof root.querySelectorAll !== "function") return;
				root.querySelectorAll("[data-board-alert='staleness-warning'][data-staleness-warning-id]").forEach(function (warning) {
					if (warning.dataset.stalenessProjectId !== projectID) return;
					if (warningIDs.includes(warning.dataset.stalenessWarningId || "")) warning.remove();
				});
			}

			function syncBulkDismissals(root) {
				if (!root || typeof root.querySelectorAll !== "function") return;
				root.querySelectorAll("[data-staleness-dismiss-bulk]").forEach(function (form) {
					var projectID = form.dataset.stalenessProjectId || "";
					var active = [];
					root.querySelectorAll("[data-board-alert='staleness-warning'][data-staleness-warning-id]").forEach(function (warning) {
						if (warning.dataset.stalenessProjectId === projectID) active.push(warning.dataset.stalenessWarningId || "");
					});
					form.querySelectorAll("input[name='warning_id']").forEach(function (input) {
						if (!active.includes(input.value)) input.remove();
					});
					if (active.length === 0) {
						form.remove();
						return;
					}
					var label = form.querySelector("[data-staleness-dismiss-label]");
					if (label) label.textContent = label.textContent.replace(/\(\d+\)$/, "(" + active.length + ")");
				});
			}

			function faultCountLabel(count) {
				return count + (count === 1 ? " fault" : " faults");
			}

			function syncAlertCountRoot(root, count) {
				if (!root || typeof root.querySelectorAll !== "function") return;
				root.querySelectorAll("[data-board-alert-count-label]").forEach(function (label) {
					label.textContent = faultCountLabel(count);
				});
			}

			function syncLeadAlertRoot(root, lead, glyphTemplate) {
				if (!root || typeof root.querySelectorAll !== "function") return;
				root.querySelectorAll("[data-board-alert-lead-glyph]").forEach(function (glyph) {
					glyph.replaceChildren(glyphTemplate.content.cloneNode(true));
				});
				root.querySelectorAll("[data-board-alert-lead-summary]").forEach(function (summary) {
					summary.textContent = lead.dataset.boardAlertSummary || "";
				});
			}

			function syncLeadAlert(bar, roots, lead, count) {
				var glyphTemplate = lead.querySelector("template[data-board-alert-glyph-template]");
				if (!(glyphTemplate instanceof HTMLTemplateElement)) return;
				roots.forEach(function (root) {
					syncLeadAlertRoot(root, lead, glyphTemplate);
				});
				var tones = {
					err: ["border-err/40", "bg-err/10", "text-err"],
					info: ["border-info/40", "bg-info/10", "text-info"],
					warn: ["border-warn/40", "bg-warn/10", "text-warn"],
				};
				Object.values(tones).flat().forEach(function (className) {
					bar.classList.remove(className);
				});
				var tone = lead.dataset.boardAlertTone || "warn";
				(tones[tone] || tones.warn).forEach(function (className) {
					bar.classList.add(className);
				});
				bar.dataset.boardAlertTone = tone;
				var toggle = alertsToggle();
				if (toggle) {
					var countLabel = count + (count === 1 ? " board fault" : " board faults");
					toggle.setAttribute("aria-label", countLabel + ". Highest severity: " + (lead.dataset.boardAlertSummary || "") + ". Expand details.");
				}
			}

			function settleStalenessDismissal(form) {
				var projectID = form.dataset.stalenessProjectId || "";
				var warningIDs = dismissedWarningIDs(form);
				if (!projectID || warningIDs.length === 0) return;
				var host = overlayHost();
				var template = overlayTemplate();
				removeDismissedWarnings(host, projectID, warningIDs);
				if (template instanceof HTMLTemplateElement) removeDismissedWarnings(template.content, projectID, warningIDs);
				syncBulkDismissals(host);
				if (template instanceof HTMLTemplateElement) syncBulkDismissals(template.content);
				var countRoot = template instanceof HTMLTemplateElement ? template.content : host;
				var count = countRoot && typeof countRoot.querySelectorAll === "function" ? countRoot.querySelectorAll("[data-board-alert]").length : 0;
				var bar = alertsBar();
				if (!bar || count === 0) {
					if (bar) bar.remove();
					closeOverlay(false);
					return;
				}
				bar.dataset.boardAlertCount = String(count);
				syncAlertCountRoot(bar, count);
				syncAlertCountRoot(host, count);
				if (template instanceof HTMLTemplateElement) syncAlertCountRoot(template.content, count);
				var lead = countRoot.querySelector("[data-board-alert]");
				if (lead) {
					var leadRoots = [bar, host];
					if (template instanceof HTMLTemplateElement) leadRoots.push(template.content);
					syncLeadAlert(bar, leadRoots, lead, count);
				}
				var overflow = bar.querySelector("[data-board-alert-overflow]");
				if (overflow) {
					overflow.textContent = "+" + Math.max(0, count - 1);
					overflow.hidden = count <= 1;
				}
			}

			document.addEventListener("click", function (event) {
				var target = event.target instanceof Element ? event.target : null;
				if (!target) return;
				if (target.closest("[data-board-alerts-close]")) {
					closeOverlay(true);
					return;
				}
				if (!target.closest("[data-board-alerts-toggle]")) return;
				if (open) {
					closeOverlay(false);
				} else {
					openOverlay();
				}
			});

			document.addEventListener("keydown", function (event) {
				if (event.key === "Escape" && open) closeOverlay(true);
			});

			document.addEventListener("htmx:afterSettle", function (event) {
				if (settledSnapshot(event)) syncOverlayAfterMorph();
			});

			document.addEventListener("htmx:beforeSwap", function (event) {
				var requestElement = event.detail && event.detail.requestConfig && event.detail.requestConfig.elt;
				var form = requestElement instanceof Element ? requestElement.closest("[data-staleness-dismiss-form]") : null;
				if (!(form instanceof HTMLFormElement)) return;
				var status = event.detail.xhr ? event.detail.xhr.status : 0;
				if (status < 200 || status >= 300) return;
				event.detail.shouldSwap = false;
				settleStalenessDismissal(form);
			});

			window.addEventListener("resize", requestOverlayPosition);
		})();
	</script>
}

templ boardLaneView2(lane boardLaneView) {
	<section
		id={ lane.DomID }
		class="flex w-full flex-none snap-start flex-col overflow-hidden rounded-card border border-line bg-surface data-[kanban-drop-allowed=false]:border-err/45 data-[kanban-drop-allowed=false]:opacity-70 data-[kanban-drop-allowed=false]:ring-2 data-[kanban-drop-allowed=false]:ring-inset data-[kanban-drop-allowed=false]:ring-err/20 data-[kanban-drop-allowed=true]:border-accent data-[kanban-drop-allowed=true]:ring-2 data-[kanban-drop-allowed=true]:ring-inset data-[kanban-drop-allowed=true]:ring-accent/30 data-[kanban-drop-source=true]:border-dashed data-[kanban-drop-source=true]:border-accent/50 data-[kanban-drop-source=true]:ring-2 data-[kanban-drop-source=true]:ring-inset data-[kanban-drop-source=true]:ring-accent/20 data-[lane-hidden=true]:hidden md:min-w-44 md:max-w-80 md:flex-1 md:snap-none md:data-[kanban-drop-allowed=false]:ring-0 md:data-[kanban-drop-allowed=true]:ring-0 md:data-[kanban-drop-source=true]:ring-0"
		data-board-lane={ lane.LaneID }
		data-board-lane-title={ lane.Title }
		data-board-lane-default={ boardBoolAttr(lane.DefaultVisible) }
		data-board-lane-card-count={ strconv.Itoa(lane.CardCount) }
		data-board-lane-visibility-state={ string(boardLaneVisibilityAuto) }
		data-board-lane-pinned="false"
		data-lane-hidden={ boardBoolAttr(!lane.DefaultVisible) }
		if lane.DropState != "" {
			data-kanban-drop-state={ lane.DropState }
			data-kanban-drop-key={ lane.DropKey }
		}
	>
		<header class="flex flex-none items-center gap-1.5 border-b border-line px-3 py-2">
			if lane.Live {
				@primitives.StatusDot(primitives.KindOK, true)
			}
			<h2 class="text-xs font-semibold text-text">{ lane.Title }</h2>
			<span class="font-mono text-2xs font-medium text-sec tabular-nums">{ lane.Count }</span>
		</header>
		<div class="dt-lane-scroll flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto overflow-x-hidden p-2" data-preserve-scroll={ lane.DomID + "-scroll" } data-kanban-card-container>
			if len(lane.Cards) == 0 {
				<div class="contents" data-kanban-empty-line>
					@primitives.EmptyLine(lane.EmptyMessage)
				</div>
			}
			for _, card := range lane.Cards {
				@boardCardView2(card)
			}
		</div>
	</section>
}

templ boardCardView2(card boardCardView) {
	<article
		id={ card.DomID }
		class={ boardCardClass(card) + boardCardInteractionClass(card) }
		role="button"
		tabindex="0"
		{ sheetOpenAttrs(card.Project, card.Identity, card.Scope, true)... }
		data-detail-sheet-project={ card.Project }
		data-detail-sheet-reference={ card.Number }
		if card.MoveDisabledText != "" {
			title={ card.MoveDisabledText }
		}
		if card.DragDrop {
			data-kanban-card
			data-kanban-current-state={ card.CurrentState }
			if card.DataSeq > 0 {
				data-kanban-data-seq={ strconv.FormatUint(card.DataSeq, 10) }
			}
			if card.IssueID != "" {
				data-kanban-issue-id={ card.IssueID }
			}
			if card.CanDrag {
				data-kanban-action="move"
				data-kanban-allowed-targets={ card.AllowedTargets }
			}
			else
			if card.MoveDisabledText != "" {
				data-kanban-move-disabled="true"
				data-kanban-move-disabled-reason={ card.MoveDisabledText }
			}
		}
	>
		<div class="flex min-w-0 items-center gap-0.5 font-mono text-2xs font-medium text-sec" data-board-card-content="cozy">
			if card.Running {
				@primitives.StatusDot(primitives.KindOK, true)
			}
			@primitives.TrackerReferenceLink(card.Number, card.URL, boardCardNumberClass(card))
			<span class="min-w-0 truncate">{ card.Project }</span>
			if card.PriorityBadge != "" {
				<span
					id={ card.DomID + "-priority" }
					class={ boardPriorityBadgeClass(card) }
					tabindex="0"
					role="img"
					aria-label={ "Priority: " + card.PriorityBadge }
					data-board-priority
					data-board-priority-top={ boardBoolAttr(card.PriorityTop) }
					data-help-trigger
					data-help-scope="dispatch-priority"
					data-help-term={ card.DomID + "-priority" }
					data-help-title={ card.PriorityTitle }
					data-help-description={ card.PriorityDetail }
					onclick="event.stopPropagation()"
				><span class="min-w-0 truncate">{ card.PriorityBadge }</span></span>
			}
			if card.MetaRight != "" {
				@primitives.TrackerReferenceLinkIsolated(card.MetaRight, card.PRURL, "ml-auto flex-none whitespace-nowrap tabular-nums")
			} else if card.MoveDisabledText != "" {
				<span class="ml-auto flex-none rounded-chip border border-line px-1.5 py-0.5 text-2xs text-dim" title={ card.MoveDisabledText } data-kanban-move-disabled-label>{ card.MoveDisabledLabel }</span>
			} else if card.Done {
				<span class="ml-auto text-ok" role="img" aria-label="done">✓</span>
			}
		</div>
		<div class={ boardCardTitleClass(card) } data-board-card-title>{ card.Title }</div>
		<div class="min-w-0 items-center gap-1.5 font-mono text-2xs text-sec" data-board-card-content="compact">
			<span class="flex-none font-medium text-text" data-board-card-state>{ card.State }</span>
			if card.CompactSignal != "" {
				<span aria-hidden="true">·</span>
				<span class="min-w-0 truncate">{ card.CompactSignal }</span>
			}
			if card.MetaRight != "" {
				@primitives.TrackerReferenceLinkIsolated(card.MetaRight, card.PRURL, "ml-auto flex-none whitespace-nowrap tabular-nums")
			} else if card.MoveDisabledText != "" {
				<span class="ml-auto flex-none rounded-chip border border-line px-1.5 py-0.5 text-2xs text-dim" title={ card.MoveDisabledText } data-kanban-move-disabled-label>{ card.MoveDisabledLabel }</span>
			}
		</div>
		if card.MetaRight != "" && card.MoveDisabledText != "" {
			<div class="flex" data-board-card-expanded>
				<span class="flex-none rounded-chip border border-line px-1.5 py-0.5 text-2xs text-dim" title={ card.MoveDisabledText } data-kanban-move-disabled-label>{ card.MoveDisabledLabel }</span>
			</div>
		}
		if card.RuntimeBadge {
			@boardRuntimeBadge(card)
		}
		if card.MergeLaneStatus != "" {
			<div class={ "flex items-center gap-1.5 text-2xs " + boardExtraTextClass(card.MergeLaneKind) } data-board-card-merge-lane data-board-card-expanded title={ card.MergeLaneDetail }>
				@primitives.StatusDot(card.MergeLaneKind, false)
				<span class="font-medium">{ card.MergeLaneStatus }</span>
				<span class="min-w-0 truncate font-mono">{ card.MergeLaneDetail }</span>
			</div>
		}
		if card.OriginDetail != "" {
			<div class="flex items-center gap-1.5 text-2xs text-info" data-board-card-origin data-board-card-expanded>
				@primitives.StatusDot(primitives.KindInfo, false)
				<span class="min-w-0 truncate font-mono">{ card.OriginDetail }</span>
			</div>
		}
		if card.ExtraText != "" && (!card.RuntimeBadge || card.ExtraText != "agent working") {
			if card.ExtraChip {
				<div class="flex" data-board-card-expanded>
					@primitives.Chip(card.ExtraKind, card.ExtraText)
				</div>
			} else {
				<div class={ "flex items-center gap-1.5 text-2xs " + boardExtraTextClass(card.ExtraKind) } data-board-card-expanded>
					@primitives.StatusDot(card.ExtraKind, false)
					{ card.ExtraText }
				</div>
			}
		}
		if card.BlockerSummary != "" {
			<div class="min-w-0 text-2xs text-sec" data-board-card-blockers data-board-card-expanded>
				<span class="text-dim">Blocker refs</span> { card.BlockerSummary }
			</div>
		}
		if card.ParkSummary != "" {
			<div
				id={ card.DomID + "-park-summary" }
				class="min-w-0 truncate font-mono text-2xs text-sec"
				tabindex="0"
				role="img"
				aria-label={ "Park history: " + card.ParkDetail }
				data-board-card-park-summary
				data-board-card-expanded
				data-help-trigger
				data-help-scope="park-history"
				data-help-term={ card.DomID + "-park-summary" }
				data-help-title="Park history"
				data-help-description={ card.ParkDetail }
			>{ card.ParkSummary }</div>
		}
		if card.ProgressSummary != "" {
			<div class={ "flex items-center gap-1.5 text-2xs " + boardExtraTextClass(card.ProgressKind) } title={ card.ProgressDetail } data-board-card-progress data-board-card-expanded>
				@primitives.StatusDot(card.ProgressKind, false)
				<span class="min-w-0 truncate font-mono">{ card.ProgressSummary }</span>
			</div>
		}
		if card.AgeFooter != "" {
			<div class="mt-0.5 flex items-center justify-between gap-2 border-t border-line/70 pt-1.5 font-mono text-2xs text-sec" title={ card.AgeFooterTitle } data-board-card-age-footer data-board-card-expanded>
				<span class="min-w-0 truncate">In lane</span>
				<span class="flex-none whitespace-nowrap tabular-nums">{ card.AgeFooter }</span>
			</div>
		}
		if card.AuthorDetail != "" || len(card.Labels) > 0 || card.Effort != "" || card.Activity != "" || card.PRStatus != "" {
			<div class="gap-1.5 border-t border-line/70 pt-1.5 text-2xs text-sec" data-board-card-content="comfy">
				if card.AuthorDetail != "" {
					<div class="flex min-w-0 items-center gap-1.5" data-board-card-author>
						<span class="flex-none text-dim">Filed by</span>
						<span class="min-w-0 truncate font-mono text-text">{ card.AuthorDetail }</span>
					</div>
				}
				if len(card.Labels) > 0 {
					<div class="flex min-w-0 flex-wrap gap-1" data-board-card-labels>
						for _, label := range card.Labels {
							<span class="max-w-full truncate rounded-chip bg-surface px-1.5 py-0.5">{ label }</span>
						}
					</div>
				}
				if card.Effort != "" {
					<div class="flex min-w-0 items-center gap-1.5" data-board-card-effort>
						<span class="text-dim">Effort</span>
						<span class="truncate font-mono text-text">{ card.Effort }</span>
					</div>
				}
				if card.Activity != "" {
					<div class="line-clamp-2 min-w-0" data-board-card-activity><span class="text-dim">Activity</span> { card.Activity }</div>
				}
				if card.PRStatus != "" {
					<div class={ "w-fit rounded-chip border px-1.5 py-0.5 font-mono " + card.PRStatusClass } data-board-card-pr-status>{ card.PRStatus }</div>
				}
			</div>
		}
		<div class="flex flex-col gap-1.5 border-t border-line/70 pt-1.5" data-ai-debug-card-action>
			@aiDebugCopyButton(aiDebugIssuePath(card.Project, card.Identity), "inline-flex w-fit items-center gap-1.5 rounded-chip border border-line bg-surface px-2 py-1 text-2xs font-medium text-text hover:border-accent hover:text-accent")
		</div>
		if card.CanDrag {
			@boardKanbanDragMoveForm(card)
		}
	</article>
}

templ boardRuntimeBadge(card boardCardView) {
	<div
		id={ card.DomID + "-runtime-badge" }
		class="flex min-w-0 items-center gap-1.5 text-2xs text-ok"
		data-board-runtime-badge
		data-board-card-expanded
		if card.RuntimeSummary != "" {
			tabindex="0"
			role="img"
			aria-label={ "Agent runtime: " + card.RuntimeSummary }
			data-help-trigger
			data-help-scope="runtime-identity"
			data-help-term={ card.DomID + "-runtime-identity" }
			data-help-title="Agent runtime"
			data-help-description={ card.RuntimeDetail }
			onclick="event.stopPropagation()"
		}
	>
		@primitives.StatusDot(primitives.KindOK, false)
		<span class="min-w-0 truncate font-mono">
			<span class="runtime-badge-cozy" data-runtime-density="cozy">{ card.RuntimeCozyText }</span>
			<span class="runtime-badge-comfy" data-runtime-density="comfy">{ card.RuntimeComfyText }</span>
		</span>
	</div>
}

templ boardKanbanDragMoveForm(card boardCardView) {
	<form class="hidden" hx-post="/api/v1/kanban/move" hx-target="#snapshot" hx-swap="morph:innerHTML" data-kanban-drag-move-form>
		<input type="hidden" name="kanban_drag" value="true"/>
		<input type="hidden" name="kanban_board" value={ card.Scope }/>
		<input type="hidden" name="project_id" value={ card.MoveProject }/>
		<input type="hidden" name="issue_id" value={ card.IssueID }/>
		<input type="hidden" name="current_state" value={ card.CurrentState }/>
		<input type="hidden" name="target_state" value="" data-kanban-drag-target-state/>
		if card.PRNumber != "" {
			<input type="hidden" name="pr_number" value={ card.PRNumber }/>
		}
	</form>
}

// boardLanePicker renders inside the figure row but is driven by the
// delegated boardLaneScript outside #snapshot, so morphs cannot tear its
// behavior down; the script re-asserts open state on htmx:afterSettle.
templ boardLanePicker(view boardView) {
	<details id="board-lane-picker" class="relative col-span-3 justify-self-start md:col-span-1" data-board-lane-picker data-preserve-details="board-lane-picker">
		<summary class="flex min-h-11 cursor-pointer list-none items-center gap-1.5 rounded-chip border border-line px-2.5 py-1 text-2xs text-sec hover:text-text [&::-webkit-details-marker]:hidden md:min-h-0">
			Lanes <span data-board-lane-count class="tabular-nums">{ boardLaneCountLabel(view) }</span>
			<span
				class="rounded-chip bg-warn/15 px-1.5 py-0.5 font-mono text-warn"
				data-board-hidden-card-count
				title={ boardLaneHiddenCardSummary(view) }
				aria-label={ boardLaneHiddenCardSummary(view) }
				hidden?={ view.HiddenCards == 0 }
			>{ boardLaneHiddenCardBadgeLabel(view) }</span>
			@icon.ChevronDown(icon.Props{Class: "size-3"})
		</summary>
		<div class="absolute left-0 top-full z-40 mt-1 flex max-h-[calc(100vh-10rem)] w-[calc(100vw-2.5rem)] flex-col gap-1 overflow-y-auto rounded-card border border-line bg-elev p-1.5 md:left-auto md:right-0 md:max-h-none md:w-80 md:overflow-visible">
			<div class="flex items-center justify-between gap-2 border-b border-line px-1 pb-1.5">
				<span class="text-2xs font-medium uppercase text-sec">Visibility</span>
				<button
					type="button"
					class="inline-flex min-h-11 items-center gap-1.5 rounded-chip border border-line px-2 text-2xs font-medium text-sec hover:border-accent hover:text-accent disabled:pointer-events-none disabled:opacity-40 md:min-h-7"
					data-board-lane-reset-all
					aria-label="Reset all lanes to Auto"
					title="Reset all lanes to Auto"
					disabled
					aria-disabled="true"
				>
					@icon.RotateCcw(icon.Props{Class: "size-3"})
					<span>Reset all</span>
				</button>
			</div>
			for _, lane := range view.Lanes {
				<div class={ boardLaneVisibilityRowClass(lane) } data-board-lane-row={ lane.LaneID } data-board-lane-card-count={ strconv.Itoa(lane.CardCount) } data-board-lane-hidden-populated={ boardBoolAttr(boardLaneHiddenPopulated(lane)) }>
					<div class="flex min-w-0 items-center gap-2">
						<span class="min-w-0 flex-1 truncate font-medium">{ lane.Title }</span>
						<span class="rounded-chip bg-surface px-1.5 py-0.5 font-mono text-2xs text-sec tabular-nums">{ lane.Count }</span>
					</div>
					<div class="grid grid-cols-[minmax(0,1fr)_auto_auto] items-center gap-1.5">
						<span class="min-w-0 truncate text-2xs text-sec" title={ boardLaneVisibilityStatusTitle(lane) } data-board-lane-visibility-status>{ boardLaneVisibilityStatusLabel(lane) }</span>
						<select
							class="h-11 rounded-chip border border-line bg-surface px-2 text-2xs text-text outline-none focus:border-accent md:h-7"
							data-board-lane-visibility={ lane.LaneID }
							data-board-lane-visibility-state={ string(boardLaneVisibilityAuto) }
							data-board-lane-visibility-effective={ boardBoolAttr(lane.DefaultVisible) }
							aria-label={ "Visibility for " + lane.Title + " lane" }
							title={ boardLaneVisibilityStatusTitle(lane) }
						>
							<option value={ string(boardLaneVisibilityAuto) } selected>Auto</option>
							<option value={ string(boardLaneVisibilityShow) }>Show</option>
							<option value={ string(boardLaneVisibilityHide) }>Hide</option>
						</select>
						<button
							type="button"
							class="inline-flex size-11 items-center justify-center rounded-chip border border-line text-sec hover:border-accent hover:text-accent disabled:pointer-events-none disabled:opacity-40 md:size-7"
							data-board-lane-reset={ lane.LaneID }
							value={ lane.LaneID }
							aria-label={ "Reset " + lane.Title + " lane to Auto" }
							title="Reset lane to Auto"
							disabled
							aria-disabled="true"
						>
							@icon.RotateCcw(icon.Props{Class: "size-3"})
						</button>
					</div>
				</div>
			}
		</div>
	</details>
}

templ boardLaneScript() {
	<script>
		(function () {
			var storagePrefix = "detent.ui.board.lanes.v2.";
			var legacyStoragePrefix = "detent.ui.board.lanes.";
			var storageVersion = 1;
			var stateAuto = "auto";
			var stateShow = "show";
			var stateHide = "hide";
			var pickerOpen = false;
			var activeLaneID = "";
			var lanePositionFrame = 0;

			function visibilityStorage() {
				try {
					return window.localStorage;
				} catch (err) {
					return null;
				}
			}
			function storageKey(root) {
				return storagePrefix + (root.getAttribute("data-board-key") || "fleet");
			}
			function legacyStorageKey(root) {
				return legacyStoragePrefix + (root.getAttribute("data-board-key") || "fleet");
			}
			function emptyPrefs() {
				return { show: new Set(), hide: new Set() };
			}
			function laneIDSet(ids) {
				var out = new Set();
				if (!Array.isArray(ids)) return out;
				ids.forEach(function (id) {
					if (typeof id === "string" && id.trim() !== "") out.add(id);
				});
				return out;
			}
			function normalizedPrefs(showIDs, hideIDs) {
				var prefs = emptyPrefs();
				laneIDSet(showIDs).forEach(function (id) {
					prefs.show.add(id);
				});
				laneIDSet(hideIDs).forEach(function (id) {
					if (!prefs.show.has(id)) prefs.hide.add(id);
				});
				return prefs;
			}
			function discardLegacyPrefs(root, store) {
				var legacy = legacyStorageKey(root);
				try {
					if (legacy !== storageKey(root)) store.removeItem(legacy);
				} catch (err) {}
			}
			function readPrefs(root) {
				var store = visibilityStorage();
				if (!store) return emptyPrefs();
				discardLegacyPrefs(root, store);
				var raw = "";
				try {
					raw = store.getItem(storageKey(root));
				} catch (err) {
					return emptyPrefs();
				}
				if (!raw) return emptyPrefs();
				try {
					var parsed = JSON.parse(raw);
					if (!parsed || parsed.v !== storageVersion) {
						try {
							store.removeItem(storageKey(root));
						} catch (err) {}
						return emptyPrefs();
					}
					return normalizedPrefs(parsed.show, parsed.hide);
				} catch (err) {
					try {
						store.removeItem(storageKey(root));
					} catch (err) {}
					return emptyPrefs();
				}
			}
			function writePrefs(root, prefs) {
				var store = visibilityStorage();
				if (!store) return;
				var show = Array.from(prefs.show).filter(Boolean).sort();
				var hide = Array.from(prefs.hide).filter(function (id) {
					return Boolean(id) && !prefs.show.has(id);
				}).sort();
				if (show.length === 0 && hide.length === 0) {
					try {
						store.removeItem(storageKey(root));
					} catch (err) {}
					return;
				}
				try {
					store.setItem(storageKey(root), JSON.stringify({ v: storageVersion, show: show, hide: hide }));
				} catch (err) {}
			}
			function prefsHaveOverrides(prefs) {
				return prefs.show.size > 0 || prefs.hide.size > 0;
			}
			function queryRoot(scope) {
				if (scope && typeof scope.querySelector === "function" && typeof scope.querySelectorAll === "function") return scope;
				return document;
			}
			function boardLanesRoot(scope) {
				if (scope instanceof Element && scope.matches("[data-board-lanes]")) return scope;
				if (scope && typeof scope.querySelector === "function") return scope.querySelector("[data-board-lanes]");
				return null;
			}
			function findByData(scope, attr, value) {
				var root = queryRoot(scope);
				var nodes = root.querySelectorAll("[" + attr + "]");
				for (var i = 0; i < nodes.length; i += 1) {
					if (nodes[i].getAttribute(attr) === value) return nodes[i];
				}
				return null;
			}
			function laneID(lane) {
				return lane.getAttribute("data-board-lane") || "";
			}
			function laneDefaultVisible(lane) {
				return lane.getAttribute("data-board-lane-default") === "true";
			}
			function laneCardCount(lane) {
				var parsed = Number.parseInt(lane.getAttribute("data-board-lane-card-count") || "0", 10);
				if (!Number.isFinite(parsed) || parsed < 0) return 0;
				return parsed;
			}
			function laneTitle(lane) {
				return lane.getAttribute("data-board-lane-title") || "lane";
			}
			function visibleBoardLanes(root) {
				return Array.from(root.querySelectorAll("[data-board-lane]")).filter(function (lane) {
					return lane.getAttribute("data-lane-hidden") !== "true";
				});
			}
			function lanePositionIndex(root, lanes, preferredID) {
				if (lanes.length === 0) return -1;
				if (preferredID) {
					var preferred = lanes.findIndex(function (lane) {
						return laneID(lane) === preferredID;
					});
					if (preferred >= 0) return preferred;
				}
				if (!root.isConnected) return 0;
				var rootRect = root.getBoundingClientRect();
				var center = rootRect.left + root.clientWidth / 2;
				var nearest = 0;
				var nearestDistance = Number.POSITIVE_INFINITY;
				lanes.forEach(function (lane, index) {
					var rect = lane.getBoundingClientRect();
					var distance = Math.abs(rect.left + rect.width / 2 - center);
					if (distance < nearestDistance) {
						nearest = index;
						nearestDistance = distance;
					}
				});
				return nearest;
			}
			function updateLanePosition(scope, root, preferredID) {
				var lanes = visibleBoardLanes(root);
				var index = lanePositionIndex(root, lanes, preferredID);
				var current = index < 0 ? 0 : index + 1;
				var position = queryRoot(scope).querySelector("[data-board-lane-position]");
				if (position) {
					var currentNode = position.querySelector("[data-board-lane-position-current]");
					var totalNode = position.querySelector("[data-board-lane-position-total]");
					if (currentNode) currentNode.textContent = String(current);
					if (totalNode) totalNode.textContent = String(lanes.length);
					position.setAttribute("aria-label", "Lane " + current + " of " + lanes.length);
				}
				if (root.isConnected && index >= 0) activeLaneID = laneID(lanes[index]);
