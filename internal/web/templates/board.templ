				}
				return null;
			}
			function recentTouchIdentifier(card, event) {
				if (event.pointerType !== "touch" || !recentTouchStart) return null;
				if (Date.now() - recentTouchStart.startedAt >= 100) return null;
				if (!(recentTouchStart.target instanceof Node) || !card.contains(recentTouchStart.target)) return null;
				return recentTouchStart.identifier;
			}
			function feedback(message, kind) {
				var target = document.getElementById("board-feedback");
				if (!target) return;
				var text = String(message || "").trim();
				target.className = "flex flex-none items-center gap-2 px-5 pt-3.5 text-xs " + (kind === "error" ? "text-err" : "text-sec");
				target.textContent = text;
				target.hidden = text === "";
			}
			function queryRoot(scope) {
				if (scope && typeof scope.querySelector === "function" && typeof scope.querySelectorAll === "function") return scope;
				return document;
			}
