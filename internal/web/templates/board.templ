				queryRoot(scope).querySelectorAll("[data-board-lane-reset-all]").forEach(function (button) {
					setResetDisabled(button, !prefsHaveOverrides(prefs));
				});
			}
			function applyTo(scope) {
				var root = boardLanesRoot(scope);
				if (!root) return false;
				var prefs = readPrefs(root);
				var total = 0;
				var visible = 0;
				var hiddenCards = 0;
				var hiddenLanes = [];
				root.querySelectorAll("[data-board-lane]").forEach(function (lane) {
					total += 1;
					var state = laneOverrideState(lane, prefs);
					var show = laneVisible(lane, state);
					var cards = laneCardCount(lane);
					lane.setAttribute("data-lane-hidden", show ? "false" : "true");
					lane.setAttribute("data-board-lane-visibility-state", state);
