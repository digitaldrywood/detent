				var doc = new DOMParser().parseFromString(response, "text/html");
				return (doc.body.textContent || "").trim();
			}
			function buildGhost(card, rect) {
				var ghost = card.cloneNode(true);
				ghost.removeAttribute("id");
				ghost.querySelectorAll("[id]").forEach(function (node) {
					node.removeAttribute("id");
				});
				var form = ghost.querySelector("[data-kanban-drag-move-form]");
				if (form) form.remove();
				delete ghost.dataset.kanbanDragging;
				var origin = document.createElement("div");
				origin.className = "mb-1.5 flex items-center gap-1.5 border-b border-line pb-1.5 font-mono text-2xs font-medium text-accent";
				origin.textContent = "From " + (card.dataset.kanbanCurrentState || "current lane");
