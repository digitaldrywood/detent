package templates

import "github.com/digitaldrywood/detent/internal/web/ui/primitives"

// BoardPage is the app's home: exception strip → figure row → fixed-height,
// independently-scrollable lanes. The page itself never scrolls.
templ BoardPage(data DashboardData) {
	@AppShell(BoardShellDataFromDashboard(data), boardScopeSelect(data)) {
		<main class="flex min-h-0 min-w-0 flex-1 flex-col">
			<div
				id="snapshot"
				class="flex min-h-0 min-w-0 flex-1 flex-col"
				sse-swap="snapshot"
				hx-swap="morph:innerHTML"
			>
				@BoardSnapshot(data)
			</div>
		</main>
		@boardLaneScript()
		@boardKanbanDragScript()
	}
}

// BoardSnapshot is the morph target for SSE ticks. Every element carries a
// stable id so idiomorph preserves DOM (and lane scroll positions).
// First paint: an unconfigured instance gets the first-run state, a
// configured one waiting on its first snapshot gets lane skeletons —
// never again once data exists. A degraded refresh that still carries
// prior tracker data keeps the last-known lanes visible (via
// projectKanbanBoardLoaded) rather than flashing skeletons.
templ BoardSnapshot(data DashboardData) {
	if boardFirstRun(data) {
		@primitives.FirstRun("Connect a repository to start orchestrating.", "Add project", "/settings", "projects are defined in the global config")
	} else if !projectKanbanBoardLoaded(data) {
		if snapshotDegraded(data.Snapshot) {
			<div class="flex-none px-5 pt-4">
				@snapshotReadiness(data.Snapshot)
			</div>
		} else {
			@primitives.SkeletonLanes(4)
		}
	} else {
		@boardSnapshotBody(data)
	}
}

templ boardSnapshotBody(data DashboardData) {
	{{ view := boardViewFromDashboard(data) }}
	if len(view.Exceptions) > 0 {
		<div id="board-exceptions" class="flex-none px-5 pt-3.5">
			@primitives.ExceptionStrip(view.Exceptions)
		</div>
	}
	<p id="board-feedback" class={ "flex flex-none items-center gap-2 px-5 pt-3.5 text-xs " + boardFeedbackClass(data.Kanban.FeedbackKind) } role="status" aria-live="polite" hidden?={ data.Kanban.Feedback == "" }>
		if data.Kanban.Feedback != "" {
			<span aria-hidden="true">{ boardFeedbackGlyph(data.Kanban.FeedbackKind) }</span>
			{ data.Kanban.Feedback }
		}
	</p>
	<div id="board-figures" class="flex-none px-5 pb-3 pt-4">
		@primitives.FigureRow(view.Figures) {
			@primitives.MonoFigure("fig-tps", view.TPS)
			@primitives.MonoFigure("fig-spend", view.Spend)
			@boardLanePicker(view)
		}
	</div>
	<div
		id="board-lanes"
		class="dt-lane-scroll flex min-h-0 min-w-0 flex-1 gap-3 overflow-x-auto overflow-y-hidden px-5 pb-5"
		data-board-lanes
		data-board-key={ view.Key }
		data-preserve-scroll="board-lanes"
	>
		for _, lane := range view.Lanes {
			@boardLaneView2(lane)
		}
	</div>
}

templ boardLaneView2(lane boardLaneView) {
	<section
		id={ lane.DomID }
		class="flex min-w-44 max-w-80 flex-1 flex-col overflow-hidden rounded-card border border-line bg-surface data-[kanban-drop-allowed=false]:border-err/45 data-[kanban-drop-allowed=false]:opacity-70 data-[kanban-drop-allowed=true]:border-accent data-[lane-hidden=true]:hidden"
		data-board-lane={ lane.LaneID }
		data-board-lane-title={ lane.Title }
		data-board-lane-default={ boardBoolAttr(lane.DefaultVisible) }
		data-lane-hidden={ boardBoolAttr(!lane.DefaultVisible) }
		if lane.DropState != "" {
			data-kanban-drop-state={ lane.DropState }
			data-kanban-drop-key={ lane.DropKey }
		}
	>
		<header class="flex flex-none items-center gap-1.5 border-b border-line px-3 py-2">
			if lane.Live {
				@primitives.StatusDot(primitives.KindOK, true)
			}
			<h2 class="text-xs font-semibold text-text">{ lane.Title }</h2>
			<span class="font-mono text-2xs font-medium text-sec tabular-nums">{ lane.Count }</span>
		</header>
		<div class="dt-lane-scroll flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto overflow-x-hidden p-2" data-preserve-scroll={ lane.DomID + "-scroll" }>
			if len(lane.Cards) == 0 {
				@primitives.EmptyLine(lane.EmptyMessage)
			}
			for _, card := range lane.Cards {
				@boardCardView2(card)
			}
		</div>
	</section>
}

templ boardCardView2(card boardCardView) {
	<article
		id={ card.DomID }
		class={ boardCardClass(card) + " cursor-pointer hover:border-accent/50 data-[kanban-dragging=true]:opacity-60" }
		role="button"
		tabindex="0"
		{ sheetOpenAttrs(card.Project, card.Identity, card.Scope, true)... }
		if card.DragDrop {
			data-kanban-card
			data-kanban-current-state={ card.CurrentState }
			if card.IssueID != "" {
				data-kanban-issue-id={ card.IssueID }
			}
			if card.CanDrag {
				draggable="true"
				data-kanban-action="move"
				data-kanban-allowed-targets={ card.AllowedTargets }
			} else {
				aria-disabled="true"
			}
		}
	>
		<div class="flex items-center gap-1.5 font-mono text-2xs font-medium text-sec">
			if card.Running {
				@primitives.StatusDot(primitives.KindOK, true)
			}
			<span class={ boardCardNumberClass(card) }>{ card.Number }</span>
			<span class="truncate">{ card.Project }</span>
			<span class="flex-1"></span>
			if card.Done {
				<span class="text-ok" role="img" aria-label="done">✓</span>
			} else if card.MetaRight != "" {
				<span class="flex-none whitespace-nowrap tabular-nums">{ card.MetaRight }</span>
			}
		</div>
		<div class={ boardCardTitleClass(card) }>{ card.Title }</div>
		if card.ExtraText != "" {
			if card.ExtraChip {
				<div class="flex">
					@primitives.Chip(card.ExtraKind, card.ExtraText)
				</div>
			} else {
				<div class={ "flex items-center gap-1.5 text-2xs " + boardExtraTextClass(card.ExtraKind) }>
					@primitives.StatusDot(card.ExtraKind, false)
					{ card.ExtraText }
				</div>
			}
		}
		if card.AgeFooter != "" {
			<div class="mt-0.5 flex items-center justify-between gap-2 border-t border-line/70 pt-1.5 font-mono text-2xs text-sec" title={ card.AgeFooterTitle } data-board-card-age-footer>
				<span class="min-w-0 truncate">In lane</span>
				<span class="flex-none whitespace-nowrap tabular-nums">{ card.AgeFooter }</span>
			</div>
		}
		if card.CanDrag {
			@boardKanbanDragMoveForm(card)
		}
	</article>
}

templ boardKanbanDragMoveForm(card boardCardView) {
	<form class="hidden" hx-post="/api/v1/kanban/move" hx-target="#snapshot" hx-swap="morph:innerHTML" data-kanban-drag-move-form>
		<input type="hidden" name="kanban_drag" value="true"/>
		<input type="hidden" name="kanban_board" value={ card.Scope }/>
		<input type="hidden" name="project_id" value={ card.MoveProject }/>
		<input type="hidden" name="issue_id" value={ card.IssueID }/>
		<input type="hidden" name="current_state" value={ card.CurrentState }/>
		<input type="hidden" name="target_state" value="" data-kanban-drag-target-state/>
		if card.PRNumber != "" {
			<input type="hidden" name="pr_number" value={ card.PRNumber }/>
		}
	</form>
}

// boardLanePicker renders inside the figure row but is driven by the
// delegated boardLaneScript outside #snapshot, so morphs cannot tear its
// behavior down; the script re-asserts open state on htmx:afterSettle.
templ boardLanePicker(view boardView) {
	<details id="board-lane-picker" class="relative" data-board-lane-picker data-preserve-details="board-lane-picker">
		<summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-chip border border-line px-2.5 py-1 text-2xs text-sec hover:text-text [&::-webkit-details-marker]:hidden">
			Lanes <span data-board-lane-count class="tabular-nums">{ boardLaneCountLabel(view) }</span>
			<span aria-hidden="true">▾</span>
		</summary>
		<div class="absolute right-0 top-full z-40 mt-1 flex w-56 flex-col gap-0.5 rounded-card border border-line bg-elev p-1.5">
			for _, lane := range view.Lanes {
				<label class="flex cursor-pointer items-center gap-2 rounded-chip px-2 py-1 text-xs text-text hover:bg-surface">
					<input
						type="checkbox"
						class="accent-accent"
						data-board-lane-toggle={ lane.LaneID }
						checked?={ lane.DefaultVisible }
					/>
					<span class="flex-1">{ lane.Title }</span>
					<span class="font-mono text-2xs text-sec tabular-nums">{ lane.Count }</span>
				</label>
			}
		</div>
	</details>
}

templ boardLaneScript() {
	<script>
		(function () {
			function storageKey(root) {
				return "detent.ui.board.lanes." + (root.getAttribute("data-board-key") || "fleet");
			}
			function readPrefs(root) {
				try {
					return JSON.parse(localStorage.getItem(storageKey(root)) || "{}");
				} catch (err) {
					return {};
				}
			}
			function writePrefs(root, prefs) {
				try {
					localStorage.setItem(storageKey(root), JSON.stringify(prefs));
				} catch (err) {}
			}
			var pickerOpen = false;
			function boardLanesRoot(scope) {
				if (scope instanceof Element && scope.matches("[data-board-lanes]")) return scope;
				if (scope && typeof scope.querySelector === "function") return scope.querySelector("[data-board-lanes]");
				return null;
			}
			function applyTo(scope) {
				var root = boardLanesRoot(scope);
				if (!root) return false;
				var prefs = readPrefs(root);
				var total = 0;
				var visible = 0;
				root.querySelectorAll("[data-board-lane]").forEach(function (lane) {
					total += 1;
					var id = lane.getAttribute("data-board-lane");
					var byDefault = lane.getAttribute("data-board-lane-default") === "true";
					var show = Object.prototype.hasOwnProperty.call(prefs, id) ? Boolean(prefs[id]) : byDefault;
					lane.setAttribute("data-lane-hidden", show ? "false" : "true");
					if (show) visible += 1;
					var toggle = scope.querySelector('[data-board-lane-toggle="' + id + '"]');
					if (toggle) {
						toggle.checked = show;
						if (show) {
							toggle.setAttribute("checked", "");
						} else {
							toggle.removeAttribute("checked");
						}
					}
				});
				var count = scope.querySelector("[data-board-lane-count]");
				if (count) count.textContent = visible + "/" + total;
				var picker = scope.querySelector("[data-board-lane-picker]");
				if (picker && pickerOpen) picker.setAttribute("open", "");
				return true;
			}
			function apply() {
				applyTo(document);
			}
			function adjustedBoardHTML(html) {
				if (typeof html !== "string" || html.indexOf("data-board-lanes") < 0) return "";
				var template = document.createElement("template");
				template.innerHTML = html;
				if (!applyTo(template.content)) return "";
				return template.innerHTML;
			}
			function snapshotSwapTarget(event) {
				var target = event.detail && event.detail.target;
				if (!(target instanceof Element)) target = event.target;
				if (!(target instanceof Element)) return false;
				return target.id === "snapshot" || Boolean(target.closest("#snapshot"));
			}
			function applyBeforeSwap(event) {
				var detail = event.detail || {};
				if (!snapshotSwapTarget(event) || typeof detail.serverResponse !== "string") return;
				var adjusted = adjustedBoardHTML(detail.serverResponse);
				if (!adjusted) return;
				detail.serverResponse = adjusted;
			}
			function applyBeforeSSEMessage(event) {
				var detail = event.detail || {};
				var target = detail.elt;
				if (!(target instanceof Element)) target = event.target;
				if (!(target instanceof Element) || target.id !== "snapshot") return;
				if (!window.htmx || typeof window.htmx.swap !== "function") return;
				var adjusted = adjustedBoardHTML(detail.data);
				if (!adjusted) return;
				event.preventDefault();
				window.htmx.swap(target, adjusted, { swapStyle: target.getAttribute("hx-swap") || "innerHTML" }, { contextElement: target });
			}
			document.addEventListener("change", function (event) {
				var toggle = event.target.closest("[data-board-lane-toggle]");
				if (!toggle) return;
				var root = document.querySelector("[data-board-lanes]");
				if (!root) return;
				var prefs = readPrefs(root);
				prefs[toggle.getAttribute("data-board-lane-toggle")] = toggle.checked;
				writePrefs(root, prefs);
				apply();
			});
			document.addEventListener("toggle", function (event) {
				var picker = event.target;
				if (picker instanceof Element && picker.hasAttribute("data-board-lane-picker")) {
					pickerOpen = picker.open;
				}
			}, true);
			document.addEventListener("click", function (event) {
				var picker = document.querySelector("[data-board-lane-picker]");
				if (picker && picker.open && !picker.contains(event.target)) {
					picker.removeAttribute("open");
					pickerOpen = false;
				}
			});
			document.addEventListener("htmx:beforeSwap", applyBeforeSwap);
			document.addEventListener("htmx:sseBeforeMessage", applyBeforeSSEMessage);
			document.addEventListener("htmx:afterSettle", apply);
			document.addEventListener("DOMContentLoaded", apply);
			apply();
		})();
	</script>
}

templ boardKanbanDragScript() {
	<script>
		(function () {
			if (window.__detentBoardKanbanDragHandlersRegistered) return;
			window.__detentBoardKanbanDragHandlersRegistered = true;
			var draggedIssueID = "";
			var dropped = false;
			var blockedDrop = false;
			function feedback(message, kind) {
				var target = document.getElementById("board-feedback");
				if (!target) return;
				var text = String(message || "").trim();
				target.className = "flex flex-none items-center gap-2 px-5 pt-3.5 text-xs " + (kind === "error" ? "text-err" : "text-sec");
				target.textContent = text;
				target.hidden = text === "";
			}
			function markedDraggedCard() {
				return document.querySelector("[data-kanban-card][data-kanban-dragging='true']");
			}
			function draggedCard() {
				if (!draggedIssueID || !window.CSS || typeof CSS.escape !== "function") return null;
				return document.querySelector("[data-kanban-card][data-kanban-issue-id='" + CSS.escape(draggedIssueID) + "']");
			}
			function activeDragIssueID(event) {
				if (draggedIssueID) return draggedIssueID;
				var marked = markedDraggedCard();
				if (marked instanceof HTMLElement && marked.dataset.kanbanIssueId) return marked.dataset.kanbanIssueId;
				if (!event.dataTransfer || typeof event.dataTransfer.getData !== "function") return "";
				return event.dataTransfer.getData("text/plain") || "";
			}
			function allowedTargetKeys(card) {
				if (!(card instanceof HTMLElement)) return [];
				return (card.dataset.kanbanAllowedTargets || "").split(/\s+/).filter(Boolean);
			}
			function laneAllowed(card, lane) {
				if (!(lane instanceof HTMLElement)) return false;
				var key = lane.dataset.kanbanDropKey || "";
				return key !== "" && allowedTargetKeys(card).includes(key);
			}
			function dragImageOffset(position, start, size) {
				if (position <= 0 || size <= 0) return Math.max(0, size / 2);
				return Math.min(Math.max(position - start, 0), size);
			}
			function setCardDragImage(event, card) {
				if (!event.dataTransfer) return;
				var rect = card.getBoundingClientRect();
				event.dataTransfer.setDragImage(
					card,
					Math.round(dragImageOffset(event.clientX, rect.left, rect.width)),
					Math.round(dragImageOffset(event.clientY, rect.top, rect.height))
				);
			}
			function setDropTargetState(card) {
				document.querySelectorAll("[data-kanban-drop-state]").forEach(function (lane) {
					if (!(lane instanceof HTMLElement)) return;
					if (lane.dataset.kanbanDropWasHidden === undefined) {
						lane.dataset.kanbanDropWasHidden = lane.dataset.laneHidden || "false";
					}
					var allowed = laneAllowed(card, lane);
					lane.dataset.laneHidden = "false";
					lane.dataset.kanbanDropAllowed = allowed ? "true" : "false";
					lane.setAttribute("aria-disabled", allowed ? "false" : "true");
				});
			}
			function clearDropTargetState() {
				document.querySelectorAll("[data-kanban-drop-state]").forEach(function (lane) {
					if (!(lane instanceof HTMLElement)) return;
					if (lane.dataset.kanbanDropWasHidden !== undefined) {
						lane.dataset.laneHidden = lane.dataset.kanbanDropWasHidden;
						delete lane.dataset.kanbanDropWasHidden;
					}
					delete lane.dataset.kanbanDropAllowed;
					lane.removeAttribute("aria-disabled");
				});
				document.querySelectorAll("[data-kanban-card][data-kanban-dragging='true']").forEach(function (card) {
					if (card instanceof HTMLElement) delete card.dataset.kanbanDragging;
				});
			}
			function responseMessage(response) {
				if (!response) return "";
				var doc = new DOMParser().parseFromString(response, "text/html");
				return (doc.body.textContent || "").trim();
			}
			document.addEventListener("dragstart", function (event) {
				var card = event.target instanceof Element ? event.target.closest("[data-kanban-card]") : null;
				if (!card || card.getAttribute("draggable") !== "true") return;
				draggedIssueID = card.dataset.kanbanIssueId || "";
				dropped = false;
				blockedDrop = false;
				if (!draggedIssueID) {
					event.preventDefault();
					return;
				}
				card.dataset.kanbanDragging = "true";
				if (event.dataTransfer) {
					event.dataTransfer.effectAllowed = "move";
					event.dataTransfer.setData("text/plain", draggedIssueID);
				}
				setCardDragImage(event, card);
				setDropTargetState(card);
				feedback("Moving " + (card.dataset.kanbanCurrentState || "card") + ".");
			});
			document.addEventListener("dragover", function (event) {
				var issueID = activeDragIssueID(event);
				if (!issueID) return;
				draggedIssueID = issueID;
				var lane = event.target instanceof Element ? event.target.closest("[data-kanban-drop-state]") : null;
				if (!lane) return;
				var allowed = laneAllowed(draggedCard(), lane);
				if (event.dataTransfer) event.dataTransfer.dropEffect = allowed ? "move" : "none";
				if (allowed) {
					event.preventDefault();
					blockedDrop = false;
					return;
				}
				blockedDrop = true;
				feedback("Move blocked by transition policy.", "error");
			});
			document.addEventListener("drop", function (event) {
				var issueID = activeDragIssueID(event);
				if (!issueID) return;
				draggedIssueID = issueID;
				var lane = event.target instanceof Element ? event.target.closest("[data-kanban-drop-state]") : null;
				if (!lane) return;
				event.preventDefault();
				var card = draggedCard();
				if (!laneAllowed(card, lane)) {
					feedback("Move blocked by transition policy.", "error");
					dropped = true;
					return;
				}
				var form = card ? card.querySelector("[data-kanban-drag-move-form]") : null;
				var targetState = form ? form.querySelector("[data-kanban-drag-target-state]") : null;
				if (!(form instanceof HTMLFormElement) || !(targetState instanceof HTMLInputElement)) {
					feedback("Move cancelled.", "error");
					return;
				}
				targetState.value = lane.dataset.kanbanDropState || "";
				dropped = true;
				form.requestSubmit();
			});
			document.addEventListener("dragend", function () {
				if (draggedIssueID && !dropped && !blockedDrop) {
					feedback("Move cancelled.", "error");
				}
				draggedIssueID = "";
				dropped = false;
				blockedDrop = false;
				clearDropTargetState();
			});
			document.body.addEventListener("htmx:responseError", function (event) {
				var form = event.detail && event.detail.elt;
				if (!(form instanceof HTMLFormElement) || !form.matches("[data-kanban-drag-move-form]")) return;
				var response = event.detail.xhr ? event.detail.xhr.responseText : "";
				feedback(responseMessage(response) || "Move failed.", "error");
			});
		})();
	</script>
}

// boardScopeSelect is the topbar scope control: a CSS-only dropdown living
// outside #snapshot linking to each project's board.
templ boardScopeSelect(data DashboardData) {
	<details class="group/scope relative">
		<summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-card border border-line px-2.5 py-1 text-xs text-sec hover:text-text [&::-webkit-details-marker]:hidden">
			{ boardScopeLabel(data) }
			<span aria-hidden="true">▾</span>
		</summary>
		<div class="absolute left-0 top-full z-40 mt-1 flex w-52 flex-col gap-0.5 rounded-card border border-line bg-elev p-1.5">
			<a href="/" class="rounded-chip px-2 py-1 text-xs text-text hover:bg-surface">All projects</a>
			for _, project := range appShellProjects(DashboardShellDataFromDashboard(data)) {
				<a href={ templ.SafeURL(project.Href + "/kanban") } class="truncate rounded-chip px-2 py-1 text-xs text-text hover:bg-surface">{ project.Name }</a>
			}
		</div>
	</details>
}
