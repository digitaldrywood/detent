			// pointer moves, which is enough to reach off-screen lanes.
			function autoScrollLanes(x) {
				var lanes = document.getElementById("board-lanes");
				if (!lanes) return;
				var rect = lanes.getBoundingClientRect();
				if (x < rect.left + 48) {
					lanes.scrollLeft -= 16;
				} else if (x > rect.right - 48) {
					lanes.scrollLeft += 16;
				}
			}
			function visibleDropLanes(lanes) {
				return Array.from(lanes.querySelectorAll("[data-kanban-drop-state]")).filter(function (lane) {
					return lane instanceof HTMLElement && lane.dataset.laneHidden !== "true";
				});
			}
			function closestLaneIndex(lanes, laneNodes) {
				var center = lanes.getBoundingClientRect().left + lanes.clientWidth / 2;
				var closest = 0;
				var distance = Infinity;
				laneNodes.forEach(function (lane, index) {
					var rect = lane.getBoundingClientRect();
					var candidate = Math.abs(rect.left + rect.width / 2 - center);
					if (candidate < distance) {
						distance = candidate;
						closest = index;
					}
				});
				return closest;
			}
			function advanceTouchLane(direction) {
				if (!active || active.pointerType !== "touch" || active.edgeDirection !== direction) return;
				active.edgeTimer = null;
				var lanes = document.getElementById("board-lanes");
				if (!lanes) return;
				var laneNodes = visibleDropLanes(lanes);
				if (laneNodes.length === 0) return;
				var current = closestLaneIndex(lanes, laneNodes);
				var target = Math.max(0, Math.min(laneNodes.length - 1, current + direction));
				if (target !== current) {
					laneNodes[target].scrollIntoView({ behavior: "smooth", block: "nearest", inline: "start" });
				}
				if (active && active.edgeDirection === direction && target !== current) {
					active.edgeTimer = window.setTimeout(function () {
						advanceTouchLane(direction);
					}, TOUCH_EDGE_ADVANCE_MS);
				}
			}
			function updateTouchEdgeAdvance(x) {
				if (!active || active.pointerType !== "touch") return;
				var lanes = document.getElementById("board-lanes");
				if (!lanes) return;
				var rect = lanes.getBoundingClientRect();
				var direction = x < rect.left + TOUCH_EDGE_ZONE_PX ? -1 : (x > rect.right - TOUCH_EDGE_ZONE_PX ? 1 : 0);
				if (direction === active.edgeDirection) return;
				if (active.edgeTimer) window.clearTimeout(active.edgeTimer);
				active.edgeDirection = direction;
				active.edgeTimer = direction === 0 ? null : window.setTimeout(function () {
					advanceTouchLane(direction);
				}, TOUCH_EDGE_ADVANCE_MS);
			}
			function stopTouchEdgeAdvance() {
				if (!active) return;
				if (active.edgeTimer) window.clearTimeout(active.edgeTimer);
				active.edgeTimer = null;
				active.edgeDirection = 0;
			}
			function suppressNextClick() {
				var until = Date.now() + 400;
				document.addEventListener("click", function suppress(event) {
					document.removeEventListener("click", suppress, true);
					if (Date.now() > until) return;
					event.preventDefault();
					event.stopImmediatePropagation();
				}, true);
			}
			function beginDrag(event) {
				var press = pending;
				if (!press) return;
				if (press.longPressTimer) window.clearTimeout(press.longPressTimer);
				draggedIssueID = press.issueID;
				draggedAllowedTargetKeys = press.targets;
				var card = draggedCard(document) || press.card;
				active = {
					pointerId: press.pointerId,
					pointerType: press.pointerType,
					touchIdentifier: press.touchIdentifier,
					offsetX: press.startX - press.rect.left,
					offsetY: press.startY - press.rect.top,
					ghost: buildGhost(card, press.rect),
					lastLaneBlocked: false,
					startedAt: press.startedAt,
					captureElement: press.card,
					touchStyles: new Map(),
					edgeDirection: 0,
					edgeTimer: null
				};
				pending = null;
				recentTouchStart = null;
				if (active.pointerType === "touch" && typeof active.captureElement.setPointerCapture === "function") {
					try {
						active.captureElement.setPointerCapture(active.pointerId);
					} catch (_) {}
				}
				card.dataset.kanbanDragging = "true";
				setDropTargetState(card, document);
				applyTouchDragStyles(card, document);
				feedback("Moving " + (card.dataset.kanbanCurrentState || "card") + ".");
				moveGhost(active.ghost, event.clientX, event.clientY, active.offsetX, active.offsetY);
			}
			function finishDrag(keepClick) {
				if (active) {
					stopTouchEdgeAdvance();
					restoreTouchDragStyles();
					if (active.ghost) active.ghost.remove();
					if (active.captureElement && typeof active.captureElement.releasePointerCapture === "function") {
						try {
							if (active.captureElement.hasPointerCapture(active.pointerId)) active.captureElement.releasePointerCapture(active.pointerId);
						} catch (_) {}
					}
				}
				clearPending();
				active = null;
				draggedIssueID = "";
				draggedAllowedTargetKeys = [];
				clearDropTargetState();
				// A drag ends with the pointer still over a card, so the release
				// also fires a click; swallow it or the detail sheet opens.
				if (!keepClick) suppressNextClick();
			}
			function cancelDrag(keepClick) {
				if (!active) {
					clearPending();
					return;
				}
				finishDrag(keepClick);
				feedback("Move cancelled.", "error");
			}
			function rollbackPendingMove(card) {
				if (!(card instanceof HTMLElement) || !card.dataset.kanbanPendingMove) return;
				var targetLane = card.closest("[data-kanban-drop-state]");
				var targetWasHidden = card.dataset.kanbanPendingTargetWasHidden === "true";
				var originState = card.dataset.kanbanPendingOrigin || "";
				clearPendingMove(card);
				placeCardInLane(card, originState, document);
				if (targetLane instanceof HTMLElement) {
					targetLane.dataset.laneHidden = targetWasHidden ? "true" : "false";
					updateEmptyLine(cardContainer(targetLane));
				}
			}
			function moveDragTo(x, y) {
				if (!active) return;
				moveGhost(active.ghost, x, y, active.offsetX, active.offsetY);
				if (active.pointerType === "touch") {
					updateTouchEdgeAdvance(x);
				} else {
					autoScrollLanes(x);
				}
				var lane = laneFromPoint(x, y);
				var card = draggedCard(document);
				var blocked = lane instanceof HTMLElement && lane.dataset.kanbanDropSource !== "true" && !laneAllowed(card, lane);
				if (blocked && !active.lastLaneBlocked) {
					feedback("Move blocked by transition policy.", "error");
				} else if (!blocked && active.lastLaneBlocked) {
					feedback("Moving " + ((card && card.dataset.kanbanCurrentState) || "card") + ".");
				}
				active.lastLaneBlocked = blocked;
			}
			document.addEventListener("pointerdown", function (event) {
				if (active || event.button !== 0 || event.isPrimary === false) return;
				var pressedElement = event.target instanceof Element ? event.target : null;
				var pressedCard = pressedElement ? pressedElement.closest("[data-kanban-card]") : null;
				if (pressedCard && !connectionAllowsMoves()) {
					if (pressedElement.closest("a, button, input, select, textarea, summary, label, [data-help-trigger]")) return;
					feedback("Moves are disabled while the board reconnects. Reload if the connection does not recover.", "error");
					return;
				}
				if (pressedCard && pressedCard.dataset.kanbanMoveDisabled === "true") {
					if (pressedElement.closest("a, button, input, select, textarea, summary, label, [data-help-trigger]")) return;
					feedback(pressedCard.dataset.kanbanMoveDisabledReason || "This card cannot be moved.", "error");
					return;
				}
				var card = pressedCard && pressedCard.dataset.kanbanAction === "move" ? pressedCard : null;
				if (!card) return;
				if (card.dataset.kanbanPendingMove) return;
				var issueID = card.dataset.kanbanIssueId || "";
				if (!issueID) return;
				pending = {
					pointerId: event.pointerId,
					pointerType: event.pointerType,
					touchIdentifier: recentTouchIdentifier(card, event),
					card: card,
					issueID: issueID,
					targets: targetKeysFromValue(card.dataset.kanbanAllowedTargets || ""),
					rect: card.getBoundingClientRect(),
					startX: event.clientX,
					startY: event.clientY,
					lastX: event.clientX,
					lastY: event.clientY,
					startedAt: Date.now(),
					longPressTimer: null
				};
				if (event.pointerType === "touch") {
					var pointerId = event.pointerId;
					pending.longPressTimer = window.setTimeout(function () {
						if (!pending || pending.pointerId !== pointerId) return;
						beginDrag({ clientX: pending.lastX, clientY: pending.lastY });
					}, TOUCH_LONG_PRESS_MS);
				}
			});
			document.addEventListener("touchstart", function (event) {
				if (active || !event.changedTouches || event.changedTouches.length === 0) return;
				var touch = event.changedTouches[0];
				recentTouchStart = {
					identifier: touch.identifier,
					target: event.target,
					startedAt: Date.now()
				};
				if (pending && pending.pointerType === "touch" && event.target instanceof Node && pending.card.contains(event.target)) {
					pending.touchIdentifier = touch.identifier;
				}
			});
			document.addEventListener("pointermove", function (event) {
				if (pending && event.pointerId === pending.pointerId) {
					if (pending.pointerType === "touch") {
						if (Math.hypot(event.clientX - pending.startX, event.clientY - pending.startY) >= TOUCH_MOVE_TOLERANCE_PX) {
							clearPending();
							return;
						}
						pending.lastX = event.clientX;
						pending.lastY = event.clientY;
						return;
					}
					// A missed pointerup (released outside the window) must not
					// leave a stale press that turns a later hover into a drag.
					if (event.buttons === 0) {
						clearPending();
						return;
					}
					if (Math.hypot(event.clientX - pending.startX, event.clientY - pending.startY) < DRAG_THRESHOLD_PX) return;
					beginDrag(event);
					return;
				}
				if (!active || event.pointerId !== active.pointerId) return;
				if (active.pointerType !== "touch" && event.buttons === 0) {
					// The release happened outside the window, so no click is
					// coming — cancelling must not arm the click suppressor or
					// it would eat the next real click after recovery.
					cancelDrag(true);
					return;
				}
				event.preventDefault();
				moveDragTo(event.clientX, event.clientY);
			}, { passive: false });
			function dropAt(x, y) {
				if (!active) return;
				if (!connectionAllowsMoves()) {
					cancelDrag();
					feedback("Move cancelled because the board connection was lost.", "error");
					return;
				}
				var lane = laneFromPoint(x, y);
				var card = draggedCard(document);
				if (!(lane instanceof HTMLElement)) {
					cancelDrag();
					return;
				}
				if (lane.dataset.kanbanDropSource === "true") {
					if (Date.now() - active.startedAt < CLICK_GESTURE_MS) {
						finishDrag(true);
						feedback("");
						return;
					}
					cancelDrag();
					return;
				}
				if (!laneAllowed(card, lane)) {
					finishDrag();
					feedback("Move blocked by transition policy.", "error");
					return;
				}
				var form = card ? card.querySelector("[data-kanban-drag-move-form]") : null;
				var targetState = form ? form.querySelector("[data-kanban-drag-target-state]") : null;
				if (!(form instanceof HTMLFormElement) || !(targetState instanceof HTMLInputElement)) {
					cancelDrag();
					return;
				}
				targetState.value = lane.dataset.kanbanDropState || "";
				card.dataset.kanbanPendingMove = targetState.value;
				card.dataset.kanbanPendingOrigin = card.dataset.kanbanCurrentState || "";
				if (card.dataset.kanbanDataSeq) card.dataset.kanbanPendingSeq = card.dataset.kanbanDataSeq;
				card.dataset.kanbanPendingTargetWasHidden = lane.dataset.kanbanDropWasHidden || lane.dataset.laneHidden || "false";
				placeCardInLane(card, targetState.value, document);
				finishDrag();
				placeCardInLane(card, targetState.value, document);
				form.requestSubmit();
			}
			document.addEventListener("pointerup", function (event) {
				if (pending && event.pointerId === pending.pointerId) {
					clearPending();
					return;
				}
				if (!active || event.pointerId !== active.pointerId) return;
				dropAt(event.clientX, event.clientY);
			});
			document.addEventListener("pointercancel", function (event) {
				if (pending && event.pointerId === pending.pointerId) {
					clearPending();
					return;
				}
				if (active && event.pointerId === active.pointerId && active.pointerType !== "touch") cancelDrag();
			});
			document.addEventListener("touchmove", function (event) {
				if (!active || active.pointerType !== "touch") return;
				event.preventDefault();
				var touch = touchWithIdentifier(event.touches, active.touchIdentifier);
				if (!touch && active.touchIdentifier === null && event.touches && event.touches.length === 1) touch = event.touches[0];
				if (touch) moveDragTo(touch.clientX, touch.clientY);
			}, { passive: false });
			document.addEventListener("touchend", function (event) {
				if (pending && pending.pointerType === "touch") {
					var pendingTouch = touchWithIdentifier(event.changedTouches, pending.touchIdentifier);
					if (!pendingTouch && !(pending.touchIdentifier === null && event.touches && event.touches.length === 0)) return;
					clearPending();
					return;
				}
				if (!active || active.pointerType !== "touch") return;
				var touch = touchWithIdentifier(event.changedTouches, active.touchIdentifier);
				if (!touch && active.touchIdentifier === null && event.touches && event.touches.length === 0) touch = event.changedTouches && event.changedTouches[0];
				if (touch) dropAt(touch.clientX, touch.clientY);
			});
			document.addEventListener("touchcancel", function (event) {
				if (pending && pending.pointerType === "touch") {
					var pendingTouch = touchWithIdentifier(event.changedTouches, pending.touchIdentifier);
					if (!pendingTouch && !(pending.touchIdentifier === null && event.touches && event.touches.length === 0)) return;
					clearPending();
					return;
				}
				if (!active || active.pointerType !== "touch") return;
				var touch = touchWithIdentifier(event.changedTouches, active.touchIdentifier);
				if (touch || (active.touchIdentifier === null && event.touches && event.touches.length === 0)) cancelDrag();
			});
			document.addEventListener("contextmenu", function (event) {
				var touchPress = pending && pending.pointerType === "touch";
				var touchDrag = active && active.pointerType === "touch";
				if ((touchPress || touchDrag) && event.target instanceof Element && event.target.closest("[data-kanban-card]")) {
					event.preventDefault();
				}
			});
			document.addEventListener("keydown", function (event) {
				if (event.key === "Escape" && active) cancelDrag();
			});
			document.addEventListener("detent:connectionChange", function (event) {
				if (!event.detail || event.detail.state === "connected") return;
				if (active) cancelDrag();
				else clearPending();
			});
			window.addEventListener("blur", function () {
				if (active) cancelDrag();
			});
			// Native HTML5 drags stay disabled inside cards (links, images):
			// they would start a compositor drag session that steals the pointer.
			document.addEventListener("dragstart", function (event) {
				if (event.target instanceof Element && event.target.closest("[data-kanban-card]")) {
					event.preventDefault();
				}
			});
			document.addEventListener("htmx:afterSettle", function () {
				applyDragState(document);
			});
			function handleMoveError(event) {
				var form = event.detail && event.detail.elt;
				if (!(form instanceof HTMLFormElement) || !form.matches("[data-kanban-drag-move-form]")) return;
				var issueIDInput = form.querySelector("input[name='issue_id']");
				var issueID = issueIDInput instanceof HTMLInputElement ? issueIDInput.value : "";
				var card = form.closest("[data-kanban-card][data-kanban-pending-move]");
				if (!(card instanceof HTMLElement) || !card.isConnected) card = cardByIssueID(document, issueID);
				rollbackPendingMove(card);
				var response = event.detail.xhr ? event.detail.xhr.responseText : "";
				feedback(responseMessage(response) || "Move failed.", "error");
			}
			document.body.addEventListener("htmx:responseError", handleMoveError);
			document.body.addEventListener("htmx:sendError", handleMoveError);
			document.body.addEventListener("htmx:timeout", handleMoveError);
		})();
	</script>
}

// boardScopeSelect is the topbar scope control: a CSS-only dropdown living
// outside #snapshot linking to each project's board.
templ boardScopeSelect(data DashboardData) {
	<details class="group/scope relative min-w-0">
		<summary class="flex min-w-0 cursor-pointer list-none items-center gap-1.5 rounded-card border border-line px-2.5 py-1 text-xs text-sec hover:text-text [&::-webkit-details-marker]:hidden">
			<span class="min-w-0 truncate">{ boardScopeLabel(data) }</span>
			<span aria-hidden="true">▾</span>
		</summary>
		<div class="absolute left-0 top-full z-40 mt-1 flex w-52 flex-col gap-0.5 rounded-card border border-line bg-elev p-1.5">
			<a href="/" class="rounded-chip px-2 py-1 text-xs text-text hover:bg-surface">All projects</a>
			for _, project := range appShellProjects(DashboardShellDataFromDashboard(data)) {
				<a href={ templ.SafeURL(project.Href) } class="truncate rounded-chip px-2 py-1 text-xs text-text hover:bg-surface">{ project.Name }</a>
			}
		</div>
	</details>
}
