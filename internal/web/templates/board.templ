				if (!root || !root.isConnected) return;
				window.cancelAnimationFrame(lanePositionFrame);
				lanePositionFrame = window.requestAnimationFrame(function () {
					updateLanePosition(document, root, "");
				});
			}
			function formatNumber(value) {
				return new Intl.NumberFormat("en-US").format(value);
			}
			function cardCountLabel(count, singular, plural) {
				return formatNumber(count) + " " + (count === 1 ? singular : plural);
			}
			function laneOverrideState(lane, prefs) {
				var id = laneID(lane);
				if (prefs.show.has(id)) return stateShow;
				if (prefs.hide.has(id)) return stateHide;
