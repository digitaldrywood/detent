				return queryRoot(scope).querySelector("[data-kanban-card][data-kanban-issue-id='" + CSS.escape(draggedIssueID) + "']");
			}
			function cardByIssueID(scope, issueID) {
				var cards = queryRoot(scope).querySelectorAll("[data-kanban-card][data-kanban-issue-id]");
				for (var index = 0; index < cards.length; index += 1) {
					if (cards[index].dataset.kanbanIssueId === issueID) return cards[index];
				}
				return null;
			}
			function laneByState(scope, state) {
				var lanes = queryRoot(scope).querySelectorAll("[data-kanban-drop-state]");
				for (var index = 0; index < lanes.length; index += 1) {
					if (lanes[index].dataset.kanbanDropState === state) return lanes[index];
				}
				return null;
			}
			function cardContainer(lane) {
				return lane instanceof HTMLElement ? lane.querySelector("[data-kanban-card-container]") : null;
			}
