				var hiddenPopulated = !visible && laneCardCount(lane) > 0;
				if (row instanceof HTMLElement) {
					row.dataset.boardLaneVisibilityState = state;
					row.dataset.boardLaneVisibilityEffective = visible ? "visible" : "hidden";
					row.dataset.boardLaneHiddenPopulated = hiddenPopulated ? "true" : "false";
					row.classList.toggle("border-warn/45", hiddenPopulated);
					row.classList.toggle("bg-warn/10", hiddenPopulated);
					row.classList.toggle("border-transparent", !hiddenPopulated);
					var status = row.querySelector("[data-board-lane-visibility-status]");
					if (status) {
						status.textContent = stateLabel(lane, state, visible);
						status.setAttribute("title", stateTitle(lane, state, visible));
					}
				}
				var select = findByData(scope, "data-board-lane-visibility", id);
				if (select instanceof HTMLSelectElement) {
					select.value = state;
					select.dataset.boardLaneVisibilityState = state;
					select.dataset.boardLaneVisibilityEffective = visible ? "visible" : "hidden";
					select.setAttribute("title", stateTitle(lane, state, visible));
				}
