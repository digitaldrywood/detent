				var target = event.target instanceof Element ? event.target : null;
				var select = target ? target.closest("[data-board-lane-visibility]") : null;
				if (!(select instanceof HTMLSelectElement)) return;
				var root = document.querySelector("[data-board-lanes]");
				if (!root) return;
				var state = select.value;
				if (state !== stateShow && state !== stateHide) state = stateAuto;
				setLaneState(root, select.getAttribute("data-board-lane-visibility") || "", state);
