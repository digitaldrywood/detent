package templates

import (
	"strconv"
	"strings"
	"time"

	"github.com/digitaldrywood/detent/internal/telemetry"
	"github.com/digitaldrywood/detent/internal/web/ui/components/button"
	"github.com/digitaldrywood/detent/internal/web/ui/components/dialog"
	"github.com/digitaldrywood/detent/internal/web/ui/components/icon"
	"github.com/digitaldrywood/detent/internal/web/ui/components/sheet"
	"github.com/digitaldrywood/detent/internal/web/ui/components/sidebar"
	"github.com/digitaldrywood/detent/internal/web/ui/primitives"
)

templ HealthPage(data DashboardData) {
	@DashboardShell(HealthShellDataFromDashboard(data)) {
		<div class="mx-auto grid w-full max-w-7xl content-start gap-4 sm:gap-5">
			<header class="dashboard-topbar min-w-0 border-b border-line py-2">
				<div class="flex min-w-0 flex-wrap items-center gap-x-5 gap-y-2">
					@dashboardMobileSidebarTrigger()
					<div class="min-w-0">
						<h1 class="truncate text-sm font-semibold text-text">Health</h1>
					</div>
					<div class="dashboard-topbar-actions ml-auto flex min-w-0 flex-wrap items-center justify-end gap-x-2 gap-y-1 text-xs text-sec">
						<span class="truncate font-mono">{ dashboardBuildVersionLabel(data) }</span>
						@dashboardTopbarDivider()
						<span class="truncate">{ connectorName(data) }</span>
						@dashboardTopbarDivider()
						<span id="live-tick" class="sse-tick min-w-0 truncate font-mono" sse-swap="tick" hx-swap="innerHTML settle:120ms">{ generatedAtLabel(data.Snapshot) }</span>
					</div>
				</div>
			</header>
			<div id="snapshot" class="sse-surface grid min-w-0 gap-4 sm:gap-5" sse-swap="snapshot" hx-swap="morph:innerHTML">
				@HealthSnapshot(data)
			</div>
		</div>
	}
}

templ AnalyticsPage(data DashboardData) {
	@DashboardShell(AnalyticsShellDataFromDashboard(data)) {
		<div class="mx-auto grid w-full max-w-7xl content-start gap-4 sm:gap-5">
			<header class="dashboard-topbar min-w-0 border-b border-line py-2">
				<div class="flex min-w-0 flex-wrap items-center gap-x-5 gap-y-2">
					@dashboardMobileSidebarTrigger()
					<div class="min-w-0">
						<h1 class="truncate text-sm font-semibold text-text">Analytics</h1>
					</div>
					<div class="dashboard-topbar-actions ml-auto flex min-w-0 flex-wrap items-center justify-end gap-x-2 gap-y-1 text-xs text-sec">
						<span class="truncate font-mono">{ dashboardBuildVersionLabel(data) }</span>
						@dashboardTopbarDivider()
						<span class="truncate">{ connectorName(data) }</span>
						@dashboardTopbarDivider()
						<span id="live-tick" class="sse-tick min-w-0 truncate font-mono" sse-swap="tick" hx-swap="innerHTML settle:120ms">{ generatedAtLabel(data.Snapshot) }</span>
					</div>
				</div>
			</header>
			<div id="snapshot" class="sse-surface grid min-w-0 gap-4 sm:gap-5" sse-swap="snapshot" hx-swap="morph:innerHTML">
				@AnalyticsSnapshot(data)
			</div>
		</div>
	}
}

templ ProjectDiagnosticsPage(data DashboardData) {
	@DashboardShell(ProjectDiagnosticsShellDataFromDashboard(data)) {
		<div class="mx-auto grid w-full max-w-7xl content-start gap-4 sm:gap-5">
			@projectDetailHeader(data, "Diagnostics")
			<div id="snapshot" class="sse-surface grid min-w-0 gap-4 sm:gap-5" sse-swap="snapshot" hx-swap="morph:innerHTML">
				@ProjectDiagnosticsSnapshot(data)
			</div>
			@diagnosticsTabsScript()
			@dashboardCharts(data)
		</div>
	}
}

templ projectDetailHeader(data DashboardData, title string) {
	<header class="dashboard-topbar min-w-0 border-b border-line py-2">
		<div class="flex min-w-0 flex-wrap items-center gap-x-5 gap-y-2">
			@dashboardMobileSidebarTrigger()
			<div class="min-w-0">
				<h1 class="truncate text-sm font-semibold text-text">{ projectDisplayName(data) } / { title }</h1>
			</div>
			<div class="dashboard-topbar-actions ml-auto flex min-w-0 flex-wrap items-center justify-end gap-x-2 gap-y-1 text-xs text-sec">
				if projectExternalURL(data) != "" {
					<a class="inline-flex size-8 shrink-0 items-center justify-center rounded-md border border-line bg-surface text-sec hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" href={ projectExternalURL(data) } target="_blank" rel="noopener noreferrer" title={ projectExternalLinkLabel(data) } aria-label={ projectExternalLinkLabel(data) }>
						@icon.ExternalLink(icon.Props{Class: "size-4"})
					</a>
				}
				<span class="truncate font-mono">{ dashboardBuildVersionLabel(data) }</span>
				@dashboardTopbarDivider()
				<span class="truncate">{ connectorName(data) }</span>
				@dashboardTopbarDivider()
				<span id="live-tick" class="sse-tick min-w-0 truncate font-mono" sse-swap="tick" hx-swap="innerHTML settle:120ms">{ generatedAtLabel(data.Snapshot) }</span>
			</div>
		</div>
	</header>
}

templ DashboardShell(data DashboardShellData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="application-name" content={ applicationName(data.ApplicationName) }/>
			<title>{ pageTitle(data) }</title>
			<script>
				document.documentElement.classList.toggle("dark", Boolean(window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches))
			</script>
			@helpScript()
			<link rel="icon" type="image/svg+xml" href={ faviconPath(data.Assets) }/>
			<link rel="stylesheet" href={ stylesheetPath(data.Assets) }/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script src="https://cdn.jsdelivr.net/npm/htmx-ext-sse@2.2.4"></script>
			<script src="https://cdn.jsdelivr.net/npm/idiomorph@0.7.3/dist/idiomorph-ext.min.js"></script>
			@localTimeScript()
			@dashboardSSEMetricsScript()
			if data.IncludeDashboardCharts {
				<script src={ chartJSPath(data.Assets) } defer></script>
				<script src={ dashboardChartsScriptPath(data.Assets) } defer></script>
			}
			@sidebar.Script()
			@dialog.Script()
		</head>
		<body class="min-h-screen overflow-x-hidden bg-page text-text antialiased">
			@helpTooltipHost()
			@kanbanDialogHost()
			@sidebar.Layout(sidebar.LayoutProps{
				Class: "dashboard-shell min-h-screen w-full bg-page",
				Attributes: templ.Attributes{
					"hx-ext":      "sse, morph",
					"sse-connect": eventsPath(data),
				},
			}) {
				@dashboardSidebar(data)
				@sidebar.Inset(sidebar.InsetProps{Class: "dashboard-main min-w-0 px-3 py-3 sm:px-6 lg:px-8"}) {
					@dashboardLiveUpdateWarning()
					{ children... }
				}
			}
		</body>
	</html>
}

templ dashboardLiveUpdateWarning() {
	<div id="detent-sse-warning" class="mb-3 hidden rounded-md border border-warn/15 bg-warn/15 px-3 py-2 text-sm text-warn shadow-sm" role="status" aria-live="polite" data-detent-sse-warning hidden>
		<div class="flex min-w-0 items-start gap-3">
			@icon.CircleAlert(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-warn"})
			<div class="grid min-w-0 gap-1">
				<p class="font-medium text-warn">Live updates delayed</p>
				<p class="text-xs text-warn" data-detent-sse-warning-message>Snapshot events are queued but the page has not settled.</p>
				<p class="break-words font-mono text-[11px] text-warn" data-detent-sse-warning-metrics></p>
			</div>
		</div>
	</div>
}

templ dashboardPageHeading(title string) {
	<h1 class="sr-only">{ title }</h1>
}

templ dashboardTopbarDivider() {
	<span aria-hidden="true">/</span>
}

templ GitHubAPIHealthSidebarItem(data DashboardShellData) {
	<div class="min-w-0" { gitHubAPIHealthSidebarTargetAttributes(data)... }>
		@sidebar.MenuButton(sidebar.MenuButtonProps{
			Href:       sidebarHealthPath(data),
			IsActive:   sidebarStaticNavActive(data, "health"),
			Tooltip:    "Health",
			Class:      "relative",
			Attributes: gitHubAPIHealthSidebarLinkAttributes(data),
		}) {
			@icon.Activity(icon.Props{Class: "size-4 shrink-0"})
			<span class={ "size-2.5 shrink-0 rounded-full group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:absolute group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:right-1 group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:top-1 group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:size-2 group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:ring-2 group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:ring-line " + gitHubAPIHealthDotClass(data.Snapshot) } aria-hidden="true"></span>
			<span class="min-w-0 flex-1 truncate group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden">Health</span>
			@sidebar.MenuBadge(sidebar.MenuBadgeProps{
				Class: "border " + gitHubAPIHealthBadgeClass(data.Snapshot),
			}) {
				{ gitHubAPIHealthStateLabel(data.Snapshot) }
			}
		}
	</div>
}

templ HealthSnapshot(data DashboardData) {
	<section id="health-dashboard" class="grid min-w-0 gap-4 sm:gap-5" aria-label="Health dashboard">
		@failureBreakerBanner(data.Snapshot)
		@dispatchRecoveryBanner(data.Snapshot)
		@backendCapacityBanner(data.Snapshot)
		@overloadRetriesBanner(data.Snapshot)
		@dashboardHealth(data)
		@GitHubAPIHealthDetails(data.Snapshot)
	</section>
}

templ failureBreakerBanner(snapshot telemetry.Snapshot) {
	if len(snapshot.FailureBreakers) > 0 {
		<section id="project-failure-breaker" class="flex min-w-0 items-start gap-3 rounded-md border border-warn/40 bg-warn/10 px-4 py-3 text-sm shadow-sm" role="status" aria-live="polite">
			@icon.CircleAlert(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-warn"})
			<div class="grid min-w-0 flex-1 gap-2">
				for _, breaker := range snapshot.FailureBreakers {
					<div class="flex min-w-0 flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
						<div class="min-w-0 break-words">
							<p class="font-medium text-text">Project dispatch paused by correlated failures</p>
							if strings.TrimSpace(breaker.ProjectID) != "" {
								<p class="mt-0.5 text-xs font-medium text-sec">{ "Project " + strings.TrimSpace(breaker.ProjectID) }</p>
							}
							{{ detail, resumeAt, showResumeAt := failureBreakerDetailParts(breaker, snapshot.GeneratedAt) }}
							<p class="mt-0.5 text-xs text-sec">
								{ detail }
								if showResumeAt {
									{ " " }
									@LocalTime(resumeAt, LocalTimeOptions{Relative: true})
								}
							</p>
						</div>
						if strings.TrimSpace(breaker.CanaryIssueID) == "" {
							<form hx-post="/api/v1/failure-breaker/canary" hx-swap="none" class="shrink-0">
								<input type="hidden" name="project_id" value={ breaker.ProjectID }/>
								<button type="submit" class="inline-flex min-h-8 items-center justify-center rounded-md border border-warn/50 bg-surface px-3 py-1.5 text-xs font-medium text-text transition-colors hover:bg-warn/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-warn/50">Run canary now</button>
							</form>
						}
					</div>
				}
			</div>
		</section>
	}
}

templ dispatchRecoveryBanner(snapshot telemetry.Snapshot) {
	if len(snapshot.DispatchRecoveries) > 0 {
		<section id="dispatch-recovery-status" class="flex min-w-0 items-start gap-3 rounded-md border border-accent/40 bg-accent/10 px-4 py-3 text-sm shadow-sm" role="status" aria-live="polite">
			@icon.Activity(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-accent"})
			<div class="grid min-w-0 gap-2">
				for _, recovery := range snapshot.DispatchRecoveries {
					<div class="min-w-0 break-words">
						<p class="font-medium text-text">{ dispatchRecoveryTitle(recovery) }</p>
						if strings.TrimSpace(recovery.ProjectID) != "" {
							<p class="mt-0.5 text-xs font-medium text-sec">{ "Project " + strings.TrimSpace(recovery.ProjectID) }</p>
						}
						{{ detail, resumeAt, showResumeAt := dispatchRecoveryDetailParts(recovery, snapshot.GeneratedAt) }}
						<p class="mt-0.5 text-xs text-sec">
							{ detail }
							if showResumeAt {
								{ " " }
								@LocalTime(resumeAt, LocalTimeOptions{Relative: true})
							}
						</p>
					</div>
				}
			</div>
		</section>
	}
}

templ backendCapacityBanner(snapshot telemetry.Snapshot) {
	{{ outages := backendCapacityOutageDetails(snapshot.BackendOutages) }}
	if len(outages) > 0 {
		<section id="backend-capacity-outage" class="flex min-w-0 items-start gap-3 rounded-md border border-warn/40 bg-warn/10 px-4 py-3 text-sm shadow-sm" role="status" aria-live="polite">
			@icon.CircleAlert(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-warn"})
			<div class="grid min-w-0 flex-1 gap-2">
				for _, outage := range outages {
					<div class="flex min-w-0 flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
						<div class="min-w-0 break-words">
							<p class="font-medium text-text">{ backendCapacityOutageTitle(outage) }</p>
							if strings.TrimSpace(outage.ProjectID) != "" {
								<p class="mt-0.5 text-xs font-medium text-sec">{ "Project " + strings.TrimSpace(outage.ProjectID) }</p>
							}
							{{ detail, detailAt, showDetailAt := backendCapacityOutageDetailParts(outage, snapshot.GeneratedAt) }}
							<p class="mt-0.5 text-xs text-sec">
								{ detail }
								if showDetailAt {
									{ " " }
									@LocalTime(detailAt, LocalTimeOptions{Relative: true})
								}
							</p>
							if strings.TrimSpace(outage.Kind) != "github_rest_rate_limit" && !outage.ResumeAt.IsZero() {
								<p class="mt-0.5 text-xs text-sec">
									{ "Provider-recorded resume at " }
									@LocalTime(outage.ResumeAt, LocalTimeOptions{Relative: true})
								</p>
							}
							if outage.LastProbeAt != nil {
								<p class="mt-0.5 text-xs text-sec">
									{ "Last probe " }
									@LocalTime(*outage.LastProbeAt, LocalTimeOptions{Relative: true})
									{ ": " + backendCapacityProbeResult(outage) }
									if outage.LastProbeDetail != "" {
										<span>{ " — " + outage.LastProbeDetail }</span>
									}
								</p>
							}
						</div>
						if strings.TrimSpace(outage.Kind) != "github_rest_rate_limit" {
							<form hx-post="/api/v1/capacity/clear" hx-swap="none" class="shrink-0">
								<input type="hidden" name="project_id" value={ outage.ProjectID }/>
								<input type="hidden" name="scope" value={ outage.BackendID }/>
								<button type="submit" class="inline-flex min-h-8 items-center justify-center rounded-md border border-warn/50 bg-surface px-3 py-1.5 text-xs font-medium text-text transition-colors hover:bg-warn/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-warn/50">Clear outage</button>
							</form>
						}
					</div>
				}
			</div>
		</section>
	}
}

templ overloadRetriesBanner(snapshot telemetry.Snapshot) {
	if snapshot.OverloadRetriesLastHour > 0 {
		<section id="backend-overload-retries" class="flex min-w-0 items-start gap-3 rounded-md border border-line bg-surface px-4 py-3 text-sm shadow-sm" role="status" aria-live="polite">
			@icon.Activity(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-accent"})
			<div class="min-w-0">
				<p class="font-medium text-text">{ formatCount(snapshot.OverloadRetriesLastHour) + " overload retries last hour" }</p>
				<p class="mt-0.5 text-xs text-sec">Provider overloads retry only the affected work; dispatch remains active.</p>
			</div>
		</section>
	}
}

templ AnalyticsSnapshot(data DashboardData) {
	if !snapshotReady(data.Snapshot) {
		@snapshotReadiness(data.Snapshot)
	} else {
		<section id="fleet-analytics" class="dashboard-analytics grid min-w-0 gap-4 lg:gap-5" aria-label="Analytics">
			@boardHealthSection(data.Snapshot)
			@schedulerRuntimeSection(data.Snapshot)
			@workflowMetricsSection(data.Snapshot.WorkflowMetrics, data.Snapshot.Project)
			@cycleTimeSection(data.Snapshot.CycleTime)
			@budgetCard(data.Snapshot)
		</section>
	}
}

templ GitHubAPIHealthDetails(snapshot telemetry.Snapshot) {
	<section class="grid min-w-0 gap-4" aria-label="GitHub API health details">
		<div class="flex flex-col gap-3 border-b border-line pb-3 sm:flex-row sm:items-start sm:justify-between">
			<div class="min-w-0">
				<div class="flex min-w-0 items-center gap-2">
					<span class={ "h-2.5 w-2.5 shrink-0 rounded-full " + gitHubAPIHealthDotClass(snapshot) } aria-hidden="true"></span>
					<h2 class="truncate text-base font-semibold text-text">{ gitHubAPIHealth(snapshot).Label }</h2>
				</div>
				<p class="mt-1 max-w-3xl text-sm text-sec">{ gitHubAPIHealth(snapshot).Detail }</p>
			</div>
			<span class={ "inline-flex min-h-8 shrink-0 items-center rounded-md border px-2.5 py-1 text-xs font-medium " + gitHubAPIHealthBadgeClass(snapshot) }>
				{ gitHubAPIHealthStateLabel(snapshot) }
			</span>
		</div>
		<div class="grid min-w-0 gap-3 md:grid-cols-2 xl:grid-cols-4">
			@healthFactCard("Aggregate status", gitHubAPIHealth(snapshot).Label, gitHubAPIHealth(snapshot).Summary, gitHubAPIHealthDotClass(snapshot))
			@healthFactCard("Backoff state", gitHubAPIHealthBackoffLabel(snapshot), gitHubAPIHealthBackoffDetail(snapshot), gitHubAPIHealthDotClass(snapshot))
			@healthFactCard("Primary quota", gitHubAPIHealthPrimaryQuotaLabel(snapshot), gitHubAPIHealthPrimaryQuotaDetail(snapshot), "bg-accent")
			@healthFactCard("Retry timing", gitHubAPIHealthRetryLabel(snapshot), gitHubAPIHealthRetryDetail(snapshot), "bg-warn")
		</div>
		<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5" aria-label="GitHub primary quota details">
			<div class="flex min-w-0 items-start justify-between gap-3">
				<div class="min-w-0">
					<h3 class="text-sm font-semibold text-text">Primary quota</h3>
					<p class="text-sm text-sec">REST and GraphQL primary buckets, including quota usage and reset timing.</p>
				</div>
				<span class="shrink-0 rounded-md bg-elev px-2 py-1 font-mono text-xs text-sec">{ formatInt(int64(len(gitHubAPIHealth(snapshot).Buckets))) }</span>
			</div>
			if len(gitHubAPIHealth(snapshot).Buckets) == 0 {
				<div class="mt-4">
					@dashboardEmptyState("No GitHub primary budget snapshot.", "REST and GraphQL primary buckets will appear after the tracker reports them.", "bg-dim")
				</div>
			} else {
				<div class="mt-4 grid min-w-0 gap-3 md:grid-cols-2">
					for _, bucket := range gitHubAPIHealth(snapshot).Buckets {
						<div class="grid min-w-0 gap-3 rounded-md border border-line bg-elev/40 p-3">
							<div class="flex min-w-0 items-center justify-between gap-3">
								<span class="truncate text-sm font-medium text-text">{ bucket.Name }</span>
								<span class="shrink-0 font-mono text-xs text-sec">{ bucket.Reset }</span>
							</div>
							<div class="grid min-w-0 gap-2 text-xs text-sec sm:grid-cols-3">
								<span class="min-w-0 truncate font-mono" title={ bucket.Remaining }>{ bucket.Remaining }</span>
								<span class="min-w-0 truncate font-mono" title={ bucket.Used }>{ bucket.Used }</span>
								<span class="min-w-0 truncate font-mono" title={ bucket.Limit }>{ bucket.Limit }</span>
							</div>
						</div>
					}
				</div>
			}
		</section>
		<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5" aria-label="GitHub endpoint backoff details">
			<div class="flex min-w-0 items-start justify-between gap-3">
				<div class="min-w-0">
					<h3 class="text-sm font-semibold text-text">Affected endpoints</h3>
					<p class="text-sm text-sec">Endpoint families currently paused by secondary REST throttling.</p>
				</div>
				<span class="shrink-0 rounded-md bg-elev px-2 py-1 font-mono text-xs text-sec">{ formatInt(int64(len(gitHubAPIHealth(snapshot).Endpoints))) }</span>
			</div>
			if len(gitHubAPIHealth(snapshot).Endpoints) == 0 {
				<div class="mt-4">
					@dashboardEmptyState("No endpoint backoff active.", "Secondary REST throttling will list paused endpoint families here.", "bg-ok")
				</div>
			} else {
				<div class="mt-4 overflow-x-auto" data-preserve-scroll="github-api-endpoints">
					<table class="dashboard-table w-full min-w-[46rem] table-fixed border-collapse text-sm">
						<thead class="bg-elev/70">
							<tr class="border-b border-line text-left text-xs font-medium uppercase text-sec">
								<th class="w-[14rem] px-3 py-3 font-medium">Endpoint</th>
								<th class="w-[7rem] px-3 py-3 font-medium">Status</th>
								<th class="w-[9rem] px-3 py-3 font-medium">Count</th>
								<th class="w-[10rem] px-3 py-3 font-medium">Remaining</th>
								<th class="w-[9rem] px-3 py-3 font-medium">Retry-after</th>
								<th class="px-3 py-3 font-medium">Retry</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for _, endpoint := range gitHubAPIHealth(snapshot).Endpoints {
								<tr>
									<td class="truncate px-3 py-3 font-medium text-text" title={ endpoint.EndpointFamily }>{ endpoint.EndpointFamily }</td>
									<td class="px-3 py-3 font-mono text-sec">{ endpoint.Status }</td>
									<td class="px-3 py-3 font-mono text-sec">{ endpoint.Count }</td>
									<td class="px-3 py-3 font-mono text-sec">{ endpoint.Remaining }</td>
									<td class="px-3 py-3 font-mono text-sec">{ endpoint.RetryAfter }</td>
									<td class="px-3 py-3 font-mono text-sec">{ endpoint.Retry }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5" aria-label="GitHub refresh timing">
			<div class="flex min-w-0 items-start justify-between gap-3">
				<div class="min-w-0">
					<h3 class="text-sm font-semibold text-text">Refresh timing</h3>
					<p class="text-sm text-sec">Tracker refresh state and manual refresh feedback.</p>
				</div>
				if manualRefreshVisible(snapshot) {
					<form class="shrink-0" hx-post="/api/v1/refresh" hx-target="#github-api-manual-refresh-status" hx-swap="outerHTML">
						<input type="hidden" name="manual_refresh_status_id" value="github-api-manual-refresh-status"/>
						@button.Button(button.Props{
							Type:    button.TypeSubmit,
							Variant: button.VariantOutline,
							Size:    button.SizeSm,
							Class:   "border-warn bg-surface text-warn hover:border-accent hover:text-accent",
							Attributes: templ.Attributes{
								"aria-label": "Force tracker refresh",
							},
						}) {
							@icon.RefreshCw(icon.Props{Class: "size-3.5 shrink-0"})
							<span>Force refresh</span>
						}
					</form>
				}
			</div>
			<div class="mt-4 grid min-w-0 gap-3 md:grid-cols-2">
				for _, row := range gitHubAPIHealth(snapshot).Refreshes {
					<div class="grid min-w-0 gap-1 rounded-md border border-line bg-elev/40 p-3">
						<span class="truncate text-xs font-medium uppercase text-sec">{ row.Label }</span>
						<span class="min-w-0 break-words font-mono text-sm text-text">{ row.Value }</span>
					</div>
				}
			</div>
			if manualRefreshVisible(snapshot) {
				<div class="mt-3">
					@ManualRefreshFeedbackWithID("github-api-manual-refresh-status", snapshot.Refresh.Manual)
				</div>
			}
		</section>
	</section>
}

templ healthFactCard(label string, value string, detail string, dotClass string) {
	<article class="min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm">
		<div class="flex min-w-0 items-center justify-between gap-3">
			<span class="truncate text-xs font-medium uppercase text-sec">{ label }</span>
			<span class={ "h-2.5 w-2.5 shrink-0 rounded-full " + dotClass } aria-hidden="true"></span>
		</div>
		<div class="mt-2 min-w-0 break-words text-sm font-semibold text-text">{ value }</div>
		<p class="mt-1 line-clamp-3 text-xs text-sec">{ detail }</p>
	</article>
}

templ kanbanDialogHost() {
	<div id="kanban-dialog-host">
		@dialog.Dialog(dialog.Props{ID: kanbanActionDialogID}) {
			@dialog.Content(dialog.ContentProps{Class: "max-w-lg"}) {
				<div id={ kanbanDialogContentID } class="grid gap-4"></div>
			}
		}
	</div>
}

templ dashboardMobileSidebarTrigger() {
	@sheet.Trigger(sheet.TriggerProps{For: "dashboard-sidebar-mobile", Class: "md:hidden shrink-0"}) {
		@button.Button(button.Props{
			Size:    button.SizeIcon,
			Variant: button.VariantGhost,
			Class:   "size-8 text-text hover:bg-elev focus-visible:ring-accent",
		}) {
			@icon.PanelLeft(icon.Props{Class: "size-4"})
			<span class="sr-only">Toggle Sidebar</span>
		}
	}
}

templ dashboardSSEMetricsScript() {
	<script>
			(function() {
				const reportEvery = 60000;
				const processingTimeout = 2500;
				const stallWarningAfter = 1200;
				const state = {
					events: {},
					pending: {},
					processing: {},
					reportTimer: 0,
					warningKey: "",
				};
				const encoder = window.TextEncoder ? new TextEncoder() : null;

				function metricsFor(name) {
					if (!state.events[name]) {
						state.events[name] = {
							received: 0,
							bytes: 0,
							swaps: 0,
							totalMs: 0,
							maxMs: 0,
							skipped: 0,
							queued: 0,
							replayed: 0,
							timeouts: 0,
							prevented: 0,
							swapErrors: 0,
							lastReceivedAt: "",
							lastQueuedAt: "",
							lastReplayAt: "",
							lastSwapAt: "",
						};
					}
					return state.events[name];
				}

				function timestamp() {
					return new Date().toISOString();
				}

				function byteLength(value) {
					const text = String(value || "");
					if (!text) {
						return 0;
					}
					return encoder ? encoder.encode(text).length : text.length;
				}

				function eventName(event) {
					const detail = event.detail || {};
					const message = detail.message || detail.event || {};
					return String(detail.type || detail.name || message.type || "message");
				}

				function eventPayload(event) {
					const detail = event.detail || {};
					const message = detail.message || detail.event || {};
					return message.data || detail.data || "";
				}

				function pendingKey(target, name) {
					if (target && target.id) {
						return target.id;
					}
					if (target && target.getAttribute) {
						return target.getAttribute("sse-swap") || name || "message";
					}
					return name || "message";
				}

				function pendingCount(name) {
					let count = 0;
					Object.keys(state.pending).forEach(function(key) {
						if (state.pending[key].name === name) {
							count += 1;
						}
					});
					return count;
				}

				function processingCount(name) {
					let count = 0;
					Object.keys(state.processing).forEach(function(key) {
						if (state.processing[key].name === name) {
							count += 1;
						}
					});
					return count;
				}

				function parseDelay(value) {
					if (window.htmx && typeof window.htmx.parseInterval === "function") {
						return window.htmx.parseInterval(value);
					}
					if (value.slice(-2) === "ms") {
						return Number(value.slice(0, -2)) || 0;
					}
					if (value.slice(-1) === "s") {
						return (Number(value.slice(0, -1)) || 0) * 1000;
					}
					return Number(value) || 0;
				}

				function swapSpecFor(target) {
					const spec = { swapStyle: "innerHTML" };
					const raw = String(target.getAttribute("hx-swap") || "").trim();
					if (!raw) {
						return spec;
					}
					const modifierNames = {
						swap: true,
						settle: true,
						transition: true,
						ignoreTitle: true,
						scroll: true,
						show: true,
						focusScroll: true,
						"focus-scroll": true,
					};
					raw.split(/\s+/).forEach(function(token, index) {
						const separator = token.indexOf(":");
						const name = separator >= 0 ? token.slice(0, separator) : token;
						const value = separator >= 0 ? token.slice(separator + 1) : "";
						if (index === 0 && !modifierNames[name]) {
							spec.swapStyle = token;
							return;
						}
						if (name === "swap") {
							spec.swapDelay = parseDelay(value);
						} else if (name === "settle") {
							spec.settleDelay = parseDelay(value);
						} else if (name === "transition") {
							spec.transition = value === "true";
						} else if (name === "ignoreTitle") {
							spec.ignoreTitle = value === "true";
						}
					});
					return spec;
				}

				function targetForEventName(name) {
					const targets = document.querySelectorAll("[sse-swap]");
					for (const target of targets) {
						if (target.getAttribute("sse-swap") === name) {
							return target;
						}
					}
					return null;
				}

				function swapTarget(event) {
					const detailTarget = event.detail && event.detail.target;
					const target = detailTarget instanceof Element ? detailTarget : event.target;
					if (!(target instanceof Element)) {
						return null;
					}
					if (target.hasAttribute("sse-swap")) {
						return target;
					}
					return target.closest("[sse-swap]");
				}

				function targetForProcessing(processing) {
					if (!processing) {
						return null;
					}
					if (processing.targetID) {
						const target = document.getElementById(processing.targetID);
						if (target) {
							return target;
						}
					}
					return targetForEventName(processing.sseSwap || processing.name);
				}

				function clearTargetProcessingDataset(target, key) {
					if (!(target instanceof HTMLElement)) {
						return;
					}
					if (key && target.dataset.detentSseKey && target.dataset.detentSseKey !== key) {
						return;
					}
					delete target.dataset.detentSseProcessing;
					delete target.dataset.detentSseEvent;
					delete target.dataset.detentSseStarted;
					delete target.dataset.detentSseTimer;
					delete target.dataset.detentSseKey;
				}

				function clearProcessingKey(key) {
					const processing = state.processing[key];
					if (!processing) {
						return;
					}
					if (processing.timer) {
						window.clearTimeout(processing.timer);
					}
					if (processing.warningTimer) {
						window.clearTimeout(processing.warningTimer);
					}
					clearTargetProcessingDataset(targetForProcessing(processing), key);
					delete state.processing[key];
					if (state.warningKey === key && !state.pending[key]) {
						state.warningKey = "";
					}
					updateWarning();
				}

				function markProcessing(target, name) {
					if (!(target instanceof Element)) {
						return "";
					}
					const key = pendingKey(target, name);
					clearProcessingKey(key);
					const started = performance.now();
					const processing = {
						name: name,
						targetID: target.id || "",
						sseSwap: target.getAttribute("sse-swap") || name,
						started: started,
						timer: 0,
						warningTimer: 0,
					};
					processing.warningTimer = window.setTimeout(function() {
						if (state.processing[key]) {
							state.warningKey = key;
							updateWarning();
							scheduleReport();
						}
					}, stallWarningAfter);
					processing.timer = window.setTimeout(function() {
						if (!state.processing[key]) {
							return;
						}
						metricsFor(processing.name).timeouts += 1;
						state.warningKey = key;
						clearProcessingKey(key);
						replayPendingKey(key);
						scheduleReport();
					}, processingTimeout);
					state.processing[key] = processing;
					if (target instanceof HTMLElement) {
						target.dataset.detentSseProcessing = "true";
						target.dataset.detentSseEvent = name;
						target.dataset.detentSseStarted = String(started);
						target.dataset.detentSseTimer = String(processing.timer);
						target.dataset.detentSseKey = key;
					}
					updateWarning();
					return key;
				}

				function rememberPending(target, name, payload) {
					const key = pendingKey(target, name);
					state.pending[key] = {
						name: name,
						payload: payload,
						targetID: target.id || "",
						sseSwap: target.getAttribute("sse-swap") || name,
						swapSpec: swapSpecFor(target),
						queuedAt: performance.now(),
					};
					const metrics = metricsFor(name);
					metrics.queued += 1;
					metrics.lastQueuedAt = timestamp();
				}

				function targetForPending(pending) {
					if (pending.targetID) {
						const target = document.getElementById(pending.targetID);
						if (target) {
							return target;
						}
					}
					return targetForEventName(pending.sseSwap || pending.name);
				}

				function replayPending(target, name) {
					const key = pendingKey(target, name);
					replayPendingKey(key);
				}

				function replayPendingKey(key) {
					const pending = state.pending[key];
					if (!pending) {
						return;
					}
					delete state.pending[key];
					const nextTarget = targetForPending(pending);
					if (!(nextTarget instanceof Element) || !nextTarget.isConnected) {
						metricsFor(pending.name).swapErrors += 1;
						updateWarning();
						return;
					}
					const metrics = metricsFor(pending.name);
					metrics.replayed += 1;
					metrics.lastReplayAt = timestamp();
					markProcessing(nextTarget, pending.name);
					window.setTimeout(function() {
						if (!(nextTarget instanceof Element) || !nextTarget.isConnected) {
							metricsFor(pending.name).swapErrors += 1;
							clearProcessingKey(key);
							scheduleReport();
							return;
						}
						if (window.htmx && typeof window.htmx.swap === "function") {
							try {
								window.htmx.swap(nextTarget, pending.payload, pending.swapSpec, {
									contextElement: nextTarget,
									eventInfo: { target: nextTarget, source: nextTarget },
									afterSettleCallback: function() {
										const settledTarget = targetForPending(pending) || nextTarget;
										settleProcessing(settledTarget, pending.name);
									},
								});
								return;
							} catch (error) {
								metricsFor(pending.name).swapErrors += 1;
								if (window.console && console.warn) {
									console.warn("[detent] SSE replay swap failed", error);
								}
							}
						}
						nextTarget.innerHTML = pending.payload;
						settleProcessing(nextTarget, pending.name);
						scheduleReport();
					}, 0);
				}

				function settleProcessing(target, name) {
					if (!(target instanceof Element)) {
						return;
					}
					const key = pendingKey(target, name);
					const processing = state.processing[key];
					if (processing) {
						const duration = performance.now() - processing.started;
						const metrics = metricsFor(processing.name);
						metrics.swaps += 1;
						metrics.totalMs += duration;
						metrics.maxMs = Math.max(metrics.maxMs, duration);
						metrics.lastSwapAt = timestamp();
					}
					clearProcessingKey(key);
					replayPendingKey(key);
					scheduleReport();
				}

				function metricsSnapshot() {
					const snapshot = {};
					Object.keys(state.events).sort().forEach(function(name) {
						const metrics = state.events[name];
						const averageMs = metrics.swaps > 0 ? metrics.totalMs / metrics.swaps : 0;
						snapshot[name] = {
							received: metrics.received,
							bytes: metrics.bytes,
							swaps: metrics.swaps,
							averageMs: Math.round(averageMs * 10) / 10,
							maxMs: Math.round(metrics.maxMs * 10) / 10,
							skipped: metrics.skipped,
							queued: metrics.queued,
							replayed: metrics.replayed,
							timeouts: metrics.timeouts,
							prevented: metrics.prevented,
							swapErrors: metrics.swapErrors,
							pending: pendingCount(name),
							processing: processingCount(name),
							lastReceivedAt: metrics.lastReceivedAt,
							lastQueuedAt: metrics.lastQueuedAt,
							lastReplayAt: metrics.lastReplayAt,
							lastSwapAt: metrics.lastSwapAt,
						};
					});
					return snapshot;
				}

				function diagnosticsFor(name) {
					const metrics = metricsSnapshot()[name] || {};
					const status = document.documentElement.dataset.detentSseStatus || "unknown";
					return [
						"stream=" + status,
						"event=" + name,
						"received=" + (metrics.received || 0),
						"swaps=" + (metrics.swaps || 0),
						"queued=" + (metrics.queued || 0),
						"pending=" + (metrics.pending || 0),
						"processing=" + (metrics.processing || 0),
						"replayed=" + (metrics.replayed || 0),
						"timeouts=" + (metrics.timeouts || 0),
						"errors=" + (metrics.swapErrors || 0),
					].join(" ");
				}

				function updateWarning() {
					const warning = document.querySelector("[data-detent-sse-warning]");
					if (!(warning instanceof HTMLElement)) {
						return;
					}
					let key = state.warningKey;
					if (!key || (!state.processing[key] && !state.pending[key])) {
						key = "";
						const now = performance.now();
						Object.keys(state.processing).some(function(candidate) {
							const processing = state.processing[candidate];
							if (processing && now - processing.started >= stallWarningAfter) {
								key = candidate;
								return true;
							}
							return false;
						});
					}
					if (!key) {
						warning.hidden = true;
						warning.classList.add("hidden");
						state.warningKey = "";
						return;
					}
					state.warningKey = key;
					const pending = state.pending[key];
					const processing = state.processing[key];
					const name = (pending && pending.name) || (processing && processing.name) || "snapshot";
					const message = warning.querySelector("[data-detent-sse-warning-message]");
					const metrics = warning.querySelector("[data-detent-sse-warning-metrics]");
					if (message) {
						message.textContent = name + " events are queued or replaying, but the page has not settled yet.";
					}
					if (metrics) {
						metrics.textContent = diagnosticsFor(name);
					}
					warning.hidden = false;
					warning.classList.remove("hidden");
				}

				function scheduleReport() {
					if (state.reportTimer) {
						return;
					}
					state.reportTimer = window.setTimeout(report, reportEvery);
				}

				function report() {
					state.reportTimer = 0;
					const snapshot = metricsSnapshot();
					if (window.console && console.info) {
						console.info("[detent] SSE metrics", snapshot);
					}
					scheduleReport();
				}

				document.addEventListener("htmx:sseBeforeMessage", function(event) {
					const name = eventName(event);
					const metrics = metricsFor(name);
					const payload = eventPayload(event);
					metrics.received += 1;
					metrics.bytes += byteLength(payload);
					metrics.lastReceivedAt = timestamp();
					const target = swapTarget(event) || targetForEventName(name);
					if (!target) {
						scheduleReport();
						return;
					}
					const key = pendingKey(target, name);
					if (state.processing[key] && name !== "tick") {
						metrics.skipped += 1;
						rememberPending(target, name, payload);
						event.preventDefault();
						scheduleReport();
						updateWarning();
						return;
					}
					const processingKey = markProcessing(target, name);
					window.setTimeout(function() {
						if (event.defaultPrevented && state.processing[processingKey]) {
							metrics.prevented += 1;
							clearProcessingKey(processingKey);
							scheduleReport();
						}
					}, 0);
					scheduleReport();
				});

				document.addEventListener("htmx:beforeSwap", function(event) {
					const target = swapTarget(event);
					if (!target) {
						return;
					}
					markProcessing(target, target.dataset.detentSseEvent || target.getAttribute("sse-swap") || "message");
				});

				document.addEventListener("htmx:afterSettle", function(event) {
					const target = swapTarget(event);
					if (!target) {
						return;
					}
					const name = target.dataset.detentSseEvent || target.getAttribute("sse-swap") || "message";
					settleProcessing(target, name);
				});

				document.addEventListener("htmx:sseOpen", function() {
					document.documentElement.dataset.detentSseStatus = "open";
				});
				document.addEventListener("htmx:sseError", function() {
					document.documentElement.dataset.detentSseStatus = "error";
				});
				document.addEventListener("htmx:sseClose", function() {
					document.documentElement.dataset.detentSseStatus = "closed";
				});

				window.__detentSSEMetrics = {
					events: state.events,
					pending: state.pending,
					processing: state.processing,
					snapshot: metricsSnapshot,
					diagnostics: diagnosticsFor,
					report: report,
				};
			})();
		</script>
}

templ dashboardSidebarFilterScript() {
	<script>
			(function() {
			document.addEventListener("input", function(event) {
				const input = event.target.closest("[data-dashboard-project-filter]");
				if (!input) {
					return;
				}
				const query = input.value.trim().toLowerCase();
				document.querySelectorAll("[data-dashboard-project-entry]").forEach(function(entry) {
					const name = (entry.dataset.projectName || "").toLowerCase();
					entry.hidden = query !== "" && !name.includes(query);
				});
			});
		})();
	</script>
}

templ dashboardSidebarActiveScript() {
	<script>
		(function() {
			function sidebarContent() {
				return document.getElementById("dashboard-sidebar-live");
			}

			function staticNavForLocation() {
				const path = window.location.pathname;
				if (path === "/kanban") {
					return "kanban";
				}
				if (path === "/health/ui") {
					return "health";
				}
				if (path === "/analytics") {
					return "analytics";
				}
				return "";
			}

			function projectViewForLocation() {
				const path = window.location.pathname;
				if (path === "/settings" && new URLSearchParams(window.location.search).get("project")) {
					return "configuration";
				}
				if (!path.startsWith("/projects/")) {
					return "";
				}
				if (path.endsWith("/kanban")) {
					return "kanban";
				}
				if (path.endsWith("/runs")) {
					return "runs";
				}
				if (path.endsWith("/diagnostics")) {
					return "diagnostics";
				}
				if (path.endsWith("/configuration")) {
					return "configuration";
				}
				if (window.location.hash === "#running-issues") {
					return "runs";
				}
				if (window.location.hash === "#dashboard-diagnostics") {
					return "diagnostics";
				}
				return "overview";
			}

			function setActive(link, active) {
				if (!(link instanceof HTMLElement)) {
					return;
				}
				if (active) {
					link.dataset.tuiSidebarActive = "true";
					link.setAttribute("aria-current", "page");
					return;
				}
				link.removeAttribute("data-tui-sidebar-active");
				link.removeAttribute("aria-current");
			}

			function applyProjectSidebarActiveState() {
				const staticNav = staticNavForLocation();
				const view = projectViewForLocation();
				if (!staticNav && !view) {
					return;
				}
				const root = sidebarContent();
				if (!root) {
					return;
				}
				root.querySelectorAll("[data-dashboard-view-nav], [data-dashboard-static-nav]").forEach(function(link) {
					setActive(link, false);
				});
				if (staticNav) {
					setActive(root.querySelector("[data-dashboard-static-nav='" + staticNav + "']"), true);
					return;
				}
				setActive(root.querySelector("[data-dashboard-view='" + view + "']"), true);
			}

			document.addEventListener("click", function(event) {
				const link = event.target instanceof Element ? event.target.closest("[data-dashboard-view-nav]") : null;
				if (link) {
					window.requestAnimationFrame(applyProjectSidebarActiveState);
				}
			});
			window.addEventListener("hashchange", applyProjectSidebarActiveState);
			document.addEventListener("htmx:afterSettle", applyProjectSidebarActiveState);
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", applyProjectSidebarActiveState);
			} else {
				applyProjectSidebarActiveState();
			}
		})();
	</script>
}

templ diagnosticsTabsScript() {
	<script>
		(function() {
			if (window.__detentDiagnosticsTabsRegistered) {
				return;
			}
			window.__detentDiagnosticsTabsRegistered = true;

			function tabStorage() {
				try {
					return window.localStorage;
				} catch (error) {
					return null;
				}
			}

			function tabRoots() {
				return Array.from(document.querySelectorAll("[data-diagnostics-tabs]"));
			}

			function tabs(root) {
				return Array.from(root.querySelectorAll("[data-diagnostics-tab]"));
			}

			function panels(root) {
				return Array.from(root.querySelectorAll("[data-diagnostics-panel]"));
			}

			function storageName(root) {
				return root.dataset.diagnosticsStorageName || "detent.ui.diagnostics.selectedTab.fleet";
			}

			function hasTab(root, id) {
				return tabs(root).some(function(tab) {
					return tab.dataset.diagnosticsTab === id;
				});
			}

			function activeTabID(root) {
				const active = tabs(root).find(function(tab) {
					return tab.getAttribute("aria-selected") === "true";
				});
				return active ? active.dataset.diagnosticsTab : "overview";
			}

			function setActiveTab(root, id, persist) {
				if (!hasTab(root, id)) {
					id = "overview";
				}
				tabs(root).forEach(function(tab) {
					const active = tab.dataset.diagnosticsTab === id;
					tab.setAttribute("aria-selected", active ? "true" : "false");
					tab.setAttribute("tabindex", active ? "0" : "-1");
					tab.dataset.diagnosticsActive = active ? "true" : "false";
				});
				panels(root).forEach(function(panel) {
					panel.hidden = panel.dataset.diagnosticsPanel !== id;
				});
				if (persist) {
					const store = tabStorage();
					if (store) {
						store.setItem(storageName(root), id);
					}
				}
			}

			function restoreTabs(root) {
				const store = tabStorage();
				const saved = store ? store.getItem(storageName(root)) : "";
				setActiveTab(root, saved || activeTabID(root), false);
			}

			function moveFocus(tab, offset) {
				const root = tab.closest("[data-diagnostics-tabs]");
				if (!root) {
					return;
				}
				const list = tabs(root);
				const index = list.indexOf(tab);
				if (index < 0) {
					return;
				}
				const next = list[(index + offset + list.length) % list.length];
				next.focus();
				setActiveTab(root, next.dataset.diagnosticsTab || "overview", true);
			}

			document.addEventListener("click", function(event) {
				const tab = event.target instanceof Element ? event.target.closest("[data-diagnostics-tab]") : null;
				if (!tab) {
					return;
				}
				const root = tab.closest("[data-diagnostics-tabs]");
				if (!root) {
					return;
				}
				setActiveTab(root, tab.dataset.diagnosticsTab || "overview", true);
			});

			document.addEventListener("keydown", function(event) {
				const tab = event.target instanceof Element ? event.target.closest("[data-diagnostics-tab]") : null;
				if (!tab) {
					return;
				}
				const root = tab.closest("[data-diagnostics-tabs]");
				if (!root) {
					return;
				}
				if (event.key === "ArrowRight") {
					event.preventDefault();
					moveFocus(tab, 1);
				} else if (event.key === "ArrowLeft") {
					event.preventDefault();
					moveFocus(tab, -1);
				} else if (event.key === "Home") {
					event.preventDefault();
					const first = tabs(root)[0];
					if (first) {
						first.focus();
						setActiveTab(root, first.dataset.diagnosticsTab || "overview", true);
					}
				} else if (event.key === "End") {
					event.preventDefault();
					const list = tabs(root);
					const last = list[list.length - 1];
					if (last) {
						last.focus();
						setActiveTab(root, last.dataset.diagnosticsTab || "overview", true);
					}
				}
			});

			document.addEventListener("htmx:afterSettle", function() {
				tabRoots().forEach(restoreTabs);
			});

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", function() {
					tabRoots().forEach(restoreTabs);
				});
			} else {
				tabRoots().forEach(restoreTabs);
			}
		})();
	</script>
}

templ dashboardSidebarProjectOrderScript() {
	<script>
		(function() {
			const storageKey = "detent.ui.projectOrder";
			const storageVersion = 1;
			let draggingProjectID = "";
			let pendingApplyFrame = 0;
			let observedSidebar = null;
			let sidebarObserver = null;

			function projectOrderStorage() {
				try {
					return window.localStorage;
				} catch (error) {
					return null;
				}
			}

			function projectList() {
				return document.querySelector("[data-dashboard-project-order-list]");
			}

			function projectEntries() {
				const list = projectList();
				if (!list) {
					return [];
				}
				return Array.from(list.children).filter(function(child) {
					return child instanceof HTMLElement && child.hasAttribute("data-dashboard-project-entry");
				});
			}

			function projectEntryFor(target) {
				if (!(target instanceof Element)) {
					return null;
				}
				return target.closest("[data-dashboard-project-entry]");
			}

			function sidebarWrapper() {
				return document.querySelector("[data-tui-sidebar-wrapper][data-tui-sidebar-id='dashboard-sidebar']");
			}

			function sidebarCollapsed() {
				const wrapper = sidebarWrapper();
				return Boolean(wrapper && wrapper.dataset.tuiSidebarState === "collapsed");
			}

			function projectFilterActive() {
				const input = document.querySelector("[data-dashboard-project-filter]");
				return input instanceof HTMLInputElement && input.value.trim() !== "";
			}

			function savedProjectOrder() {
				const store = projectOrderStorage();
				if (!store) {
					return [];
				}
				let parsed = null;
				try {
					parsed = JSON.parse(store.getItem(storageKey) || "");
				} catch (error) {
					return [];
				}
				if (!parsed || parsed.v !== storageVersion || !Array.isArray(parsed.order)) {
					return [];
				}
				const seen = new Set();
				return parsed.order.filter(function(id) {
					if (typeof id !== "string" || id.trim() === "" || seen.has(id)) {
						return false;
					}
					seen.add(id);
					return true;
				});
			}

			function currentProjectOrder() {
				return projectEntries().map(function(entry) {
					return entry.dataset.projectId || "";
				}).filter(Boolean);
			}

			function setManualOrderState(manual) {
				const list = projectList();
				if (list) {
					list.dataset.projectOrderManual = manual ? "true" : "false";
				}
				const reset = document.querySelector("[data-dashboard-project-order-reset]");
				if (reset instanceof HTMLButtonElement) {
					reset.disabled = !manual;
				}
			}

			function saveProjectOrder(order) {
				const store = projectOrderStorage();
				if (!store) {
					return;
				}
				store.setItem(storageKey, JSON.stringify({ v: storageVersion, order: order }));
				setManualOrderState(true);
			}

			function clearProjectOrder() {
				const store = projectOrderStorage();
				if (store) {
					store.removeItem(storageKey);
				}
				setManualOrderState(false);
			}

			function defaultProjectIndex(entry, fallback) {
				const index = Number(entry.dataset.projectDefaultIndex);
				return Number.isFinite(index) ? index : fallback;
			}

			function restoreDefaultOrder() {
				const list = projectList();
				if (!list) {
					return;
				}
				projectEntries().map(function(entry, index) {
					return { entry: entry, index: index, rank: defaultProjectIndex(entry, index) };
				}).sort(function(left, right) {
					return left.rank - right.rank || left.index - right.index;
				}).forEach(function(item) {
					list.appendChild(item.entry);
				});
			}

			function orderProjectNodes(order) {
				const list = projectList();
				if (!list || order.length === 0) {
					return;
				}
				const entries = projectEntries();
				const nodesByID = new Map();
				entries.forEach(function(entry) {
					const id = entry.dataset.projectId || "";
					if (id && !nodesByID.has(id)) {
						nodesByID.set(id, entry);
					}
				});
				const ordered = [];
				const orderedIDs = new Set();
				order.forEach(function(id) {
					const entry = nodesByID.get(id);
					if (!entry) {
						return;
					}
					ordered.push(entry);
					orderedIDs.add(id);
				});
				entries.forEach(function(entry) {
					const id = entry.dataset.projectId || "";
					if (!orderedIDs.has(id)) {
						ordered.push(entry);
					}
				});
				ordered.forEach(function(entry) {
					list.appendChild(entry);
				});
			}

			function reorderAvailable() {
				return projectEntries().length > 1 && !sidebarCollapsed() && !projectFilterActive();
			}

			function setButtonDisabled(button, disabled) {
				if (!(button instanceof HTMLButtonElement)) {
					return;
				}
				button.disabled = disabled;
				button.setAttribute("aria-disabled", disabled ? "true" : "false");
			}

			function updateProjectControls() {
				const list = projectList();
				const entries = projectEntries();
				const available = reorderAvailable();
				if (list) {
					list.dataset.projectOrderEnabled = available ? "true" : "false";
				}
				entries.forEach(function(entry, index) {
					entry.draggable = available;
					entry.setAttribute("aria-grabbed", draggingProjectID === entry.dataset.projectId ? "true" : "false");
					entry.dataset.projectOrderReady = available ? "true" : "false";
					setButtonDisabled(entry.querySelector("[data-dashboard-project-move='up']"), !available || index === 0);
					setButtonDisabled(entry.querySelector("[data-dashboard-project-move='down']"), !available || index === entries.length - 1);
				});
				setManualOrderState(savedProjectOrder().length > 0);
			}

			function observeSidebarState() {
				const wrapper = sidebarWrapper();
				if (wrapper === observedSidebar) {
					return;
				}
				if (sidebarObserver) {
					sidebarObserver.disconnect();
					sidebarObserver = null;
				}
				observedSidebar = wrapper;
				if (!wrapper || !("MutationObserver" in window)) {
					return;
				}
				sidebarObserver = new MutationObserver(function() {
					updateProjectControls();
				});
				sidebarObserver.observe(wrapper, { attributes: true, attributeFilter: ["data-tui-sidebar-state"] });
			}

			function applySavedProjectOrder() {
				if (draggingProjectID) {
					updateProjectControls();
					return;
				}
				const order = savedProjectOrder();
				if (order.length > 0) {
					orderProjectNodes(order);
				}
				updateProjectControls();
				observeSidebarState();
			}

			function scheduleApplySavedProjectOrder() {
				if (pendingApplyFrame) {
					return;
				}
				pendingApplyFrame = window.requestAnimationFrame(function() {
					pendingApplyFrame = 0;
					applySavedProjectOrder();
				});
			}

			function rowBeforePointer(clientY) {
				let candidate = null;
				let candidateOffset = Number.NEGATIVE_INFINITY;
				projectEntries().forEach(function(entry) {
					if (entry.dataset.projectId === draggingProjectID) {
						return;
					}
					const rect = entry.getBoundingClientRect();
					const offset = clientY - rect.top - rect.height / 2;
					if (offset < 0 && offset > candidateOffset) {
						candidateOffset = offset;
						candidate = entry;
					}
				});
				return candidate;
			}

			function clearDragState() {
				projectEntries().forEach(function(entry) {
					entry.classList.remove("dashboard-project-entry-dragging");
					entry.setAttribute("aria-grabbed", "false");
				});
				draggingProjectID = "";
				updateProjectControls();
			}

			function sidebarSwapTarget(event) {
				const detailTarget = event.detail && event.detail.target;
				const target = detailTarget instanceof Element ? detailTarget : event.target;
				if (!(target instanceof Element)) {
					return null;
				}
				if (target.id === "dashboard-sidebar-live") {
					return target;
				}
				return target.closest("#dashboard-sidebar-live");
			}

			function moveProject(entry, direction) {
				const list = projectList();
				const entries = projectEntries();
				const index = entries.indexOf(entry);
				if (!list || index < 0) {
					return;
				}
				if (direction === "up" && index > 0) {
					list.insertBefore(entry, entries[index - 1]);
				}
				if (direction === "down" && index < entries.length - 1) {
					list.insertBefore(entry, entries[index + 2] || null);
				}
				saveProjectOrder(currentProjectOrder());
				updateProjectControls();
				const button = entry.querySelector("[data-dashboard-project-move='" + direction + "']");
				if (button instanceof HTMLButtonElement) {
					button.focus();
				}
			}

			document.addEventListener("dragstart", function(event) {
				const target = event.target instanceof Element ? event.target : null;
				const entry = projectEntryFor(target);
				if (!entry) {
					return;
				}
				if (!reorderAvailable() || (target && target.closest("[data-dashboard-project-order-controls]"))) {
					event.preventDefault();
					return;
				}
				draggingProjectID = entry.dataset.projectId || "";
				if (!draggingProjectID) {
					event.preventDefault();
					return;
				}
				entry.classList.add("dashboard-project-entry-dragging");
				entry.setAttribute("aria-grabbed", "true");
				if (event.dataTransfer) {
					event.dataTransfer.effectAllowed = "move";
					event.dataTransfer.setData("text/plain", draggingProjectID);
				}
			});

			document.addEventListener("dragover", function(event) {
				if (!draggingProjectID || !reorderAvailable()) {
					return;
				}
				const list = projectList();
				const target = event.target instanceof Element ? event.target : null;
				if (!list || !target || (target !== list && !list.contains(target))) {
					return;
				}
				const dragged = projectEntries().find(function(entry) {
					return entry.dataset.projectId === draggingProjectID;
				});
				if (!dragged) {
					return;
				}
				event.preventDefault();
				const before = rowBeforePointer(event.clientY);
				if (before) {
					list.insertBefore(dragged, before);
				} else {
					list.appendChild(dragged);
				}
				updateProjectControls();
			});

			document.addEventListener("drop", function(event) {
				if (!draggingProjectID) {
					return;
				}
				event.preventDefault();
				saveProjectOrder(currentProjectOrder());
				clearDragState();
			});

			document.addEventListener("dragend", function() {
				if (draggingProjectID) {
					clearDragState();
				}
			});

			document.addEventListener("click", function(event) {
				const reset = event.target instanceof Element ? event.target.closest("[data-dashboard-project-order-reset]") : null;
				if (reset) {
					event.preventDefault();
					clearProjectOrder();
					restoreDefaultOrder();
					updateProjectControls();
					return;
				}
				const button = event.target instanceof Element ? event.target.closest("[data-dashboard-project-move]") : null;
				if (button instanceof HTMLButtonElement) {
					event.preventDefault();
					if (!reorderAvailable() || button.disabled) {
						return;
					}
					const entry = projectEntryFor(button);
					if (entry) {
						moveProject(entry, button.dataset.dashboardProjectMove || "");
					}
				}
			});

			document.addEventListener("input", function(event) {
				const input = event.target instanceof Element ? event.target.closest("[data-dashboard-project-filter]") : null;
				if (input) {
					updateProjectControls();
				}
			});

			document.addEventListener("htmx:beforeSwap", function(event) {
				if (draggingProjectID && sidebarSwapTarget(event)) {
					event.preventDefault();
				}
			});

			document.addEventListener("htmx:afterSettle", function() {
				scheduleApplySavedProjectOrder();
			});

			window.addEventListener("storage", function(event) {
				if (event.key === storageKey) {
					scheduleApplySavedProjectOrder();
				}
			});

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", applySavedProjectOrder);
			} else {
				applySavedProjectOrder();
			}
		})();
	</script>
}

templ dashboardSidebar(data DashboardShellData) {
	@sidebar.Sidebar(sidebar.Props{
		ID:          "dashboard-sidebar",
		Collapsible: sidebar.CollapsibleIcon,
		Collapsed:   data.SidebarCollapsed,
		Class:       "dashboard-sidebar text-text",
	}) {
		@sidebar.Header(sidebar.HeaderProps{Class: "flex-row items-center justify-between border-b border-line group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:justify-center"}) {
			<a class="inline-flex min-h-8 min-w-0 shrink-0 items-center gap-2 text-text hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden" href="/" aria-label="Detent dashboard">
				<span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded bg-elev font-semibold text-text">D</span>
				<span class="truncate text-sm font-semibold">Detent</span>
				if data.InstanceName != "" {
					<span class="max-w-[8rem] truncate rounded-full border border-line bg-elev px-2 py-0.5 font-mono text-xs font-medium text-text" aria-label="Instance name">{ data.InstanceName }</span>
				}
			</a>
			@sidebar.Trigger(sidebar.TriggerProps{
				Target: "dashboard-sidebar",
				Class:  "text-text hover:bg-elev hover:text-text focus-visible:ring-accent",
			})
		}
		@sidebar.Content(sidebar.ContentProps{
			ID:    "dashboard-sidebar-live",
			Class: "dashboard-sidebar-content",
			Attributes: templ.Attributes{
				"sse-swap": "sidebar",
				"hx-swap":  "morph:innerHTML",
			},
		}) {
			@DashboardSidebarContent(data)
		}
		@dashboardProjectOrderFooter()
	}
	@dashboardSidebarFilterScript()
	@dashboardSidebarActiveScript()
	@dashboardSidebarProjectOrderScript()
}

templ dashboardProjectOrderFooter() {
	@sidebar.Footer(sidebar.FooterProps{Class: "border-t border-line group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden"}) {
		@button.Button(button.Props{
			Variant:   button.VariantGhost,
			Size:      button.SizeSm,
			FullWidth: true,
			Class:     "justify-start px-2 text-xs text-sec hover:bg-elev hover:text-text focus-visible:ring-accent",
			Attributes: templ.Attributes{
				"data-dashboard-project-order-reset": true,
				"aria-label":                         "Reset project order",
			},
		}) {
			@icon.RotateCcw(icon.Props{Class: "size-3.5 shrink-0"})
			<span>Reset order</span>
		}
	}
}

templ DashboardSidebarContent(data DashboardShellData) {
	@sidebar.Group() {
		@sidebar.Menu() {
			@sidebar.MenuItem() {
				@sidebar.MenuButton(sidebar.MenuButtonProps{
					Href:       "/",
					IsActive:   sidebarFleetActive(data),
					Tooltip:    sidebarFleetTooltip(data),
					Attributes: sidebarAriaCurrent(sidebarFleetActive(data)),
				}) {
					@icon.LayoutDashboard(icon.Props{Class: "size-4 shrink-0"})
					<span>Fleet</span>
				}
			}
			if fleetKanbanNavVisible(data) {
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Href:       "/kanban",
						IsActive:   fleetKanbanNavActive(data),
						Tooltip:    "Fleet Kanban",
						Attributes: fleetKanbanNavAttributes(data),
					}) {
						@icon.Kanban(icon.Props{Class: "size-4 shrink-0"})
						<span>Kanban</span>
					}
				}
			}
		}
		if sidebarFilterVisible(data) {
			<label class="grid gap-1 px-2 group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden">
				<span class="sr-only">{ sidebarProjectSearchLabel(data) }</span>
				<input id="dashboard-project-filter" name="project_filter" type="search" class="min-h-9 rounded-md border border-line bg-page px-3 py-2 text-sm text-text placeholder:text-sec focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent" placeholder="Filter projects" data-dashboard-project-filter/>
			</label>
		}
		@sidebar.Menu(sidebar.MenuProps{
			Class: "dashboard-sidebar-projects",
			Attributes: templ.Attributes{
				"data-dashboard-project-order-list": true,
			},
		}) {
			for _, item := range sidebarProjectItems(data) {
				@sidebar.MenuItem(sidebar.MenuItemProps{
					Class:      "dashboard-project-entry",
					Attributes: sidebarProjectItemAttributes(item),
				}) {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Href:       item.Href,
						IsActive:   item.Active,
						Tooltip:    sidebarProjectTooltip(item),
						Class:      "dashboard-project-menu-button",
						Attributes: sidebarProjectButtonAttributes(item),
					}) {
						if sidebarProjectOrderAvailable(data) {
							<span class="dashboard-project-drag-handle group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden" data-dashboard-project-drag-handle aria-hidden="true">
								@icon.GripVertical(icon.Props{Class: "size-3.5"})
							</span>
						}
						<span class="inline-flex h-4 w-1.5 shrink-0 rounded-full border border-line" aria-label={ item.Name + " project color" } title={ "Project color: " + item.Name } { projectColorAttributes(item.ProjectColor)... }></span>
						<span class={ "inline-flex size-2.5 shrink-0 rounded-full " + item.DotClass }></span>
						<span>{ item.Name }</span>
						@sidebar.MenuBadge(sidebar.MenuBadgeProps{
							Class: "font-mono " + item.BadgeClass,
							Attributes: templ.Attributes{
								"aria-label": item.RunningLabel,
								"title":      item.RunningLabel,
							},
						}) {
							{ item.CountLabel }
						}
					}
					if sidebarProjectOrderAvailable(data) {
						@dashboardProjectOrderControls(item)
					}
				}
			}
		}
	}
	if projectSidebarNavVisible(data) {
		@sidebar.Separator()
		@sidebar.Group(sidebar.GroupProps{
			Attributes: templ.Attributes{
				"aria-label": "Project views",
			},
		}) {
			@sidebar.GroupLabel() {
				<span>Project views</span>
			}
			@sidebar.Menu() {
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Href:       projectSidebarOverviewPath(data),
						IsActive:   projectSidebarOverviewActive(data),
						Tooltip:    "Project overview",
						Attributes: projectSidebarViewAttributes(data, "overview"),
					}) {
						@icon.LayoutDashboard(icon.Props{Class: "size-4 shrink-0"})
						<span>Overview</span>
					}
				}
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Href:       projectSidebarKanbanPath(data),
						IsActive:   projectSidebarKanbanActive(data),
						Tooltip:    "Project Kanban",
						Attributes: projectSidebarViewAttributes(data, "kanban"),
					}) {
						@icon.Kanban(icon.Props{Class: "size-4 shrink-0"})
						<span>Kanban</span>
					}
				}
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Href:       projectSidebarRunsPath(data),
						IsActive:   projectSidebarRunsActive(data),
						Tooltip:    "Project runs",
						Attributes: projectSidebarViewAttributes(data, "runs"),
					}) {
						@icon.Activity(icon.Props{Class: "size-4 shrink-0"})
						<span>Runs</span>
					}
				}
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Href:       projectSidebarConfigurationPath(data),
						IsActive:   projectSidebarConfigurationActive(data),
						Tooltip:    "Project configuration",
						Attributes: projectSidebarViewAttributes(data, "configuration"),
					}) {
						@icon.SlidersHorizontal(icon.Props{Class: "size-4 shrink-0"})
						<span>Configuration</span>
					}
				}
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Href:       projectSidebarDiagnosticsPath(data),
						IsActive:   projectSidebarDiagnosticsActive(data),
						Tooltip:    "Project diagnostics",
						Attributes: projectSidebarViewAttributes(data, "diagnostics"),
					}) {
						@icon.Gauge(icon.Props{Class: "size-4 shrink-0"})
						<span>Diagnostics</span>
					}
				}
			}
		}
	}
	@sidebar.Separator()
	@sidebar.Group() {
		@sidebar.Menu() {
			@sidebar.MenuItem() {
				@GitHubAPIHealthSidebarItem(data)
			}
			@sidebar.MenuItem() {
				@sidebar.MenuButton(sidebar.MenuButtonProps{
					Href:       sidebarAnalyticsPath(data),
					IsActive:   sidebarStaticNavActive(data, "analytics"),
					Tooltip:    "Analytics",
					Attributes: sidebarStaticNavAttributes(data, "analytics"),
				}) {
					@icon.ChartSpline(icon.Props{Class: "size-4 shrink-0"})
					<span>Analytics</span>
				}
			}
			@sidebar.MenuItem() {
				@sidebar.MenuButton(sidebar.MenuButtonProps{
					Href:       sidebarReportsPath(data),
					IsActive:   sidebarStaticNavActive(data, "reports"),
					Tooltip:    "Reports",
					Attributes: sidebarStaticNavAttributes(data, "reports"),
				}) {
					@icon.ChartNoAxesCombined(icon.Props{Class: "size-4 shrink-0"})
					<span>Reports</span>
				}
			}
			@sidebar.MenuItem() {
				@sidebar.MenuButton(sidebar.MenuButtonProps{
					Href:       sidebarSettingsPath(data),
					IsActive:   sidebarStaticNavActive(data, "settings"),
					Tooltip:    "Settings",
					Attributes: sidebarStaticNavAttributes(data, "settings"),
				}) {
					@icon.Settings(icon.Props{Class: "size-4 shrink-0"})
					<span>Settings</span>
				}
			}
		}
	}
}

templ dashboardProjectOrderControls(item sidebarProjectItem) {
	<div class="dashboard-project-order-controls group-data-[tui-sidebar-state=collapsed]:group-data-[tui-sidebar-collapsible=icon]:hidden" data-dashboard-project-order-controls>
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Size:    button.SizeIcon,
			Class:   "size-6 text-sec hover:bg-elev hover:text-text focus-visible:ring-accent",
			Attributes: templ.Attributes{
				"data-dashboard-project-move": "up",
				"data-project-id":             item.ID,
				"aria-label":                  "Move " + item.Name + " up",
			},
		}) {
			@icon.ArrowUp(icon.Props{Class: "size-3.5"})
		}
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Size:    button.SizeIcon,
			Class:   "size-6 text-sec hover:bg-elev hover:text-text focus-visible:ring-accent",
			Attributes: templ.Attributes{
				"data-dashboard-project-move": "down",
				"data-project-id":             item.ID,
				"aria-label":                  "Move " + item.Name + " down",
			},
		}) {
			@icon.ArrowDown(icon.Props{Class: "size-3.5"})
		}
	</div>
}

templ dashboardCharts(data DashboardData) {
	<section id="dashboard-charts" class="dashboard-chart-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5" aria-label={ chartPanelTitle(data) } hx-preserve data-detent-charts data-chart-endpoint={ chartEndpoint(data) }>
		<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
			<div class="min-w-0">
				<h2 class="text-base font-semibold text-text">{ chartPanelTitle(data) }</h2>
				<p class="text-sm text-sec">{ chartPanelDescription(data) }</p>
			</div>
			<span class="shrink-0 rounded-full bg-elev px-2 py-1 font-mono text-xs text-sec">Chart.js</span>
		</div>
		<div class="mt-4 grid min-w-0 gap-3 lg:grid-cols-3">
			<div class="min-w-0 rounded-md border border-line bg-elev/60 p-3">
				<div class="mb-2 flex items-center justify-between gap-3">
					<h3 class="truncate text-sm font-medium text-text">Running agents</h3>
				</div>
				<div class="h-56 min-w-0">
					<canvas id="running-agents-chart" data-chart="running-agents" aria-label="Running agents over time"></canvas>
				</div>
			</div>
			if isProjectDashboard(data) {
				<div class="min-w-0 rounded-md border border-line bg-elev/60 p-3">
					<div class="mb-2 flex items-center justify-between gap-3">
						<h3 class="truncate text-sm font-medium text-text">Token spend</h3>
					</div>
					<div class="h-56 min-w-0">
						<canvas id="token-spend-chart" data-chart="token-spend" aria-label="Token spend trend"></canvas>
					</div>
				</div>
				<div class="min-w-0 rounded-md border border-line bg-elev/60 p-3">
					<div class="mb-2 flex items-center justify-between gap-3">
						<h3 class="truncate text-sm font-medium text-text">Board flow</h3>
					</div>
					<div class="h-56 min-w-0">
						<canvas id="board-flow-chart" data-chart="board-flow" aria-label="Board state flow over time"></canvas>
					</div>
				</div>
			} else {
				<div class="min-w-0 rounded-md border border-line bg-elev/60 p-3">
					<div class="mb-2 flex items-center justify-between gap-3">
						<h3 class="truncate text-sm font-medium text-text">Tokens/sec</h3>
					</div>
					<div class="h-56 min-w-0">
						<canvas id="tokens-per-second-chart" data-chart="tokens-per-second" aria-label="Tokens per second trend"></canvas>
					</div>
				</div>
				<div class="min-w-0 rounded-md border border-line bg-elev/60 p-3">
					<div class="mb-2 flex items-center justify-between gap-3">
						<h3 class="truncate text-sm font-medium text-text">Completions</h3>
					</div>
					<div class="h-56 min-w-0">
						<canvas id="completions-chart" data-chart="completions" aria-label="Completions per project"></canvas>
					</div>
				</div>
			}
		</div>
	</section>
}

templ SnapshotView(data DashboardData) {
	@updatePendingBanner(data.Snapshot, "")
	if isProjectDashboard(data) {
		@ProjectOverviewSnapshot(data)
	} else {
		@FleetSnapshot(data)
	}
}

templ ProjectOverviewSnapshot(data DashboardData) {
	@dashboardHealth(data)
	@failureBreakerBanner(data.Snapshot)
	@dispatchRecoveryBanner(data.Snapshot)
	@trackerDriftWarning(data.Snapshot)
	if data.ProjectPaused {
		<section class="rounded-md border border-warn bg-warn/15 p-4 text-warn shadow-sm" aria-label="Paused project">
			<div class="flex items-start gap-3">
				<span class="mt-1 h-2.5 w-2.5 rounded-full bg-warn"></span>
				<div class="min-w-0">
					<h2 class="text-sm font-semibold">{ projectDisplayName(data) } is paused.</h2>
					<p class="mt-1 text-sm text-warn">Detent will keep showing telemetry, but this project is not dispatching new work.</p>
				</div>
			</div>
		</section>
	}
	if !snapshotReady(data.Snapshot) {
		@snapshotReadiness(data.Snapshot)
	} else {
		@statStrip(data.Snapshot)
		@projectOverviewSummarySection(data)
	}
}

templ ProjectDiagnosticsSnapshot(data DashboardData) {
	@updatePendingBanner(data.Snapshot, "")
	if !snapshotReady(data.Snapshot) && !diagnosticsSnapshotHasLoadedData(data.Snapshot) {
		@snapshotReadiness(data.Snapshot)
	} else {
		@failureBreakerBanner(data.Snapshot)
		@dispatchRecoveryBanner(data.Snapshot)
		@diagnosticsOperationsSummary(data)
		@trackerDriftWarning(data.Snapshot)
		@diagnosticsTabbedView(data)
	}
}

templ diagnosticsOperationsSummary(data DashboardData) {
	<section id="diagnostics-summary" class="flex flex-none flex-col gap-3 rounded-card border border-line bg-surface p-3" aria-label="Diagnostics operations summary">
		<div class="grid min-w-0 gap-2 md:grid-cols-5">
			for _, fact := range diagnosticsSummaryFacts(data) {
				<article class="flex min-w-0 flex-col gap-1 rounded-card border border-line bg-elev px-3 py-2.5">
					<div class="flex min-w-0 items-center gap-1.5">
						@primitives.StatusDot(fact.Kind, false)
						<span class="truncate text-2xs font-semibold uppercase text-dim">{ fact.Label }</span>
					</div>
					<div class="truncate text-sm font-semibold text-text">{ fact.Value }</div>
					<p class="line-clamp-2 text-xs text-sec">
						{ fact.Detail }
						if fact.DetailReference != "" {
							{ fact.DetailPrefix }
							@primitives.TrackerReferenceLink(fact.DetailReference, fact.DetailReferenceURL, "font-mono")
							{ fact.DetailSuffix }
						}
					</p>
				</article>
			}
		</div>
	</section>
}

templ diagnosticsTabbedView(data DashboardData) {
	<section class="flex flex-none flex-col gap-3" aria-label="Diagnostics operations view" data-diagnostics-tabs data-diagnostics-storage-name={ diagnosticsStorageName(data) }>
		<div class="overflow-x-auto rounded-card border border-line bg-surface p-1" role="tablist" aria-label="Diagnostics sections">
			<div class="flex min-w-max items-center gap-1">
				@diagnosticsTabButton("overview", "Overview", true)
				@diagnosticsTabButton("workflow-timing", "Workflow timing", false)
				@diagnosticsTabButton("active-work", "Active work", false)
				@diagnosticsTabButton("queues-blockers", "Queues & blockers", false)
				@diagnosticsTabButton("github-api", "GitHub/API", false)
				@diagnosticsTabButton("runtime-store", "Runtime store", false)
				@diagnosticsTabButton("raw-debug", "Raw/Debug", false)
			</div>
		</div>
		<div class="grid min-w-0">
			@diagnosticsTabPanel("overview", "Overview", true) {
				@diagnosticsOverviewTab(data)
			}
			@diagnosticsTabPanel("workflow-timing", "Workflow timing", false) {
				@diagnosticsWorkflowTimingTab(data)
			}
			@diagnosticsTabPanel("active-work", "Active work", false) {
				@diagnosticsActiveWorkTab(data)
			}
			@diagnosticsTabPanel("queues-blockers", "Queues & blockers", false) {
				@diagnosticsQueuesBlockersTab(data)
			}
			@diagnosticsTabPanel("github-api", "GitHub/API", false) {
				@diagnosticsGitHubAPITab(data)
			}
			@diagnosticsTabPanel("runtime-store", "Runtime store", false) {
				@diagnosticsRuntimeStoreTab(data)
			}
			@diagnosticsTabPanel("raw-debug", "Raw/Debug", false) {
				@diagnosticsRawDebugTab(data)
			}
		</div>
	</section>
}

templ diagnosticsTabButton(id string, label string, active bool) {
	<button id={ "diagnostics-tab-" + id } class="inline-flex h-8 shrink-0 items-center rounded-chip px-2.5 text-xs font-medium text-sec transition-colors hover:bg-elev hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent data-[diagnostics-active=true]:bg-elev data-[diagnostics-active=true]:text-accent" type="button" role="tab" aria-selected={ diagnosticsBool(active) } aria-controls={ "diagnostics-panel-" + id } tabindex={ diagnosticsTabIndex(active) } data-diagnostics-tab={ id } data-diagnostics-active={ diagnosticsBool(active) }>
		{ label }
	</button>
}

templ diagnosticsTabPanel(id string, label string, active bool) {
	<section id={ "diagnostics-panel-" + id } class="grid min-w-0 gap-3" role="tabpanel" aria-labelledby={ "diagnostics-tab-" + id } tabindex="0" data-diagnostics-panel={ id } hidden?={ !active }>
		{ children... }
	</section>
}

templ diagnosticsOverviewTab(data DashboardData) {
	<div class="grid min-w-0 gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
		<div class="grid min-w-0 gap-4">
			@boardHealthSection(data.Snapshot)
			@cycleTimeSection(data.Snapshot.CycleTime)
		</div>
		<aside class="grid min-w-0 content-start gap-4">
			@diagnosticsBottleneckCard(data.Snapshot.WorkflowMetrics, data.Snapshot.Project)
			@throughputCard(data)
		</aside>
	</div>
}

templ diagnosticsBottleneckCard(report telemetry.WorkflowMetrics, project telemetry.Project) {
	{{ bottleneck := workflowBottleneck(report) }}
	@primitives.Panel(primitives.PanelProps{ID: "diagnostics-bottleneck", Title: "Active bottleneck", Count: bottleneck.Value}) {
		<div class="flex flex-col gap-3 p-4">
			<div class="flex min-w-0 items-start gap-2">
				@primitives.StatusDot(primitives.KindWarn, false)
				<div class="min-w-0">
					<div class="truncate text-sm font-semibold text-text">{ bottleneck.Label }</div>
					<p class="mt-1 text-xs text-sec">{ bottleneck.Detail }</p>
					if bottleneck.Count != "" {
						<div class="mt-1 font-mono text-2xs text-dim">{ bottleneck.Count }</div>
					}
				</div>
			</div>
			if workflowBottleneckDiagnosticPrompt(project, report) != "" {
				@diagnosticPromptCopyButton(workflowBottleneckDiagnosticPrompt(project, report), "Copy diagnostic prompt", "Copy diagnostic prompt")
			}
		</div>
	}
}

templ diagnosticsWorkflowTimingTab(data DashboardData) {
	<div class="grid min-w-0 gap-4" data-preserve-scroll="diagnostics-workflow-timing">
		<div class="flex min-w-0 flex-wrap items-center justify-between gap-2 rounded-md border border-line bg-surface px-3 py-2 text-sm">
			<span class="font-medium text-text">Query windows</span>
			<span class="font-mono text-sec">{ workflowMetricsWindowLabels(data.Snapshot.WorkflowMetrics) }</span>
		</div>
		@workflowMetricsSection(data.Snapshot.WorkflowMetrics, data.Snapshot.Project)
		@cycleTimeSection(data.Snapshot.CycleTime)
	</div>
}

templ diagnosticsActiveWorkTab(data DashboardData) {
	<div class="grid min-w-0 gap-4 lg:grid-cols-2">
		@diagnosticsRunningWorkersSection(data.Snapshot)
		@schedulerRuntimeSection(data.Snapshot)
	</div>
}

templ diagnosticsRunningWorkersSection(snapshot telemetry.Snapshot) {
	@primitives.Panel(primitives.PanelProps{ID: "diagnostics-active-workers", Title: "Active workers", Count: formatCount(runningCount(snapshot)), Live: runningCount(snapshot) > 0}) {
		if len(snapshot.Running) == 0 {
			@primitives.EmptyLine("No active workers")
		} else {
			<div class="grid divide-y divide-line">
				for _, row := range snapshot.Running {
					<article class="grid min-w-0 gap-2 px-4 py-3">
						<div class="flex min-w-0 items-start gap-2">
							@primitives.StatusDot(primitives.KindOK, true)
							<div class="min-w-0 flex-1">
								@primitives.TrackerReferenceLink(issueIdentifier(row.Issue), row.URL, "block truncate font-mono text-xs font-medium text-text")
								<div class="truncate text-sm text-text">{ issueTitle(row.Issue) }</div>
							</div>
							if row.URL != "" {
								@issueOpenLink(row.URL, "Open issue "+issueIdentifier(row.Issue), true)
							}
						</div>
						<div class="grid gap-2 pl-3.5 text-xs sm:grid-cols-2">
							<div class="min-w-0">
								<span class="block text-2xs font-semibold uppercase text-dim">Worker host</span>
								<span class="block truncate font-mono text-sec">{ chartText(row.WorkerHost, "n/a") }</span>
							</div>
							<div class="min-w-0">
								<span class="block text-2xs font-semibold uppercase text-dim">Last event</span>
								<span class="block truncate font-mono text-sec">{ chartText(row.LastEvent, "n/a") }</span>
							</div>
							<div class="min-w-0">
								<span class="block text-2xs font-semibold uppercase text-dim">Heartbeat</span>
								if row.LastEventAt != nil {
									<span class="block truncate font-mono text-sec">{ timeLabel(*row.LastEventAt) }</span>
								} else {
									<span class="block truncate font-mono text-sec">n/a</span>
								}
							</div>
							<div class="min-w-0">
								<span class="block text-2xs font-semibold uppercase text-dim">Runtime</span>
								<span class="block truncate font-mono text-sec">{ formatDuration(row.RuntimeSeconds) }</span>
							</div>
						</div>
					</article>
				}
			</div>
		}
	}
}

templ diagnosticsQueuesBlockersTab(data DashboardData) {
	<div class="grid min-w-0 gap-4 xl:grid-cols-2">
		@retryQueueSection(data.Snapshot)
		@blockedSessionsSection(data.Snapshot)
	</div>
}

templ diagnosticsGitHubAPITab(data DashboardData) {
	<div class="grid min-w-0 gap-4 lg:grid-cols-[minmax(0,1fr)_20rem] xl:grid-cols-[minmax(0,1fr)_22rem]">
		<div class="grid min-w-0 gap-4">
			@rateLimitsCard(data.Snapshot.RateLimits)
			@budgetCard(data.Snapshot)
		</div>
		<aside class="grid min-w-0 content-start gap-4">
			@graphQLBudgetCard(data)
			@restBudgetCard(data)
		</aside>
	</div>
}

templ diagnosticsRuntimeStoreTab(data DashboardData) {
	@runtimeStoreEvidenceSection(data.Snapshot.WorkflowMetrics)
}

templ diagnosticsRawDebugTab(data DashboardData) {
	@primitives.Panel(primitives.PanelProps{ID: "diagnostics-raw-debug", Title: "Raw/Debug"}) {
		<div class="grid gap-4 p-4">
			<p class="text-xs text-sec">Low-level links and counters for deeper inspection.</p>
			<div class="grid gap-2 sm:grid-cols-2">
				<a class="rounded-card border border-line bg-elev px-3 py-2 text-sm font-medium text-text hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" href="/api/v1/state">Fleet state JSON</a>
				if projectStateAPIPath(data) != "" {
					<a class="rounded-card border border-line bg-elev px-3 py-2 text-sm font-medium text-text hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" href={ projectStateAPIPath(data) }>Project state JSON</a>
				}
			</div>
			<div class="grid gap-2 text-sm sm:grid-cols-3">
				@diagnosticsCounterTile("Recent events", formatCount(len(data.Snapshot.Events)))
				@diagnosticsCounterTile("Work attempts", formatCount(len(data.Snapshot.WorkAttempts)))
				@diagnosticsCounterTile("Scheduler decisions", formatCount(len(data.Snapshot.SchedulerDecisions)))
			</div>
		</div>
	}
}

templ runtimeStoreEvidenceSection(report telemetry.WorkflowMetrics) {
	@primitives.Panel(primitives.PanelProps{ID: "diagnostics-runtime-store", Title: "Runtime store", Count: runtimeStoreStatusLabel(report.RuntimeStore)}) {
		<div class="grid gap-4 p-4">
			<div class="flex min-w-0 items-start gap-2">
				@primitives.StatusDot(runtimeStoreStatusKind(report.RuntimeStore), false)
				<p class="text-xs text-sec">SQLite persistence evidence for workflow metrics and scheduler telemetry.</p>
			</div>
			<div class="grid gap-2 lg:grid-cols-3">
				@diagnosticsKeyValueTile("Database path", runtimeStorePathLabel(report.RuntimeStore))
				@diagnosticsKeyValueTile("Migration status", runtimeStoreMigrationLabel(report.RuntimeStore))
				@diagnosticsKeyValueTile("Newest event", runtimeWorkflowEventNewestLabel(report.RuntimeStore))
			</div>
			<div class="rounded-card border border-line bg-elev px-3 py-2 text-sm text-sec">
				<strong class="text-text">workflow_phase_events:</strong>
				<span class="font-mono">{ runtimeWorkflowEventCountLabel(report.RuntimeStore) }</span>
				<span>Oldest event { runtimeWorkflowEventOldestLabel(report.RuntimeStore) }. Newest event { runtimeWorkflowEventNewestLabel(report.RuntimeStore) }.</span>
			</div>
			if report.RuntimeStore.Status == "healthy" && report.RuntimeStore.WorkflowPhaseEvents.RowCount == 0 {
				@primitives.EmptyLine("SQLite history is empty")
			}
			if len(runtimeStoreTableRows(report.RuntimeStore)) > 0 {
				<div class="overflow-hidden rounded-card border border-line">
					<div class="overflow-x-auto" data-preserve-scroll="runtime-store-tables">
						<table class="w-full min-w-[38rem] table-fixed border-collapse text-sm">
							<thead class="bg-elev/70">
								<tr class="border-b border-line text-left text-xs font-medium uppercase text-sec">
									<th class="w-[18rem] px-3 py-3 font-medium">Table</th>
									<th class="w-[8rem] px-3 py-3 font-medium">Scope</th>
									<th class="px-3 py-3 text-right font-medium">Rows</th>
								</tr>
							</thead>
							<tbody>
								for _, row := range runtimeStoreTableRows(report.RuntimeStore) {
									<tr class="border-b border-line last:border-b-0">
										<td class="px-3 py-3 font-mono text-text">{ row.Name }</td>
										<td class="px-3 py-3 font-mono text-sec">{ row.Scope }</td>
										<td class="px-3 py-3 text-right font-mono text-sec">{ row.RowCount }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
		</div>
	}
}

templ diagnosticsCounterTile(label string, value string) {
	<div class="rounded-card bg-elev px-3 py-2">
		<span class="block text-2xs font-semibold uppercase text-dim">{ label }</span>
		<span class="font-mono text-sm font-medium text-text">{ value }</span>
	</div>
}

templ diagnosticsKeyValueTile(label string, value string) {
	<div class="min-w-0 rounded-card bg-elev px-3 py-2">
		<span class="block text-2xs font-semibold uppercase text-dim">{ label }</span>
		<span class="block truncate font-mono text-sm text-text">{ value }</span>
	</div>
}

templ FleetSnapshot(data DashboardData) {
	@dashboardHealth(data)
	@trackerDriftWarning(data.Snapshot)
	if !snapshotReady(data.Snapshot) {
		@snapshotReadiness(data.Snapshot)
	} else {
		@agentActivityTimeline(data.Snapshot)
		@statStrip(data.Snapshot)
		@projectSmallMultiplesSection(data)
		@prPipelineSection(data.Snapshot)
		<section class="dashboard-body-grid grid min-w-0 items-start gap-4 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-5 xl:grid-cols-[minmax(0,1fr)_22rem]">
			<div class="dashboard-primary-column grid min-w-0 content-start gap-4 lg:gap-5">
				@runningIssuesSection(data)
				<section class="dashboard-section-grid grid min-w-0 gap-4 xl:grid-cols-2">
					@retryQueueSection(data.Snapshot)
					@blockedSessionsSection(data.Snapshot)
				</section>
				@recentSessionsSection(data.Snapshot)
			</div>
			<aside class="dashboard-aside-column grid min-w-0 content-start gap-4 lg:gap-5">
				@throughputCard(data)
				@rateLimitsCard(data.Snapshot.RateLimits)
				@graphQLBudgetCard(data)
				@restBudgetCard(data)
				@tokenCard(data)
				@lifetimeCard(data.Snapshot.LifetimeTotals)
			</aside>
		</section>
	}
}

templ projectOverviewSummarySection(data DashboardData) {
	<section class="grid min-w-0 gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Project overview links">
		for _, card := range projectOverviewCards(data) {
			@projectOverviewCardView(card)
		}
	</section>
}

templ projectOverviewCardView(card projectOverviewCard) {
	<a class="dashboard-card group grid min-w-0 gap-3 rounded-md border border-line bg-surface p-4 shadow-sm transition-colors hover:border-accent hover:bg-elev/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" href={ card.Href } aria-label={ card.Title }>
		<div class="flex min-w-0 items-start justify-between gap-3">
			<div class="inline-flex min-w-0 items-center gap-2">
				<span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-elev text-sec group-hover:text-accent">
					if card.ID == "kanban" {
						@icon.Kanban(icon.Props{Class: "size-4"})
					} else if card.ID == "runs" {
						@icon.Activity(icon.Props{Class: "size-4"})
					} else if card.ID == "diagnostics" {
						@icon.Gauge(icon.Props{Class: "size-4"})
					} else {
						@icon.ChartNoAxesCombined(icon.Props{Class: "size-4"})
					}
				</span>
				<span class="truncate text-sm font-semibold text-text">{ card.Title }</span>
			</div>
			<span class={ "mt-3 h-2.5 w-2.5 shrink-0 rounded-full " + card.DotClass }></span>
		</div>
		<div class="min-w-0">
			<div class="truncate font-mono text-2xl font-semibold text-text">{ card.Value }</div>
			<div class="mt-1 truncate text-sm text-sec">{ card.Detail }</div>
		</div>
	</a>
}

templ runningIssuesSection(data DashboardData) {
	<section id="running-issues" class="dashboard-panel scroll-mt-3 min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5" tabindex="-1">
		@panelHeader(icon.Activity(icon.Props{Class: "size-4 shrink-0"}), "Running issues", helpRunning, "running-issues") {
			<span class="inline-flex min-h-9 min-w-9 shrink-0 items-center justify-center rounded-full bg-accent/15 px-2 py-1 text-sm font-medium text-accent">{ formatCount(runningCount(data.Snapshot)) }</span>
		}
		if len(data.Snapshot.Running) == 0 {
			<div class="mt-4">
				if runningCount(data.Snapshot) > 0 {
					@dashboardEmptyState("Running session details are unavailable.", "The summary count is live, but detailed agent rows have not arrived in this snapshot.", "bg-accent")
				} else {
					@dashboardEmptyState("No active issue sessions.", "New agent sessions will appear as Detent dispatches work.", "bg-accent")
				}
			</div>
		} else {
			<div class="mt-4 grid gap-3 sm:hidden">
				for i, row := range data.Snapshot.Running {
					@runningIssueMobileCard(row, i, data.Snapshot.GeneratedAt)
				}
			</div>
			<div class="mt-4 hidden overflow-hidden rounded-md border border-line sm:block">
				<div class="overflow-x-auto" data-preserve-scroll="running-issues">
					<table class="dashboard-table w-full min-w-[92rem] table-fixed border-collapse text-sm">
						<thead class="bg-elev/70">
							<tr class="border-b border-line text-left text-xs font-medium uppercase text-sec">
								<th class="w-[30rem] px-3 py-3 font-medium">Issue</th>
								<th class="w-[9rem] px-3 py-3 font-medium">State</th>
								<th class="w-[11rem] px-3 py-3 font-medium">
									@plainInlineLabel("Runtime / turns", "")
								</th>
								<th class="px-3 py-3 font-medium">
									@plainInlineLabel("Codex update", "")
								</th>
								<th class="w-[9rem] px-3 py-3 font-medium">
									@plainInlineLabel("Diff", "")
								</th>
								<th class="w-[11rem] px-3 py-3 font-medium">
									@plainInlineLabel("Tokens", "")
								</th>
								<th class="w-[9rem] px-3 py-3 font-medium">
									@plainInlineLabel("Session", "")
								</th>
							</tr>
						</thead>
						<tbody>
							for i, row := range data.Snapshot.Running {
								<tr class="border-b border-line transition-colors last:border-b-0 hover:bg-elev/50">
									<td class="px-3 py-4 align-top overflow-hidden" data-running-issue-cell>
										@issueCell(row.Issue, "running", i, true)
									</td>
									<td class="px-3 py-4 align-top">
										<span class="inline-flex rounded-full bg-accent/15 px-2 py-1 font-medium text-accent">{ issueState(row.Issue, "Running") }</span>
									</td>
									<td class="px-3 py-4 align-top font-mono text-sec whitespace-nowrap">{ runningRuntime(row, data.Snapshot.GeneratedAt) }</td>
									<td class="px-3 py-4 align-top overflow-hidden" data-running-activity-cell>
										@runningActivityCell(row, "running")
									</td>
									<td class="px-3 py-4 align-top font-mono text-sec whitespace-nowrap" data-running-diff-cell>{ formatDiffStat(row) }</td>
									<td class="px-3 py-4 align-top overflow-hidden" data-running-tokens-cell>
										<div class="grid min-w-0 gap-1 font-mono">
											<span class="font-medium text-text">{ formatTokens(row.Tokens) }</span>
											<span class="truncate text-xs text-sec">{ formatTokenBreakdown(row.Tokens) }</span>
											if contextPressureText(row.Tokens) != "" {
												<span class={ "truncate text-xs " + boardExtraTextClass(contextPressureKind(row.Tokens)) } title={ contextPressureTitle(row.Tokens) }>{ contextPressureText(row.Tokens) }</span>
											}
										</div>
									</td>
									<td class="px-3 py-4 align-top">
										@sessionCopyButton(row.SessionID)
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</section>
}

templ projectSmallMultiplesSection(data DashboardData) {
	if len(projectSmallMultipleCards(data)) > 0 {
		<section class="min-w-0" aria-label="Fleet grid">
			@panelHeader(icon.LayoutGrid(icon.Props{Class: "size-4 shrink-0"}), "Fleet grid", helpProjectMultiples, "project-small-multiples") {
				<span class="inline-flex min-h-9 min-w-9 shrink-0 items-center justify-center rounded-full bg-elev px-2 py-1 text-sm font-medium text-sec">{ formatCount(len(projectSmallMultipleCards(data))) }</span>
			}
			<div class={ projectSmallMultiplesGridClass(projectSmallMultipleCards(data)) }>
				for _, card := range projectSmallMultipleCards(data) {
					@projectSmallMultipleCardView(card)
				}
			</div>
		</section>
	}
}

templ projectSmallMultipleCardView(card projectSmallMultipleCard) {
	<article class="dashboard-card min-w-0 rounded-md border border-line bg-surface p-3 shadow-sm transition-colors hover:border-accent" aria-label={ card.Name + " project" }>
		<div class="flex min-w-0 items-start justify-between gap-3">
			<div class="flex min-w-0 items-start gap-2">
				<span class="mt-0.5 h-8 w-1.5 shrink-0 rounded-full border border-line" aria-label={ card.Name + " project color" } title={ "Project color: " + card.Name } { projectColorAttributes(card.ProjectColor)... }></span>
				<div class="min-w-0">
					<a class="block truncate text-sm font-semibold text-text hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" href={ card.Href }>{ card.Name }</a>
					<p class="mt-1 truncate font-mono text-xs text-sec">{ card.ActivityLabel }</p>
				</div>
			</div>
			<span class="shrink-0 rounded-full bg-accent/15 px-2 py-1 font-mono text-xs font-medium text-accent">{ card.ThroughputLabel }</span>
		</div>
		if card.ExternalURL != "" {
			<a class="mt-2 block truncate text-xs text-sec underline-offset-4 hover:text-accent hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" href={ card.ExternalURL } target="_blank" rel="noopener noreferrer">{ card.ExternalURL }</a>
		}
		<div class="mt-3 grid grid-cols-4 gap-2 text-xs">
			<span class="min-w-0 rounded-md bg-elev px-2 py-1.5">
				<span class="block text-sec">Run</span>
				<strong class="block truncate font-mono font-medium text-text">{ card.RunningLabel }</strong>
			</span>
			<span class="min-w-0 rounded-md bg-elev px-2 py-1.5">
				<span class="block text-sec">Queue</span>
				<strong class="block truncate font-mono font-medium text-text">{ card.QueueLabel }</strong>
			</span>
			<span class="min-w-0 rounded-md bg-elev px-2 py-1.5">
				<span class="block text-sec">Blocked</span>
				<strong class="block truncate font-mono font-medium text-text">{ card.BlockedLabel }</strong>
			</span>
			<span class="min-w-0 rounded-md bg-elev px-2 py-1.5">
				<span class="block text-sec">Sessions</span>
				<strong class="block truncate font-mono font-medium text-text">{ card.CompletedLabel }</strong>
			</span>
		</div>
		<div class="mt-3 grid min-w-0 gap-3 sm:grid-cols-3">
			<div class="grid min-w-0 gap-1">
				<div class="flex items-center justify-between gap-2 text-xs">
					<span class="text-sec">Throughput</span>
					<span class="font-mono text-sec">{ card.ThroughputLabel }</span>
				</div>
				@SparklineChart(card.ThroughputChart)
			</div>
			<div class="grid min-w-0 gap-1">
				<div class="flex items-center justify-between gap-2 text-xs">
					<span class="text-sec">Spend</span>
					<span class="font-mono text-sec">{ card.SpendLabel }</span>
				</div>
				@SparklineChart(card.SpendChart)
			</div>
			<div class="grid min-w-0 gap-1">
				<div class="flex items-center justify-between gap-2 text-xs">
					<span class="text-sec">Queue</span>
					<span class="font-mono text-sec">{ card.QueueLabel }</span>
				</div>
				@SparklineChart(card.QueueChart)
			</div>
		</div>
	</article>
}

templ throughputCard(data DashboardData) {
	<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5">
		@panelHeader(icon.Zap(icon.Props{Class: "size-4 shrink-0"}), "Token throughput", helpThroughput, "throughput-card") {
			<span class="shrink-0 rounded-full bg-accent/15 px-2 py-1 font-mono text-xs font-medium text-accent">{ throughputRate(data.Snapshot) }</span>
		}
		<div class="mt-5 grid gap-2">
			<div class="break-all font-mono text-2xl font-semibold text-text sm:text-3xl">{ throughputRate(data.Snapshot) }</div>
			<div class="text-sm text-sec">{ throughputWindowLabel(data.Snapshot) }</div>
		</div>
		<div class="mt-5">
			if len(throughputTrendPoints(data.Snapshot)) == 0 {
				@dashboardEmptyState("No throughput data yet.", "Rolling token samples will appear after activity is recorded.", "bg-accent")
			} else {
				@LineAreaChart(throughputTrendChart(data))
			}
		</div>
	</section>
}

templ lifetimeCard(totals telemetry.LifetimeTotals) {
	<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5">
		@panelHeader(icon.History(icon.Props{Class: "size-4 shrink-0"}), "Lifetime totals", helpLifetimeTotals, "lifetime-card") {
			<span class="shrink-0 rounded-full bg-elev px-2 py-1 text-xs font-medium text-sec">{ lifetimeStatus(totals) }</span>
		}
		if !totals.Available {
			<div class="mt-4">
				@dashboardEmptyState("Lifetime totals unavailable.", lifetimeDegradedReason(totals), "bg-dim")
			</div>
		} else {
			<div class="mt-5 grid gap-3 text-sm">
				<div class="flex items-center justify-between gap-4">
					<span class="text-sec">Tokens</span>
					<strong class="font-mono font-medium text-text">{ formatInt(totals.TotalTokens) }</strong>
				</div>
				<div class="flex items-center justify-between gap-4">
					<span class="text-sec">Input / output</span>
					<strong class="font-mono font-medium text-text">{ formatInt(totals.InputTokens) } / { formatInt(totals.OutputTokens) }</strong>
				</div>
				<div class="flex items-center justify-between gap-4">
					<span class="text-sec">Sessions</span>
					<strong class="font-mono font-medium text-text">{ lifetimeSessions(totals) }</strong>
				</div>
				<div class="flex items-center justify-between gap-4">
					<span class="text-sec">Orphan resume / fresh</span>
					<strong class="font-mono font-medium text-text">{ lifetimeOrphanContinuations(totals) }</strong>
				</div>
				<div class="flex items-center justify-between gap-4">
					<span class="text-sec">Resumed cache share</span>
					<strong class="font-mono font-medium text-text">{ lifetimeResumedCacheShare(totals) }</strong>
				</div>
				<div class="flex items-center justify-between gap-4">
					<span class="text-sec">Runtime</span>
					<strong class="font-mono font-medium text-text">{ lifetimeRuntime(totals) }</strong>
				</div>
				<div class="flex items-center justify-between gap-4">
					<span class="text-sec">Runs</span>
					<strong class="font-mono font-medium text-text">{ lifetimeRuns(totals) }</strong>
				</div>
			</div>
		}
	</section>
}

templ LiveTick(timestamp time.Time) {
	<span class="font-mono tabular-nums">@LocalTime(timestamp, LocalTimeOptions{Style: LocalTimeWithSeconds, Fallback: "--:--:--"})</span>
}

templ trackerDriftWarning(snapshot telemetry.Snapshot) {
	if trackerDriftVisible(snapshot) {
		<section class="rounded-md border border-warn bg-warn/15 p-4 text-warn shadow-sm" aria-label="Tracker status drift">
			<div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
				<div class="min-w-0">
					<div class="flex min-w-0 items-center gap-2">
						@icon.CircleAlert(icon.Props{Class: "size-4 shrink-0"})
						<h2 class="truncate text-sm font-semibold">Tracker status drift</h2>
						<span class="shrink-0 rounded-full bg-surface/70 px-2 py-0.5 font-mono text-xs font-medium text-warn">{ trackerDriftTotalLabel(snapshot) }</span>
					</div>
					<p class="mt-1 text-sm text-warn">Open GitHub issues need status-label cleanup before the label-backed board is fully reconciled.</p>
				</div>
				<div class="grid min-w-0 gap-3 lg:min-w-[26rem] lg:max-w-2xl lg:grid-cols-2">
					for _, row := range trackerDriftRows(snapshot) {
						<div class="min-w-0 rounded-md border border-warn/15 bg-surface/70 p-3">
							<div class="flex min-w-0 items-center justify-between gap-3">
								<h3 class="truncate text-sm font-semibold text-text">{ row.Title }</h3>
								<span class="shrink-0 rounded-full bg-warn/15 px-2 py-0.5 font-mono text-xs font-medium text-warn">{ row.CountLabel }</span>
							</div>
							<p class="mt-1 text-xs text-sec">{ row.Detail }</p>
							<ul class="mt-3 grid gap-2">
								for _, issue := range row.Issues {
									<li class="min-w-0 text-xs">
										<div class="inline-flex max-w-full items-center gap-1.5 font-medium">
											@primitives.TrackerReferenceLink(issue.Number, issue.URL, "shrink-0 font-mono")
											<span class="truncate text-text">{ issue.Title }</span>
										</div>
										if issue.State != "" || issue.Labels != "" {
											<div class="mt-1 flex min-w-0 flex-wrap gap-1.5 text-[0.7rem] text-sec">
												if issue.State != "" {
													<span class="rounded-sm bg-elev px-1.5 py-0.5">State { issue.State }</span>
												}
												if issue.Labels != "" {
													<span class="min-w-0 truncate rounded-sm bg-elev px-1.5 py-0.5" title={ issue.Labels }>{ issue.Labels }</span>
												}
											</div>
										}
									</li>
								}
							</ul>
						</div>
					}
				</div>
			</div>
		</section>
	}
}

templ dashboardHealth(data DashboardData) {
	<section id="dashboard-diagnostics" class="scroll-mt-3 flex flex-wrap items-center gap-2 rounded-md border border-line bg-surface p-3 shadow-sm" aria-label="Dashboard health" tabindex="-1">
		<span class={ "inline-flex min-h-8 items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold " + runtimeStatusClass(data.Snapshot) } aria-label="Runtime status">
			<span class="h-2 w-2 rounded-full bg-current"></span>
			<span>{ runtimeStatusLabel(data.Snapshot) }</span>
		</span>
		<span class={ "inline-flex min-h-8 items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold " + statsStatusClass(data.Snapshot) } aria-label="Stats status" title={ statsStatusTitle(data.Snapshot) }>
			<span class="h-2 w-2 rounded-full bg-current"></span>
			<span>{ statsStatusLabel(data.Snapshot) }</span>
		</span>
		<span class="inline-flex min-h-8 max-w-full items-center gap-2 rounded-full border border-line bg-elev px-3 py-1 text-xs font-semibold text-sec sm:max-w-[24rem]" aria-label="Instance identity" title={ instanceLabel(data.Snapshot) }>
			<span>Instance</span>
			<span class="truncate font-medium text-text">{ instanceLabel(data.Snapshot) }</span>
		</span>
		<span class={ "inline-flex min-h-8 max-w-full items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold sm:max-w-[32rem] " + dashboardScopeClass(data) } aria-label="Dashboard scope" title={ dashboardScopeLabel(data) }>
			<span>Scope</span>
			<span class="truncate">{ dashboardScopeLabel(data) }</span>
		</span>
	</section>
}

templ snapshotReadiness(snapshot telemetry.Snapshot) {
	<section
		class={ snapshotReadinessClass(snapshot) }
		aria-label="Snapshot readiness"
		if snapshotDegraded(snapshot) && !snapshotHasPriorTrackerSnapshot(snapshot) {
			role="alert"
		} else {
			role="status"
		}
	>
		<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
			<div class="flex min-w-0 items-start gap-3">
				<span class={ "mt-1 h-2.5 w-2.5 shrink-0 rounded-full " + snapshotReadinessDotClass(snapshot) }></span>
				<div class="min-w-0">
					<h2 class="text-sm font-semibold">{ snapshotReadinessTitle(snapshot) }</h2>
					<p class={ "mt-1 text-sm " + snapshotReadinessDetailClass(snapshot) }>{ snapshotReadinessDetail(snapshot) }</p>
				</div>
			</div>
			if manualRefreshVisible(snapshot) {
				<div class="flex min-w-0 flex-col gap-2 sm:max-w-sm sm:items-end">
					<form class="flex justify-start sm:justify-end" hx-post="/api/v1/refresh" hx-target="#manual-refresh-status" hx-swap="outerHTML">
						@button.Button(button.Props{
							Type:    button.TypeSubmit,
							Variant: button.VariantOutline,
							Size:    button.SizeSm,
							Class:   "border-warn bg-surface text-warn hover:border-accent hover:text-accent",
							Attributes: templ.Attributes{
								"aria-label": "Force tracker refresh",
							},
						}) {
							@icon.RefreshCw(icon.Props{Class: "size-3.5 shrink-0"})
							<span>Force refresh</span>
						}
					</form>
					@ManualRefreshFeedback(snapshot.Refresh.Manual)
				</div>
			}
		</div>
	</section>
}

templ ManualRefreshFeedback(attempt *telemetry.RefreshAttempt) {
	@ManualRefreshFeedbackWithID("manual-refresh-status", attempt)
}

templ ManualRefreshFeedbackWithID(id string, attempt *telemetry.RefreshAttempt) {
	<div id={ id } role="status" aria-live="polite" class="min-w-0">
		if manualRefreshStatusVisible(attempt) {
			<div class={ manualRefreshStatusClass(attempt) }>
				<div class="font-semibold">{ manualRefreshStatusLabel(attempt) }</div>
				if manualRefreshStatusDetail(attempt) != "" {
					<div class="mt-1 break-words opacity-90">{ manualRefreshStatusDetail(attempt) }</div>
				}
			</div>
		}
	</div>
}

templ metricCard(label string, value string, detail string, borderClass string, dotClass string) {
	<article class={ "dashboard-metric-card min-w-0 rounded-md border border-line border-t-2 bg-surface p-3 shadow-sm transition-colors hover:bg-elev/40 sm:p-4 " + borderClass }>
		<div class="flex items-start justify-between gap-3">
			<div class="grid min-w-0 gap-1">
				@plainInlineLabel(label, "text-sm font-medium text-sec")
				<span class="text-xs text-sec">{ detail }</span>
			</div>
			<span class={ "h-2.5 w-2.5 shrink-0 rounded-full " + dotClass }></span>
		</div>
		<div class="mt-4 break-all font-mono text-2xl font-semibold text-text sm:text-3xl">{ value }</div>
	</article>
}

templ statStrip(snapshot telemetry.Snapshot) {
	<section class="dashboard-stat-strip grid min-w-0 gap-2 rounded-md border border-line bg-surface p-2 shadow-sm sm:grid-cols-2 lg:grid-cols-6" aria-label="Dashboard statistics">
		@statStripItem("Running", formatCount(runningCount(snapshot)), "Active issue sessions", "bg-accent")
		@statStripItem("Queue", formatCount(queueCount(snapshot)), "Waiting or retrying", "bg-warn")
		@statStripItem("Blocked", formatCount(blockedCount(snapshot)), "Needs operator action", "bg-err")
		@statStripItem("Completed", formatCount(completedCount(snapshot)), "Finished sessions", "bg-ok")
		@statStripItem("tps", throughputRate(snapshot), "Rolling tokens/sec", "bg-accent")
		@statStripItem("Uptime", runtimeLabel(snapshot), "Aggregate agent uptime", "bg-ok")
	</section>
}

templ statStripItem(label string, value string, detail string, dotClass string) {
	<div class="min-w-0 rounded-md bg-elev/60 px-3 py-2">
		<div class="flex min-w-0 items-center justify-between gap-2">
			@plainInlineLabel(label, "truncate text-xs font-medium uppercase text-sec")
			<span class={ "h-2 w-2 shrink-0 rounded-full " + dotClass }></span>
		</div>
		<div class="mt-1 truncate font-mono text-lg font-semibold text-text">{ value }</div>
		<div class="truncate text-xs text-sec">{ detail }</div>
	</div>
}

templ dashboardEmptyState(title string, detail string, dotClass string) {
	<div class="dashboard-empty-state min-w-0 max-w-full overflow-hidden rounded-md border border-dashed border-line bg-elev/60 px-3 py-3 text-left">
		<div class="flex min-w-0 items-start gap-3">
			<span class={ "mt-1.5 h-2 w-2 shrink-0 rounded-full " + dotClass }></span>
			<div class="min-w-0 flex-1">
				<p class="break-words text-sm font-medium text-text">{ title }</p>
				if detail != "" {
					<p class="mt-1 break-words text-sm text-sec">{ detail }</p>
				}
			</div>
		</div>
	</div>
}

templ prPipelineSection(snapshot telemetry.Snapshot) {
	<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5" aria-label="Pull request pipeline">
		@panelHeader(icon.GitPullRequest(icon.Props{Class: "size-4 shrink-0"}), "PR pipeline", helpPRPipeline, "pr-pipeline") {
			<span class="inline-flex min-h-9 min-w-9 shrink-0 items-center justify-center rounded-full bg-accent/15 px-2 py-1 text-sm font-medium text-accent">{ prPipelineTotalLabel(snapshot) }</span>
		}
		@prPipelineMergeSummaryView(prPipelineMergeSummary(snapshot))
		<div class="dashboard-section-grid mt-4 grid min-w-0 gap-3 lg:grid-cols-3">
			for _, lane := range prPipelineLanes(snapshot) {
				@prPipelineLaneView(lane)
			}
		</div>
	</section>
}

templ prPipelineMergeSummaryView(summary prPipelineMergeMetrics) {
	if summary.Available {
		<div class="mt-4 grid min-w-0 gap-2 sm:grid-cols-2 xl:grid-cols-9">
			<div class="min-w-0 rounded-md border border-line bg-surface px-3 py-2 text-text">
				<span class="block text-xs font-medium uppercase text-sec">Depth</span>
				<span class="mt-1 block truncate font-mono text-sm font-semibold">{ summary.Depth }</span>
			</div>
			<div class="min-w-0 rounded-md border border-line bg-surface px-3 py-2 text-text">
				<span class="block text-xs font-medium uppercase text-sec">Drain ETA</span>
				<span class="mt-1 block truncate font-mono text-sm font-semibold">{ summary.DrainETA }</span>
			</div>
			<div class={ "min-w-0 rounded-md border px-3 py-2 " + prPipelineMergeSummaryClass(summary.ActiveWarning) }>
				<span class="block text-xs font-medium uppercase">Active</span>
				<span class="mt-1 block truncate font-mono text-sm font-semibold">{ summary.ActiveElapsed }</span>
			</div>
			<div class={ "min-w-0 rounded-md border px-3 py-2 " + prPipelineMergeSummaryClass(summary.QueueWarning) }>
				<span class="block text-xs font-medium uppercase">Queued</span>
				<span class="mt-1 block truncate font-mono text-sm font-semibold">{ summary.QueueWait }</span>
			</div>
			<div class="min-w-0 rounded-md border border-line bg-surface px-3 py-2 text-text">
				<span class="block text-xs font-medium uppercase text-sec">Recent</span>
				<span class="mt-1 block truncate font-mono text-sm font-semibold">{ summary.RecentCount }</span>
			</div>
			<div class="min-w-0 rounded-md border border-line bg-surface px-3 py-2 text-text">
				<span class="block text-xs font-medium uppercase text-sec">Active p50</span>
				<span class="mt-1 block truncate font-mono text-sm font-semibold">{ summary.ActiveP50 }</span>
			</div>
			<div class="min-w-0 rounded-md border border-line bg-surface px-3 py-2 text-text">
				<span class="block text-xs font-medium uppercase text-sec">Active p90</span>
				<span class="mt-1 block truncate font-mono text-sm font-semibold">{ summary.ActiveP90 }</span>
			</div>
			<div class="min-w-0 rounded-md border border-line bg-surface px-3 py-2 text-text">
				<span class="block text-xs font-medium uppercase text-sec">Total p50</span>
				<span class="mt-1 block truncate font-mono text-sm font-semibold">{ summary.TotalP50 }</span>
			</div>
			<div class="min-w-0 rounded-md border border-line bg-surface px-3 py-2 text-text">
				<span class="block text-xs font-medium uppercase text-sec">Total p90</span>
				<span class="mt-1 block truncate font-mono text-sm font-semibold">{ summary.TotalP90 }</span>
			</div>
		</div>
	}
}

templ prPipelineLaneView(lane prPipelineLane) {
	<section class="pr-pipeline-lane min-w-0 rounded-md border border-line bg-elev/60 p-3" aria-label={ lane.Title + " lane" }>
		<div class="flex min-h-9 items-center justify-between gap-3">
			<div class="inline-flex min-w-0 items-center gap-2">
				<span class={ "h-2 w-2 shrink-0 rounded-full " + lane.DotClass }></span>
				<h3 class="truncate text-sm font-semibold text-text">{ lane.Title }</h3>
			</div>
			<span class="shrink-0 rounded-full bg-surface px-2 py-1 font-mono text-xs font-medium text-sec">{ lane.CountLabel }</span>
		</div>
		if len(lane.Cards) == 0 {
			<div class="mt-3">
				@dashboardEmptyState(lane.EmptyTitle, lane.EmptyDetail, lane.DotClass)
			</div>
		} else {
			<div class="pr-pipeline-lane-scroll mt-3 grid auto-rows-max max-h-[24rem] gap-2 overflow-y-auto pb-1 pr-1" data-preserve-scroll={ "pr-pipeline-" + lane.ID }>
				for _, card := range lane.Cards {
					@prPipelineCardView(card)
				}
			</div>
		}
	</section>
}

templ prPipelineCardView(card prPipelineCard) {
	<article class="pr-pipeline-card min-w-0 rounded-md border border-line bg-surface p-3 shadow-sm" data-pr-pipeline-identity={ card.Identity.Label }>
		<div class="flex min-w-0 items-start justify-between gap-3">
			<div class="min-w-0 flex-1 basis-0">
				@issueIdentityLine(card.Identity, true)
				if card.URL != "" {
					<a class="mt-1 block min-w-0 max-w-full overflow-hidden text-sm font-medium text-text hover:text-accent hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" href={ card.URL } target="_blank" rel="noopener noreferrer" aria-label={ "Open " + card.Identity.Label }>{ card.Title }</a>
				} else {
					<span class="mt-1 line-clamp-2 break-words text-sm font-medium text-text">{ card.Title }</span>
				}
				if card.ProjectID != "" {
					<span class="mt-2 inline-flex max-w-full overflow-hidden rounded-full bg-elev px-2 py-1 font-mono text-xs text-sec" title={ "Project " + card.ProjectID }>
						<span class="min-w-0 truncate">{ card.ProjectID }</span>
					</span>
				}
			</div>
			<span class="shrink-0 rounded-full bg-elev px-2 py-1 font-mono text-xs text-sec" title={ card.Identifier }>{ card.Stage }</span>
		</div>
		<div class="mt-3 grid gap-2 text-xs">
			<div class="flex flex-wrap gap-2">
				if card.MergeLaneStatus != "" {
					<span class={ "inline-flex min-h-7 items-center rounded-full border px-2 py-1 font-medium " + card.MergeLaneClass } title={ card.MergeLaneDetail }>{ card.MergeLaneStatus }</span>
				}
				<span class={ "inline-flex min-h-7 items-center rounded-full border px-2 py-1 font-medium " + card.CIClass }>CI { card.CIStatus }</span>
				<span class={ "inline-flex min-h-7 items-center rounded-full border px-2 py-1 font-medium " + card.CodexReviewClass }>Codex { card.CodexReviewState }</span>
			</div>
			if card.MergeLaneStatus != "" {
				<div class="flex min-h-7 items-center justify-between gap-3 rounded-md bg-elev/60 px-2 py-1">
					<span class="text-sec">Merge lane</span>
					<span class="min-w-0 truncate font-mono font-medium text-text" title={ card.MergeLaneDetail }>
						{ card.MergeLanePrefix }
						if card.MergeLaneRef != "" {
							@primitives.TrackerReferenceLink(card.MergeLaneRef, card.MergeLaneRefURL, "")
						}
						{ card.MergeLaneSuffix }
					</span>
				</div>
			}
			<div class="flex min-h-7 items-center justify-between gap-3 rounded-md bg-elev/60 px-2 py-1">
				<span class="text-sec">Time in stage</span>
				<span class="font-mono font-medium text-text" title={ card.TimeInStageTitle }>{ card.TimeInStage }</span>
			</div>
			if card.WaitDetail != "" {
				<div class="flex min-h-7 items-center justify-between gap-3 rounded-md bg-elev/60 px-2 py-1">
					<span class="text-sec">Waits</span>
					<span class="min-w-0 truncate font-mono font-medium text-text" title={ card.WaitDetail }>{ card.WaitDetail }</span>
				</div>
			}
		</div>
	</article>
}

templ KanbanMoveDialogContent(data KanbanMoveDialogData) {
	@dialog.Header() {
		@dialog.Title() {
			Move card
		}
		@dialog.Description() {
			@kanbanDialogCardDescription(data.Identifier, data.IssueURL, data.Title)
		}
	}
	@kanbanDialogError(data.Error)
	<form class="grid gap-4" hx-post="/api/v1/kanban/move" hx-target="#kanban-feedback" hx-swap="outerHTML">
		<input type="hidden" name="kanban_dialog" value="true"/>
		<input type="hidden" name="kanban_board" value={ data.Board }/>
		<input type="hidden" name="project_id" value={ data.ProjectID }/>
		<input type="hidden" name="issue_id" value={ data.IssueID }/>
		<input type="hidden" name="current_state" value={ data.CurrentState }/>
		<input type="hidden" name="identifier" value={ data.Identifier }/>
		<input type="hidden" name="issue_url" value={ data.IssueURL }/>
		<input type="hidden" name="title" value={ data.Title }/>
		if data.PRNumber > 0 {
			<input type="hidden" name="pr_number" value={ strconv.Itoa(data.PRNumber) }/>
		}
		<div class="grid gap-2">
			<label class="text-sm font-medium text-text" for="kanban-dialog-target-state">Target state</label>
			<select id="kanban-dialog-target-state" name="target_state" class="min-h-10 w-full rounded-md border border-line bg-page px-3 py-2 text-sm text-text focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent" data-kanban-status-menu>
				for _, state := range data.States {
					<option value={ state } selected?={ normalizeDashboardState(state) == normalizeDashboardState(kanbanMoveDialogTargetState(data)) }>{ state }</option>
				}
			</select>
		</div>
		@dialog.Footer() {
			@dialog.Close() {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Type:    button.TypeButton,
				}) {
					Cancel
				}
			}
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				@icon.MoveRight(icon.Props{Class: "size-4"})
				Move
			}
		}
	</form>
}

templ KanbanCommentDialogContent(data KanbanCommentDialogData) {
	@dialog.Header() {
		@dialog.Title() {
			Comment on { kanbanCommentTargetLabel(data.Target) }
		}
		@dialog.Description() {
			@kanbanDialogCardDescription(data.Identifier, data.IssueURL, data.Title)
			if data.Target == "pr" && data.PRNumber > 0 {
				{ " · " }
				@primitives.TrackerReferenceLink("PR #"+strconv.Itoa(data.PRNumber), data.PRURL, "font-mono")
			}
		}
	}
	@kanbanDialogError(data.Error)
	<form class="grid gap-4" hx-post="/api/v1/kanban/comment" hx-target="#kanban-feedback" hx-swap="outerHTML">
		<input type="hidden" name="kanban_dialog" value="true"/>
		<input type="hidden" name="project_id" value={ data.ProjectID }/>
		<input type="hidden" name="target" value={ data.Target }/>
		<input type="hidden" name="identifier" value={ data.Identifier }/>
		<input type="hidden" name="issue_url" value={ data.IssueURL }/>
		<input type="hidden" name="pr_url" value={ data.PRURL }/>
		<input type="hidden" name="title" value={ data.Title }/>
		if data.Target == "issue" {
			<input type="hidden" name="issue_id" value={ data.IssueID }/>
		}
		if data.Target == "pr" {
			<input type="hidden" name="pr_repository" value={ data.PRRepository }/>
			<input type="hidden" name="pr_number" value={ strconv.Itoa(data.PRNumber) }/>
		}
		<div class="grid gap-2">
			<label class="text-sm font-medium text-text" for="kanban-dialog-comment-body">Comment</label>
			<textarea id="kanban-dialog-comment-body" name="body" rows="5" class="min-h-32 w-full resize-y rounded-md border border-line bg-page px-3 py-2 text-sm text-text placeholder:text-sec focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent" placeholder={ kanbanCommentTargetLabel(data.Target) + " comment" }>{ data.Body }</textarea>
		</div>
		@dialog.Footer() {
			@dialog.Close() {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Type:    button.TypeButton,
				}) {
					Cancel
				}
			}
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				@icon.MessageSquarePlus(icon.Props{Class: "size-4"})
				Comment
			}
		}
	</form>
}

templ kanbanDialogCardDescription(identifier string, issueURL string, title string) {
	if identifier != "" {
		@primitives.TrackerReferenceLink(identifier, issueURL, "font-mono")
	}
	if identifier != "" && title != "" {
		{ " / " }
	}
	if title != "" {
		{ title }
	}
}

templ KanbanDialogErrorContent(message string) {
	@dialog.Header() {
		@dialog.Title() {
			Kanban action unavailable
		}
	}
	@kanbanDialogError(message)
	@dialog.Footer() {
		@dialog.Close() {
			@button.Button(button.Props{Variant: button.VariantOutline}) {
				Close
			}
		}
	}
}

templ kanbanDialogError(message string) {
	if message != "" {
		<div role="alert" class="rounded-md border border-err bg-err/15 px-3 py-2 text-sm text-err">{ message }</div>
	}
}

templ runningIssueMobileCard(row telemetry.Running, rowIndex int, generatedAt time.Time) {
	<article class="dashboard-card min-w-0 max-w-full overflow-hidden rounded-md border border-line bg-surface p-3 shadow-sm">
		@issueCell(row.Issue, "running-mobile", rowIndex, true)
		<div class="mt-3 grid gap-2 text-sm">
			<div class="flex min-h-10 items-center justify-between gap-3">
				<span class="text-sec">State</span>
				<span class="rounded-full bg-accent/15 px-2 py-1 font-medium text-accent">{ issueState(row.Issue, "Running") }</span>
			</div>
			<div class="flex min-h-10 items-center justify-between gap-3">
				@plainInlineLabel("Runtime / turns", "text-sec")
				<span class="font-mono text-text">{ runningRuntime(row, generatedAt) }</span>
			</div>
			<div class="flex min-h-10 items-center justify-between gap-3">
				@plainInlineLabel("Diff", "text-sec")
				<span class="font-mono text-text">{ formatDiffStat(row) }</span>
			</div>
			<div class="flex min-h-10 items-center justify-between gap-3">
				@plainInlineLabel("Tokens", "text-sec")
				<div class="grid min-w-0 justify-items-end gap-1 font-mono">
					<span class="text-text">{ formatTokens(row.Tokens) }</span>
					if contextPressureText(row.Tokens) != "" {
						<span class={ "text-xs " + boardExtraTextClass(contextPressureKind(row.Tokens)) } title={ contextPressureTitle(row.Tokens) }>{ contextPressureText(row.Tokens) }</span>
					}
				</div>
			</div>
		</div>
		<div class="mt-3">
			@runningActivityCell(row, "running-mobile")
		</div>
		<div class="mt-3">
			@sessionCopyButton(row.SessionID)
		</div>
	</article>
}

templ runningActivityCell(row telemetry.Running, prefix string) {
	<details
		class="running-activity group min-w-0 max-w-full overflow-hidden"
		data-preserve-details={ runningActivityID(prefix, row) }
		data-running-activity
	>
		<summary
			class="running-activity-trigger -m-2 flex w-full min-w-0 max-w-full cursor-pointer list-none items-start justify-between gap-2 overflow-hidden rounded-md p-2 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
			aria-controls={ runningActivityDetailsID(prefix, row) }
			data-running-activity-trigger
		>
			<span class="grid min-w-0 flex-1 basis-0 gap-1 overflow-hidden">
				<span class="line-clamp-2 break-words text-text">{ lastCodexUpdate(row) }</span>
				<span class="truncate font-mono text-xs text-sec">{ lastCodexMeta(row) }</span>
			</span>
			@icon.ChevronDown(icon.Props{Class: "running-activity-chevron mt-0.5 size-3.5 shrink-0 text-sec"})
		</summary>
		@runningActivityDetails(row, prefix)
	</details>
}

templ runningActivityDetails(row telemetry.Running, prefix string) {
	<div
		id={ runningActivityDetailsID(prefix, row) }
		class="running-activity-panel mt-3 grid min-w-0 max-w-full gap-2 overflow-hidden text-xs"
		data-running-activity-details
	>
		<div class="grid min-w-0 max-w-full gap-1.5 overflow-hidden rounded-md bg-elev/40 p-2">
			<span class="text-xs font-medium uppercase text-sec">Latest message</span>
			<p class="whitespace-pre-wrap break-words text-sm text-text">{ lastCodexUpdate(row) }</p>
			<p class="font-mono text-xs text-sec">{ lastCodexMeta(row) }</p>
		</div>
		<div class="grid min-w-0 max-w-full gap-2 overflow-hidden">
			<span class="text-xs font-medium uppercase text-sec">Recent activity</span>
			if len(runningActivityRows(row)) == 0 {
				<p class="rounded-md border border-dashed border-line bg-elev/40 px-3 py-3 text-sm text-sec">No activity recorded.</p>
			} else {
				<ol class="grid min-w-0 max-w-full gap-2 overflow-hidden">
					for _, activity := range runningActivityRows(row) {
						<li class="min-w-0 max-w-full overflow-hidden rounded-md bg-elev/40 px-3 py-2">
							<div class="flex flex-wrap items-center justify-between gap-2">
								<span class="font-mono text-xs text-sec">{ activity.At }</span>
								<span class="font-mono text-xs font-medium text-accent">{ activity.Event }</span>
							</div>
							<p class="mt-1 whitespace-pre-wrap break-words text-sm text-text">{ activity.Message }</p>
						</li>
					}
				</ol>
			}
		</div>
	</div>
}

templ boardHealthSection(snapshot telemetry.Snapshot) {
	<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5" aria-label="Board health">
		<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
			<div class="min-w-0">
				@helpHeading2("Board health", helpBoardHealth, "board-health")
				<p class="text-sm text-sec">Current issue state distribution and completed session history from the latest snapshot.</p>
			</div>
			<span class="inline-flex min-h-9 min-w-9 shrink-0 items-center justify-center rounded-full bg-accent/15 px-2 py-1 text-sm font-medium text-accent">{ boardStateTotalLabel(snapshot) }</span>
		</div>
		<div class="mt-5 grid min-w-0 gap-5 lg:grid-cols-[minmax(0,1fr)_20rem]">
			<div class="min-w-0">
				<div class="flex items-center justify-between gap-3">
					@helpHeading3("Current issue states", helpStateDistribution, "board-health")
					<span class="font-mono text-xs text-sec">{ boardStateTotalLabel(snapshot) } issues</span>
				</div>
				if len(boardStateRows(snapshot)) == 0 {
					<div class="mt-3">
						@dashboardEmptyState("No board states recorded.", "Project state distribution will appear after the next tracker snapshot.", "bg-accent")
					</div>
				} else {
					<div class="mt-3">
						@TimelineChart(boardDistributionChart(snapshot))
					</div>
					<div class="mt-4 grid gap-2 sm:grid-cols-2">
						for _, row := range boardStateRows(snapshot) {
							<div class="flex min-w-0 items-center justify-between gap-3 rounded-md bg-elev/60 px-3 py-2">
								<span class="inline-flex min-w-0 items-center gap-2">
									<span class={ "h-2 w-2 shrink-0 rounded-full " + row.DotClass }></span>
									<span class="truncate text-sm font-medium text-text">{ row.State }</span>
								</span>
								<span class="shrink-0 font-mono text-sm text-sec">{ row.CountLabel } / { row.Percent }</span>
							</div>
						}
					</div>
				}
			</div>
			<div class="min-w-0">
				<div class="flex items-center justify-between gap-3">
					@helpHeading3("Session completions", helpCumulativeFlow, "board-health")
					<span class="font-mono text-xs text-sec">{ boardProgressCount(snapshot) } sessions</span>
				</div>
				if len(telemetry.BoardProgressPoints(snapshot)) == 0 {
					<div class="mt-3">
						@dashboardEmptyState("No completed session history yet.", "Session completion progress appears after completed session samples arrive.", "bg-ok")
					</div>
				} else {
					<div class="mt-3">
						@LineAreaChart(boardProgressChart(snapshot))
					</div>
				}
			</div>
		</div>
	</section>
}

templ cycleTimeSection(report telemetry.CycleTimeReport) {
	<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5" aria-label="Cycle time">
		<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
			<div class="min-w-0">
				@helpHeading2("Cycle time", helpCycleTime, "cycle-time")
				<p class="text-sm text-sec">Completed issue durations from local run history.</p>
			</div>
			<span class="inline-flex min-h-9 min-w-9 shrink-0 items-center justify-center rounded-full bg-ok/15 px-2 py-1 text-sm font-medium text-ok">{ cycleTimeCountLabel(report) }</span>
		</div>
		if !report.Available && report.DegradedReason != "" {
			<div class="mt-4">
				@dashboardEmptyState("Cycle-time data unavailable.", cycleTimeUnavailableDetail(report), "bg-dim")
			</div>
		} else if len(report.Buckets) == 0 {
			<div class="mt-4">
				@dashboardEmptyState("No completed issues yet.", "Cycle-time histogram appears after completed issue history is recorded.", "bg-ok")
			</div>
		} else {
			<div class="mt-5 grid min-w-0 gap-5 lg:grid-cols-[minmax(0,1fr)_18rem]">
				<div class="min-w-0">
					<div class="flex items-center justify-between gap-3">
						@helpHeading3("Histogram", helpCycleTime, "cycle-time")
						<span class="font-mono text-xs text-sec">{ cycleTimeCountLabel(report) }</span>
					</div>
					<div class="mt-3">
						@MiniBarChart(cycleTimeHistogramChart(report))
					</div>
				</div>
				<div class="grid min-w-0 content-start gap-3">
					<div class="rounded-md bg-elev/60 px-3 py-2">
						<span class="block text-xs font-medium uppercase text-sec">Average</span>
						<strong class="font-mono text-lg font-semibold text-text">{ cycleTimeAverageLabel(report) }</strong>
					</div>
					<div class="grid gap-2">
						for _, row := range cycleTimeBucketRows(report) {
							<div class="flex min-w-0 items-center justify-between gap-3 rounded-md bg-elev/60 px-3 py-2 text-sm">
								<span class="truncate font-medium text-text">{ row.Label }</span>
								<span class="shrink-0 font-mono text-sec">{ row.Count }</span>
							</div>
						}
					</div>
				</div>
			</div>
		}
	</section>
}

templ workflowMetricsSection(report telemetry.WorkflowMetrics, project telemetry.Project) {
	<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5" aria-label="Workflow metrics">
		<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
			<div class="min-w-0">
				@helpHeading2("Workflow metrics", helpWorkflowMetrics, "workflow-metrics")
				<p class="text-sm text-sec">Lane timing, observable sub-phases, oldest cards, and the active bottleneck from local runtime telemetry.</p>
			</div>
			<span class="inline-flex min-h-9 min-w-9 shrink-0 items-center justify-center rounded-full bg-accent/15 px-2 py-1 text-sm font-medium text-accent">{ workflowMetricsSummaryLabel(report) }</span>
		</div>
		if !workflowMetricsAvailable(report) {
			<div class="mt-4">
				@dashboardEmptyState("Workflow metrics unavailable.", workflowMetricsUnavailableDetail(report), "bg-dim")
			</div>
		} else if len(workflowLaneMetricRows(report, project)) == 0 && len(workflowOldestCardRows(report)) == 0 {
			<div class="mt-4">
				@dashboardEmptyState(workflowMetricsEmptyHistoryTitle(report), workflowMetricsEmptyHistoryDetail(report), "bg-accent")
			</div>
		} else {
			<div class="mt-5 grid min-w-0 gap-5 xl:grid-cols-[minmax(0,1fr)_20rem]">
				<div class="grid min-w-0 gap-5">
					<div class="grid min-w-0 gap-5 xl:grid-cols-2">
						<div class="min-w-0">
							<div class="flex items-center justify-between gap-3">
								@helpHeading3("Average lane trend", helpWorkflowMetrics, "workflow-metrics")
								if len(workflowLaneTrendCards(report)) > 0 {
									<span class="font-mono text-xs text-sec">{ workflowLaneTrendCards(report)[0].Window }</span>
								}
							</div>
							if len(workflowLaneTrendCards(report)) == 0 {
								<div class="mt-3">
									@dashboardEmptyState("No lane trend samples.", "Completed lane exits will populate per-lane average charts here.", "bg-accent")
								</div>
							} else {
								<div class="mt-3 grid gap-2 sm:grid-cols-2">
									for _, card := range workflowLaneTrendCards(report) {
										<div class="grid min-w-0 gap-2 rounded-md bg-elev/60 px-3 py-3">
											<div class="flex min-w-0 items-center justify-between gap-3">
												<span class="truncate text-sm font-medium text-text">{ card.Lane }</span>
												<span class="shrink-0 font-mono text-xs text-sec">{ card.Summary }</span>
											</div>
											if card.HasData {
												@LineAreaChart(card.Chart)
											} else {
												<div class="flex h-24 items-center justify-center rounded-md border border-line bg-surface/60 px-3 text-center text-xs text-sec">No samples</div>
											}
										</div>
									}
								</div>
							}
						</div>
						<div class="min-w-0">
							<div class="flex items-center justify-between gap-3">
								@helpHeading3("Flow efficiency", helpWorkflowMetrics, "workflow-metrics")
								if len(workflowLaneFlowRows(report)) > 0 {
									<span class="font-mono text-xs text-sec">{ workflowLaneFlowRows(report)[0].Window }</span>
								}
							</div>
							if len(workflowLaneFlowRows(report)) == 0 {
								<div class="mt-3">
									@dashboardEmptyState("No flow-efficiency samples.", "Active and wait splits appear after lane exits overlap observable work phases.", "bg-accent")
								</div>
							} else {
								<div class="mt-3 grid gap-2">
									<div class="flex items-center justify-end gap-3 text-xs text-sec">
										<span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-accent"></span>Active</span>
										<span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-warn"></span>Wait</span>
									</div>
									for _, row := range workflowLaneFlowRows(report) {
										<div class="grid gap-2 rounded-md bg-elev/60 px-3 py-2 text-sm">
											<div class="flex min-w-0 items-center justify-between gap-3">
												<span class="truncate font-medium text-text">{ row.Lane }</span>
												<span class="shrink-0 rounded-full bg-accent/15 px-2 py-1 font-mono text-xs font-semibold text-accent">{ row.ActivePercent }</span>
											</div>
											if row.HasData {
												<div class="h-2 overflow-hidden rounded-full bg-border" role="img" aria-label={ row.Lane + " active versus wait time" }>
													<div class="flex h-full">
														<span class="h-full bg-accent" style={ row.ActiveStyle } title={ row.ActiveSegmentTitle } aria-label={ row.ActiveSegmentTitle }></span>
														<span class="h-full bg-warn" style={ row.WaitStyle } title={ row.WaitSegmentTitle } aria-label={ row.WaitSegmentTitle }></span>
													</div>
												</div>
												<div class="grid grid-cols-3 gap-2 font-mono text-xs text-sec">
													<span>{ row.Active } active</span>
													<span>{ row.Wait } wait</span>
													<span class="text-right">{ row.Total } total</span>
												</div>
											} else {
												<div class="flex h-10 items-center rounded-md border border-line bg-surface/60 px-3 text-xs text-sec">No samples</div>
											}
										</div>
									}
								</div>
							}
						</div>
					</div>
					<div class="min-w-0">
						<div class="flex items-center justify-between gap-3">
							@helpHeading3("Lane trends", helpWorkflowMetrics, "workflow-metrics")
							<span class="font-mono text-xs text-sec">24h / 7d / 30d</span>
						</div>
						if len(workflowLaneMetricRows(report, project)) == 0 {
							<div class="mt-3">
								@dashboardEmptyState("No lane duration aggregates.", "Completed lane exits will populate p50 and p90 timing here.", "bg-accent")
							</div>
						} else {
							<div class="mt-3 overflow-hidden rounded-md border border-line">
								<div class="max-h-72 overflow-auto" data-preserve-scroll="workflow-lanes">
									<table class="min-w-full text-left text-sm">
										<thead class="sticky top-0 bg-elev text-xs uppercase text-sec">
											<tr>
												<th class="px-3 py-2 font-medium">Window</th>
												<th class="px-3 py-2 font-medium">Lane</th>
												<th class="px-3 py-2 font-medium">Comparison</th>
												<th class="px-3 py-2 font-medium">Trend</th>
												<th class="px-3 py-2 text-right font-medium">Delta</th>
												<th class="px-3 py-2 text-right font-medium">Count</th>
												<th class="px-3 py-2 text-right font-medium">Avg</th>
												<th class="px-3 py-2 text-right font-medium">P50</th>
												<th class="px-3 py-2 text-right font-medium">P90</th>
												<th class="px-3 py-2 text-right font-medium">P95</th>
												<th class="px-3 py-2 text-right font-medium">Action</th>
											</tr>
										</thead>
										<tbody class="divide-y divide-border">
											for _, row := range workflowLaneMetricRows(report, project) {
												<tr class={ row.RowClass }>
													<td class="px-3 py-2 font-mono text-xs text-sec">{ row.Window }</td>
													<td class="px-3 py-2 font-medium text-text">
														<div class="flex min-w-0 items-center gap-2">
															<span class="truncate">{ row.Lane }</span>
															if row.Bottleneck {
																<span class="shrink-0 rounded-full bg-warn/15 px-2 py-1 text-xs font-semibold text-warn">Bottleneck</span>
															}
														</div>
													</td>
													<td class="px-3 py-2 font-mono text-xs text-sec">{ row.Comparison }</td>
													<td class="px-3 py-2"><span class={ row.TrendClass }>{ row.Trend }</span></td>
													<td class="px-3 py-2 text-right font-mono text-sec">{ row.Delta }</td>
													<td class="px-3 py-2 text-right font-mono text-sec">{ row.Count }</td>
													<td class="px-3 py-2 text-right font-mono text-sec">{ row.Average }</td>
													<td class="px-3 py-2 text-right font-mono text-text">{ row.P50 }</td>
													<td class="px-3 py-2 text-right font-mono text-text">{ row.P90 }</td>
													<td class="px-3 py-2 text-right font-mono text-sec">{ row.P95 }</td>
													<td class="px-3 py-2 text-right">
														if row.Prompt != "" {
															@diagnosticPromptCopyButton(row.Prompt, "Copy prompt", "Copy diagnostic prompt for "+row.Lane)
														}
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							</div>
						}
					</div>
					<div class="min-w-0">
						<div class="flex items-center justify-between gap-3">
							@helpHeading3("Observable sub-phases", helpWorkflowMetrics, "workflow-metrics")
							<span class="font-mono text-xs text-sec">AI / checks / CI / backoff</span>
						</div>
						if len(workflowSubphaseMetricRows(report)) == 0 {
							<div class="mt-3">
								@dashboardEmptyState("No sub-phase aggregates yet.", "AI sessions, local checks, CI, merge queue, and rate-limit events appear as Detent observes them.", "bg-accent")
							</div>
						} else {
							<div class="mt-3 grid gap-2 sm:grid-cols-2">
								for _, row := range workflowSubphaseMetricRows(report) {
									<div class="grid gap-1 rounded-md bg-elev/60 px-3 py-2 text-sm">
										<div class="flex min-w-0 items-center justify-between gap-3">
											<span class="truncate font-medium text-text">{ row.Phase }</span>
											<span class="font-mono text-xs text-sec">{ row.Window }</span>
										</div>
										<div class="grid grid-cols-3 gap-2 font-mono text-xs text-sec">
											<span>{ row.Count } runs</span>
											<span>{ row.Total }</span>
											<span>{ row.Mean } avg</span>
										</div>
										<span class="truncate text-xs text-sec">{ row.Detail }</span>
									</div>
								}
							</div>
						}
					</div>
				</div>
				<aside class="grid min-w-0 content-start gap-4">
					<div class="rounded-md bg-elev/60 px-3 py-3">
						<span class="block text-xs font-medium uppercase text-sec">Active bottleneck</span>
						<strong class="mt-1 block text-lg font-semibold text-text">{ workflowBottleneck(report).Label }</strong>
						<span class="mt-1 block font-mono text-sm text-sec">{ workflowBottleneck(report).Value }</span>
						<p class="mt-2 text-sm text-sec">{ workflowBottleneck(report).Detail }</p>
						if workflowBottleneck(report).Count != "" {
							<span class="mt-2 inline-block font-mono text-xs text-sec">{ workflowBottleneck(report).Count }</span>
						}
						if workflowBottleneckDiagnosticPrompt(project, report) != "" {
							<div class="mt-3">
								@diagnosticPromptCopyButton(workflowBottleneckDiagnosticPrompt(project, report), "Copy diagnostic prompt", "Copy diagnostic prompt")
							</div>
						}
					</div>
					<div class="min-w-0">
						<div class="flex items-center justify-between gap-3">
							@helpHeading3("Oldest cards", helpWorkflowMetrics, "workflow-metrics")
							<span class="font-mono text-xs text-sec">{ strconv.Itoa(len(workflowOldestCardRows(report))) }</span>
						</div>
						if len(workflowOldestCardRows(report)) == 0 {
							<div class="mt-3">
								@dashboardEmptyState("No live card ages.", "Visible cards will appear after the next tracker snapshot.", "bg-accent")
							</div>
						} else {
							<div class="mt-3 grid gap-2">
								for _, row := range workflowOldestCardRows(report) {
									<div class="grid gap-1 rounded-md bg-elev/60 px-3 py-2 text-sm">
										<div class="flex min-w-0 items-start gap-2">
											<div class="min-w-0 flex-1">
												@primitives.TrackerReferenceLink(row.Identifier, row.URL, "block truncate font-medium text-text")
												<span class="block truncate text-xs text-sec">{ row.Title }</span>
											</div>
											if row.URL != "" {
												@issueOpenLink(row.URL, "Open issue "+row.Identifier, true)
											}
										</div>
										<div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-sec">
											<span>{ row.State }</span>
											if row.ProjectID != "" {
												<span>{ row.ProjectID }</span>
											}
											<span>{ row.Age }</span>
											<span>{ row.Key }</span>
										</div>
									</div>
								}
							</div>
						}
					</div>
				</aside>
			</div>
		}
	</section>
}

templ agentActivityTimeline(snapshot telemetry.Snapshot) {
	<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5" aria-label="Agent activity timeline">
		@panelHeader(icon.Activity(icon.Props{Class: "size-4 shrink-0"}), "Agent activity", helpAgentActivity, "agent-activity") {
			<span class="inline-flex min-h-9 min-w-9 shrink-0 items-center justify-center rounded-full bg-accent/15 px-2 py-1 text-sm font-medium text-accent">{ formatCount(len(agentTimelineRows(snapshot))) }</span>
		}
		if len(agentTimelineRows(snapshot)) == 0 {
			if runningCount(snapshot)+completedCount(snapshot) > 0 {
				<div class="mt-4">
					@dashboardEmptyState("Agent timeline details are unavailable.", "Summary counts are live, but session timing rows have not arrived in this snapshot.", "bg-accent")
				</div>
			} else {
				<div class="mt-4">
					@dashboardEmptyState("No agent activity recorded.", "Running and completed session timelines will appear here.", "bg-accent")
				</div>
			}
		} else {
			<div class="mt-4 grid gap-3 sm:hidden">
				for _, row := range agentTimelineRows(snapshot) {
					@agentActivityMobileCard(row)
				}
			</div>
			<div class="mt-4 hidden overflow-hidden rounded-md border border-line sm:block">
				<div class="dashboard-agent-scroll max-h-[32rem] overflow-x-auto overflow-y-auto" data-preserve-scroll="agent-activity">
					<div class="min-w-[78rem]">
						<div class="grid grid-cols-[25rem_minmax(0,1fr)_12rem] gap-3 border-b border-line bg-elev/70 px-3 py-3 text-xs font-medium uppercase text-sec">
							<span>Agent</span>
							<span>Lifespan</span>
							<span class="text-right">State / runtime</span>
						</div>
						for _, row := range agentTimelineRows(snapshot) {
							<div class="agent-activity-table-row grid min-h-14 grid-cols-[25rem_minmax(0,1fr)_12rem] items-center gap-3 border-b border-line px-3 py-3 last:border-b-0" data-agent-identity={ row.Identity.Label }>
								<div class="flex min-w-0 items-start gap-2">
									<div class="min-w-0 flex-1">
										@issueIdentityLine(row.Identity, false)
										<span class="line-clamp-2 break-words text-sm text-sec">{ row.Title }</span>
									</div>
									@agentTimelineActions(row)
								</div>
								<div class="grid gap-1">
									<div class="flex items-center justify-between gap-3 font-mono text-xs text-sec">
										<span>{ row.StartedAt }</span>
										<span>{ row.EndedAt }</span>
									</div>
									<div class="relative h-9 overflow-hidden rounded-md bg-elev" role="group" aria-label={ row.Identifier + " lifespan" }>
										for _, segment := range row.Segments {
											<span class={ "absolute bottom-1 top-1 min-w-1.5 rounded " + segment.Class } style={ segment.Style } title={ segment.Title } aria-label={ segment.Title }>
												<span class="sr-only">{ segment.Title }</span>
											</span>
										}
									</div>
								</div>
								<div class="grid justify-items-end gap-1">
									<span class="rounded-full bg-elev px-2 py-1 text-xs font-medium text-sec">{ row.State }</span>
									<span class="font-mono text-xs text-sec">{ row.Duration }</span>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		}
	</section>
}

templ agentActivityMobileCard(row agentTimelineRow) {
	<article class="dashboard-card min-w-0 max-w-full overflow-hidden rounded-md border border-line bg-surface p-3 shadow-sm" data-agent-identity={ row.Identity.Label }>
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0 flex-1">
				@issueIdentityLine(row.Identity, false)
				<span class="line-clamp-2 break-words text-sm text-sec">{ row.Title }</span>
			</div>
			<div class="flex shrink-0 items-start gap-1">
				@agentTimelineActions(row)
				<span class="rounded-full bg-elev px-2 py-1 text-xs font-medium text-sec">{ row.State }</span>
			</div>
		</div>
		<div class="mt-3 grid gap-1">
			<div class="flex items-center justify-between gap-3 font-mono text-xs text-sec">
				<span>{ row.StartedAt }</span>
				<span>{ row.EndedAt }</span>
			</div>
			<div class="relative h-9 overflow-hidden rounded-md bg-elev" role="group" aria-label={ row.Identifier + " lifespan" }>
				for _, segment := range row.Segments {
					<span class={ "absolute bottom-1 top-1 min-w-1.5 rounded " + segment.Class } style={ segment.Style } title={ segment.Title } aria-label={ segment.Title }>
						<span class="sr-only">{ segment.Title }</span>
					</span>
				}
			</div>
		</div>
		<div class="mt-3 font-mono text-xs text-sec">{ row.Duration }</div>
	</article>
}

templ agentTimelineActions(row agentTimelineRow) {
	if row.IssueURL != "" || row.PullRequestURL != "" {
		<div class="flex shrink-0 items-center gap-1">
			if row.IssueURL != "" {
				@issueOpenLink(row.IssueURL, "Open issue "+row.Identifier, true)
			}
			if row.PullRequestURL != "" {
				@pullRequestOpenLink(row.PullRequestURL, pullRequestOpenLabelForNumber(row.PullRequestNumber), true)
			}
		</div>
	}
}

templ retryQueueSection(snapshot telemetry.Snapshot) {
	<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5">
		@panelHeader(icon.ListRestart(icon.Props{Class: "size-4 shrink-0"}), "Retry queue", helpBackoffQueue, "retry-queue") {
			<span class="inline-flex min-h-9 min-w-9 shrink-0 items-center justify-center rounded-full bg-warn/15 px-2 py-1 text-sm font-medium text-warn">{ formatCount(queueCount(snapshot)) }</span>
		}
		if len(snapshot.Queue) == 0 {
			if queueCount(snapshot) > 0 {
				<div class="mt-4">
					@dashboardEmptyState("Retry queue details are unavailable.", "The queue count is live, but retry rows have not arrived in this snapshot.", "bg-warn")
				</div>
			} else {
				<div class="mt-4">
					@dashboardEmptyState("No issues are currently backing off.", "Retrying work will appear here with its next due time.", "bg-warn")
				</div>
			}
		} else {
			<div class="mt-4 grid gap-3 sm:hidden">
				for i, row := range snapshot.Queue {
					@retryQueueMobileCard(row, i)
				}
			</div>
			<div class="mt-4 hidden overflow-hidden rounded-md border border-line sm:block">
				<div class="overflow-x-auto" data-preserve-scroll="retry-queue">
					<table class="dashboard-table w-full min-w-[54rem] table-fixed border-collapse text-sm">
						<thead class="bg-elev/70">
							<tr class="border-b border-line text-left text-xs font-medium uppercase text-sec">
								<th class="w-[24rem] px-3 py-3 font-medium">Issue</th>
								<th class="w-[7rem] px-3 py-3 font-medium">Attempt</th>
								<th class="w-[13rem] px-3 py-3 font-medium">Due time</th>
								<th class="px-3 py-3 font-medium">
									@plainInlineLabel("Error", "")
								</th>
							</tr>
						</thead>
						<tbody>
							for i, row := range snapshot.Queue {
								<tr class="border-b border-line transition-colors last:border-b-0 hover:bg-elev/50">
									<td class="px-3 py-4 align-top">
										@issueCell(row.Issue, "retry", i, true)
									</td>
									<td class="px-3 py-4 align-top font-mono text-text">{ formatInt(int64(row.Attempt)) }</td>
									<td class="px-3 py-4 align-top font-mono text-sec">{ queuedDueLabel(row) }</td>
									<td class="px-3 py-4 align-top text-sec">
										<span class="line-clamp-3">{ rowError(row.Error) }</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</section>
}

templ schedulerRuntimeSection(snapshot telemetry.Snapshot) {
	<section id="scheduler-runtime" class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5">
		<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
			<div class="min-w-0">
				@helpHeading2("Scheduler runtime", helpWorkflowMetrics, "scheduler-runtime")
				<p class="text-sm text-sec">Durable attempts, leases, and recent scheduling decisions.</p>
			</div>
			<span class="inline-flex min-h-9 min-w-9 shrink-0 items-center justify-center rounded-full bg-accent/15 px-2 py-1 text-sm font-medium text-accent">{ schedulerRuntimeCount(snapshot) }</span>
		</div>
		if len(schedulerWorkAttemptRows(snapshot)) == 0 && len(schedulerDecisionRows(snapshot)) == 0 {
			<div class="mt-4">
				@dashboardEmptyState("No scheduler runtime records yet.", "Attempts and candidate decisions appear after the scheduler reconciles work.", "bg-accent")
			</div>
		} else {
			<div class="mt-4 grid gap-4 xl:grid-cols-2">
				<div class="min-w-0">
					<div class="mb-2 flex items-center justify-between gap-3">
						<h3 class="text-sm font-medium text-text">Work attempts</h3>
						<span class="font-mono text-xs text-sec">{ formatCount(len(schedulerWorkAttemptRows(snapshot))) }</span>
					</div>
					if len(schedulerWorkAttemptRows(snapshot)) == 0 {
						@dashboardEmptyState("No work attempts recorded.", "Active and recovered leases will appear here.", "bg-accent")
					} else {
						<div class="grid gap-2">
							for _, row := range schedulerWorkAttemptRows(snapshot) {
								<article class="rounded-md border border-line bg-elev/30 p-3">
									<div class="flex min-w-0 items-start justify-between gap-3">
										<div class="min-w-0">
											@primitives.TrackerReferenceLink(workAttemptIssueLabel(row), row.IssueURL, "block truncate font-mono text-sm font-medium text-text")
											<div class="mt-1 truncate text-xs text-sec">{ workAttemptWorkerLabel(row) }</div>
										</div>
										<span class={ workAttemptStatusClass(row) }>{ workAttemptStatusLabel(row) }</span>
									</div>
									<div class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
										<div class="min-w-0">
											<span class="block text-xs font-medium uppercase text-sec">Phase</span>
											<span class="block truncate font-mono text-text">{ workAttemptPhaseLabel(row) }</span>
										</div>
										<div class="min-w-0">
											<span class="block text-xs font-medium uppercase text-sec">Wait</span>
											<span class="block truncate font-mono text-text">{ workAttemptWaitLabel(row) }</span>
										</div>
										<div class="min-w-0">
											<span class="block text-xs font-medium uppercase text-sec">Lease</span>
											<span class="block truncate font-mono text-text">{ workAttemptLeaseLabel(row, snapshot.GeneratedAt) }</span>
										</div>
										<div class="min-w-0">
											<span class="block text-xs font-medium uppercase text-sec">Next</span>
											<span class="block truncate font-mono text-text">{ workAttemptNextActionLabel(row) }</span>
										</div>
									</div>
									<div class="mt-3 flex flex-wrap items-center gap-2">
										<button class="inline-flex min-h-8 items-center rounded-md border border-line bg-surface px-2.5 py-1 text-xs font-medium text-text transition-colors hover:bg-elev" type="button" hx-get={ workAttemptReceiptPath(row) } hx-target={ workAttemptRecoveryTarget(row) } hx-swap="innerHTML">Receipt</button>
										for _, control := range workAttemptRecoveryControls(row) {
											<form class="inline-flex" hx-post={ workAttemptRecoveryPath(row) } hx-target={ workAttemptRecoveryTarget(row) } hx-swap="innerHTML" { workAttemptRecoveryConfirmAttributes(control)... }>
												<input type="hidden" name="action" value={ control.Action }/>
												if control.ConfirmPayload {
													<input type="hidden" name="confirm" value="true"/>
												}
												<button class={ workAttemptRecoveryButtonClass(control) } type="submit" title={ control.Title }>{ control.Label }</button>
											</form>
										}
									</div>
									<div id={ workAttemptRecoveryFeedbackID(row) } class="mt-2 min-h-5 text-xs text-sec" aria-live="polite"></div>
								</article>
							}
						</div>
					}
				</div>
				<div class="min-w-0">
					<div class="mb-2 flex items-center justify-between gap-3">
						<h3 class="text-sm font-medium text-text">Candidate decisions</h3>
						<span class="font-mono text-xs text-sec">{ formatCount(len(schedulerDecisionRows(snapshot))) }</span>
					</div>
					if len(schedulerDecisionRows(snapshot)) == 0 {
						@dashboardEmptyState("No candidate decisions recorded.", "Selected and skipped candidates will appear here.", "bg-warn")
					} else {
						<div class="grid gap-2">
							for _, row := range schedulerDecisionRows(snapshot) {
								<article class="rounded-md border border-line bg-elev/30 p-3">
									<div class="flex min-w-0 items-start justify-between gap-3">
										<div class="min-w-0">
											@primitives.TrackerReferenceLink(schedulerDecisionIssueLabel(row), row.IssueURL, "block truncate font-mono text-sm font-medium text-text")
											<div class="mt-1 truncate text-xs text-sec">{ schedulerDecisionLaneLabel(row) }</div>
										</div>
										<span class={ schedulerDecisionStatusClass(row) }>{ schedulerDecisionStatusLabel(row) }</span>
									</div>
									<div class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
										<div class="min-w-0">
											<span class="block text-xs font-medium uppercase text-sec">Reason</span>
											<span class="block truncate font-mono text-text">{ schedulerDecisionReasonLabel(row) }</span>
										</div>
										<div class="min-w-0">
											<span class="block text-xs font-medium uppercase text-sec">Wait</span>
											<span class="block truncate font-mono text-text">{ schedulerDecisionWaitLabel(row) }</span>
										</div>
										<div class="min-w-0">
											<span class="block text-xs font-medium uppercase text-sec">Queue</span>
											<span class="block truncate font-mono text-text">{ schedulerDecisionQueueLabel(row) }</span>
										</div>
										<div class="min-w-0">
											<span class="block text-xs font-medium uppercase text-sec">At</span>
											<span class="block truncate font-mono text-text">{ schedulerDecisionTimeLabel(row) }</span>
										</div>
									</div>
								</article>
							}
						</div>
					}
				</div>
			</div>
		}
	</section>
}

templ retryQueueMobileCard(row telemetry.Queued, rowIndex int) {
	<article class="dashboard-card rounded-md border border-line bg-surface p-3 shadow-sm">
		@issueCell(row.Issue, "retry-mobile", rowIndex, true)
		<div class="mt-3 grid gap-2 text-sm">
			<div class="flex min-h-10 items-center justify-between gap-3">
				<span class="text-sec">Attempt</span>
				<span class="font-mono text-text">{ formatInt(int64(row.Attempt)) }</span>
			</div>
			<div class="flex min-h-10 items-center justify-between gap-3">
				<span class="text-sec">Due time</span>
				<span class="font-mono text-text">{ queuedDueLabel(row) }</span>
			</div>
		</div>
		<div class="mt-3 rounded-md bg-elev/60 p-3 text-sm text-sec">
			<span class="line-clamp-4">{ rowError(row.Error) }</span>
		</div>
	</article>
}

templ blockedSessionsSection(snapshot telemetry.Snapshot) {
	<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5">
		@panelHeader(icon.CircleAlert(icon.Props{Class: "size-4 shrink-0"}), "Blocked sessions", helpBlocked, "blocked-sessions") {
			<span class="inline-flex min-h-9 min-w-9 shrink-0 items-center justify-center rounded-full bg-err/15 px-2 py-1 text-sm font-medium text-err">{ formatCount(blockedCount(snapshot)) }</span>
		}
		if len(snapshot.Blocked) == 0 {
			if blockedCount(snapshot) > 0 {
				<div class="mt-4">
					@dashboardEmptyState("Blocked session details are unavailable.", "The blocked count is live, but detailed rows have not arrived in this snapshot.", "bg-err")
				</div>
			} else {
				<div class="mt-4">
					@dashboardEmptyState("No blocked sessions.", "Operator requests and approval waits will appear here.", "bg-err")
				</div>
			}
		} else {
			<div class="mt-4 grid gap-3 sm:hidden">
				for i, row := range snapshot.Blocked {
					@blockedSessionMobileCard(row, i)
				}
			</div>
			<div class="mt-4 hidden overflow-hidden rounded-md border border-line sm:block">
				<div class="overflow-x-auto" data-preserve-scroll="blocked-sessions">
					<table class="dashboard-table w-full min-w-[68rem] table-fixed border-collapse text-sm">
						<thead class="bg-elev/70">
							<tr class="border-b border-line text-left text-xs font-medium uppercase text-sec">
								<th class="w-[24rem] px-3 py-3 font-medium">Issue</th>
								<th class="w-[9rem] px-3 py-3 font-medium">State</th>
								<th class="w-[11rem] px-3 py-3 font-medium">
									@plainInlineLabel("Session", "")
								</th>
								<th class="w-[13rem] px-3 py-3 font-medium">Blocked time</th>
								<th class="px-3 py-3 font-medium">
									@plainInlineLabel("Last update", "")
								</th>
								<th class="w-[14rem] px-3 py-3 font-medium">
									@plainInlineLabel("Error", "")
								</th>
							</tr>
						</thead>
						<tbody>
							for i, row := range snapshot.Blocked {
								<tr class="border-b border-line transition-colors last:border-b-0 hover:bg-elev/50">
									<td class="px-3 py-4 align-top">
										@issueCell(row.Issue, "blocked", i, true)
									</td>
									<td class="px-3 py-4 align-top">
										<span class="inline-flex rounded-full bg-err/15 px-2 py-1 font-medium text-err">{ issueState(row.Issue, "Blocked") }</span>
									</td>
									<td class="px-3 py-4 align-top">
										@sessionCopyButton(row.SessionID)
									</td>
									<td class="px-3 py-4 align-top font-mono text-sec">{ blockedAtLabel(row) }</td>
									<td class="px-3 py-4 align-top">
										<div class="grid gap-1">
											<span class="line-clamp-2 text-text">{ blockedLastUpdate(row) }</span>
											<span class="font-mono text-xs text-sec">{ blockedLastUpdateMeta(row) }</span>
										</div>
									</td>
									<td class="px-3 py-4 align-top text-sec">
										<span class="line-clamp-3">{ rowError(row.Error) }</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</section>
}

templ blockedSessionMobileCard(row telemetry.Blocked, rowIndex int) {
	<article class="dashboard-card rounded-md border border-line bg-surface p-3 shadow-sm">
		@issueCell(row.Issue, "blocked-mobile", rowIndex, true)
		<div class="mt-3 grid gap-2 text-sm">
			<div class="flex min-h-10 items-center justify-between gap-3">
				<span class="text-sec">State</span>
				<span class="rounded-full bg-err/15 px-2 py-1 font-medium text-err">{ issueState(row.Issue, "Blocked") }</span>
			</div>
			<div class="flex min-h-10 items-center justify-between gap-3">
				<span class="text-sec">Blocked time</span>
				<span class="font-mono text-text">{ blockedAtLabel(row) }</span>
			</div>
		</div>
		<div class="mt-3 rounded-md bg-elev/60 p-3">
			<span class="line-clamp-3 text-sm text-text">{ blockedLastUpdate(row) }</span>
			<span class="mt-1 block font-mono text-xs text-sec">{ blockedLastUpdateMeta(row) }</span>
		</div>
		<div class="mt-3 rounded-md bg-elev/60 p-3 text-sm text-sec">
			<span class="line-clamp-4">{ rowError(row.Error) }</span>
		</div>
		<div class="mt-3">
			@sessionCopyButton(row.SessionID)
		</div>
	</article>
}

templ recentSessionsSection(snapshot telemetry.Snapshot) {
	<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5">
		@panelHeader(icon.ClockCheck(icon.Props{Class: "size-4 shrink-0"}), "Recent sessions", helpRecentSessions, "recent-sessions") {
			<span class="inline-flex min-h-9 min-w-9 shrink-0 items-center justify-center rounded-full bg-ok/15 px-2 py-1 text-sm font-medium text-ok">{ formatCount(completedCount(snapshot)) }</span>
		}
		if len(snapshot.Completed) == 0 {
			if completedCount(snapshot) > 0 {
				<div class="mt-4">
					@dashboardEmptyState("Completed session details are unavailable.", "The completed count is live, but session rows have not arrived in this snapshot.", "bg-ok")
				</div>
			} else {
				<div class="mt-4">
					@dashboardEmptyState("No completed sessions recorded.", "Finished Codex sessions will appear here after work completes.", "bg-ok")
				</div>
			}
		} else {
			<div class="mt-4 grid gap-3 sm:hidden">
				for i, row := range snapshot.Completed {
					@recentSessionMobileCard(row, i)
				}
			</div>
			<div class="mt-4 hidden overflow-hidden rounded-md border border-line sm:block">
				<div class="overflow-x-auto" data-preserve-scroll="recent-sessions">
					<table class="dashboard-table w-full min-w-[74rem] table-fixed border-collapse text-sm">
						<thead class="bg-elev/70">
							<tr class="border-b border-line text-left text-xs font-medium uppercase text-sec">
								<th class="w-[24rem] px-3 py-3 font-medium">Issue</th>
								<th class="w-[13rem] px-3 py-3 font-medium">Completed</th>
								<th class="w-[11rem] px-3 py-3 font-medium">
									@plainInlineLabel("Runtime / turns", "")
								</th>
								<th class="w-[10rem] px-3 py-3 font-medium">
									@plainInlineLabel("Tokens", "")
								</th>
								<th class="w-[10rem] px-3 py-3 font-medium">Final state</th>
								<th class="w-[11rem] px-3 py-3 font-medium">Model</th>
								<th class="w-[11rem] px-3 py-3 font-medium">
									@plainInlineLabel("Session", "")
								</th>
							</tr>
						</thead>
						<tbody>
							for i, row := range snapshot.Completed {
								<tr class="border-b border-line transition-colors last:border-b-0 hover:bg-elev/50">
									<td class="px-3 py-4 align-top">
										@issueCell(row.Issue, "recent", i, false)
									</td>
									<td class="px-3 py-4 align-top font-mono text-sec">{ completedAtLabel(row) }</td>
									<td class="px-3 py-4 align-top font-mono text-sec">{ completedRuntime(row) }</td>
									<td class="px-3 py-4 align-top">
										<div class="grid gap-1 font-mono">
											<span class="font-medium text-text">{ formatTokens(row.Tokens) }</span>
											<span class="text-xs text-sec">{ formatTokenBreakdown(row.Tokens) }</span>
											if contextPressureText(row.Tokens) != "" {
												<span class={ "text-xs " + boardExtraTextClass(contextPressureKind(row.Tokens)) } title={ contextPressureTitle(row.Tokens) }>{ contextPressureText(row.Tokens) }</span>
											}
										</div>
									</td>
									<td class="px-3 py-4 align-top">
										<span class="inline-flex rounded-full bg-ok/15 px-2 py-1 font-medium text-ok">{ completedState(row) }</span>
									</td>
									<td class="px-3 py-4 align-top font-mono text-sec">{ completedModel(row) }</td>
									<td class="px-3 py-4 align-top">
										@sessionCopyButton(row.SessionID)
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</section>
}

templ recentSessionMobileCard(row telemetry.Completed, rowIndex int) {
	<article class="dashboard-card rounded-md border border-line bg-surface p-3 shadow-sm">
		@issueCell(row.Issue, "recent-mobile", rowIndex, false)
		<div class="mt-3 grid gap-2 text-sm">
			<div class="flex min-h-10 items-center justify-between gap-3">
				<span class="text-sec">Completed</span>
				<span class="font-mono text-text">{ completedAtLabel(row) }</span>
			</div>
			<div class="flex min-h-10 items-center justify-between gap-3">
				@plainInlineLabel("Runtime / turns", "text-sec")
				<span class="font-mono text-text">{ completedRuntime(row) }</span>
			</div>
			<div class="flex min-h-10 items-center justify-between gap-3">
				@plainInlineLabel("Tokens", "text-sec")
				<div class="grid min-w-0 justify-items-end gap-1 font-mono">
					<span class="text-text">{ formatTokens(row.Tokens) }</span>
					if contextPressureText(row.Tokens) != "" {
						<span class={ "text-xs " + boardExtraTextClass(contextPressureKind(row.Tokens)) } title={ contextPressureTitle(row.Tokens) }>{ contextPressureText(row.Tokens) }</span>
					}
				</div>
			</div>
			<div class="flex min-h-10 items-center justify-between gap-3">
				<span class="text-sec">Final state</span>
				<span class="rounded-full bg-ok/15 px-2 py-1 font-medium text-ok">{ completedState(row) }</span>
			</div>
			<div class="flex min-h-10 items-center justify-between gap-3">
				<span class="text-sec">Model</span>
				<span class="font-mono text-text">{ completedModel(row) }</span>
			</div>
		</div>
		<div class="mt-3">
			@sessionCopyButton(row.SessionID)
		</div>
	</article>
}

templ issueIdentityLine(identity issueIdentityView, accent bool) {
	<span class="flex min-w-0 max-w-full flex-wrap items-center gap-1.5 font-mono text-xs leading-5" data-primary-identity={ identity.Label }>
		if identity.Repository != "" {
			<span class={ "min-w-0 break-all font-semibold " + identityRepositoryClass(accent) } title={ identity.Repository } data-identity-repository>{ identity.Repository }</span>
		}
		if identity.IssueNumber != "" {
			@primitives.TrackerReferenceLink(identity.IssueNumber, identity.IssueURL, "shrink-0 rounded-sm border px-1.5 py-0.5 font-semibold "+identityIssueBadgeClass(accent))
		}
		if identity.PullRequestLabel != "" {
			@primitives.TrackerReferenceLink(identity.PullRequestLabel, identity.PullRequestURL, "shrink-0 rounded-sm border px-1.5 py-0.5 font-semibold "+identityPullRequestBadgeClass(accent))
		}
	</span>
}

templ issueCell(issue telemetry.Issue, prefix string, rowIndex int, jsonDetails bool) {
	<div class="grid min-w-0 max-w-full gap-2 overflow-hidden" data-issue-identifier={ issueIdentifier(issue) } data-issue-identity={ issueIdentity(issue).Label }>
		<div class="flex min-w-0 items-start gap-2">
			<div class="min-w-0 flex-1 basis-0 overflow-hidden text-left">
				@issueIdentityLine(issueIdentity(issue), false)
				<span class="line-clamp-2 break-words text-sec">{ issueTitle(issue) }</span>
			</div>
			<div class="flex shrink-0 flex-wrap items-start justify-end gap-1.5">
				if issueProjectLabel(issue) != "" {
					<span class="inline-flex max-w-[9rem] overflow-hidden rounded-full bg-elev px-2 py-1 font-mono text-xs text-sec" title={ "Project " + issueProjectLabel(issue) }>
						<span class="min-w-0 truncate">{ issueProjectLabel(issue) }</span>
					</span>
				}
				if issueURL(issue) != "" {
					@issueCopyButton(issueURL(issue))
					@issueOpenLink(issueURL(issue), issueOpenLabel(issue), false)
				}
				if pullRequestURL(issue) != "" {
					@pullRequestOpenLink(pullRequestURL(issue), pullRequestOpenLabel(issue), false)
				}
			</div>
		</div>
		if issueDescriptionPreview(issue) != "" {
			<p class="line-clamp-2 text-xs text-sec">{ issueDescriptionPreview(issue) }</p>
		}
		if issueClaimSummary(issue) != "" {
			<p class="line-clamp-2 font-mono text-xs text-sec">{ issueClaimSummary(issue) }</p>
		}
		if jsonDetails && issueDetailURL(issue) != "" {
			<a class="w-fit text-xs font-medium text-accent underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" href={ issueDetailURL(issue) }>JSON details</a>
		}
	</div>
}

templ issueOpenLink(url string, label string, compact bool) {
	<a class={ issueActionClass(compact) } href={ url } target="_blank" rel="noopener noreferrer" title={ label } aria-label={ label }>
		@icon.ExternalLink(icon.Props{Class: issueActionIconClass(compact)})
		<span class="sr-only">{ label }</span>
	</a>
}

templ pullRequestOpenLink(url string, label string, compact bool) {
	<a class={ issueActionClass(compact) } href={ url } target="_blank" rel="noopener noreferrer" title={ label } aria-label={ label }>
		@icon.GitPullRequest(icon.Props{Class: issueActionIconClass(compact)})
		<span class="sr-only">{ label }</span>
	</a>
}

templ issueCopyButton(value string) {
	<button
		type="button"
		class="issue-copy issue-external inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-line bg-surface text-sec hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
		data-label="Copy issue URL"
		data-copy={ value }
		title={ "Copy " + value }
		onclick="navigator.clipboard.writeText(this.dataset.copy); const label = this.querySelector('[data-copy-label]'); label.textContent = 'Copied'; clearTimeout(this._copyTimer); this._copyTimer = setTimeout(() => { label.textContent = this.dataset.label }, 1200);"
	>
		@icon.Copy(icon.Props{Class: "size-4"})
		<span class="sr-only" data-copy-label>Copy issue URL</span>
	</button>
}

templ diagnosticPromptCopyButton(value string, label string, title string) {
	<button
		type="button"
		class="inline-flex min-h-9 max-w-full items-center gap-2 rounded-md border border-line bg-surface px-2.5 py-1.5 text-xs font-medium text-text hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
		data-label={ label }
		data-copy={ value }
		title={ title }
		aria-label={ title }
		onclick="const done = () => { const label = this.querySelector('[data-copy-label]'); label.textContent = 'Copied'; clearTimeout(this._copyTimer); this._copyTimer = setTimeout(() => { label.textContent = this.dataset.label }, 1200); }; if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(this.dataset.copy).then(done, done); } else { done(); }"
	>
		@icon.ClipboardCopy(icon.Props{Class: "size-3.5 shrink-0"})
		<span class="truncate" data-copy-label>{ label }</span>
	</button>
}

templ sessionCopyButton(sessionID string) {
	if sessionID == "" {
		<span class="font-mono text-sec">n/a</span>
	} else {
		<button
			type="button"
			class="inline-flex min-h-10 max-w-full items-center gap-2 rounded-md border border-line bg-elev px-3 py-2 font-mono text-xs text-text hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
			data-label={ sessionLabel(sessionID) }
			data-copy={ sessionID }
			title={ "Copy " + sessionID }
			onclick="navigator.clipboard.writeText(this.dataset.copy); const label = this.querySelector('[data-copy-label]'); label.textContent = 'Copied'; clearTimeout(this._copyTimer); this._copyTimer = setTimeout(() => { label.textContent = this.dataset.label }, 1200);"
		>
			<span class="truncate" data-copy-label>{ sessionLabel(sessionID) }</span>
			<svg class="shrink-0" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
				<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
			</svg>
		</button>
	}
}

templ budgetCard(snapshot telemetry.Snapshot) {
	<section class={ budgetCardClass(snapshot.Budget) } aria-label="Budget">
		if budgetDisabled(snapshot.Budget) {
			@budgetDisabledNote()
		}
		if !budgetDisabled(snapshot.Budget) {
			@panelHeader(icon.Wallet(icon.Props{Class: "size-4 shrink-0"}), "Budget", helpBudget, "budget-card") {
				<span class="shrink-0 rounded-full bg-elev px-2 py-1 text-xs font-medium text-sec">{ budgetStatus(snapshot.Budget) }</span>
			}
			<div class="mt-5 grid gap-4 text-sm">
				<div class="grid gap-2">
					<div class="flex items-center justify-between gap-4">
						@plainInlineLabel("Spend today", "text-sec")
						<strong class="font-mono font-medium text-text">{ budgetSpendTodayLabel(snapshot.Budget) }</strong>
					</div>
					<div class="h-2 overflow-hidden rounded-full bg-elev" aria-label="Daily budget usage">
						<div class="h-full rounded-full bg-accent transition-all" style={ budgetDailyUsageStyle(snapshot.Budget) }></div>
					</div>
				</div>
				if !budgetBurnDownView(snapshot).Available {
					@dashboardEmptyState(budgetBurnDownView(snapshot).EmptyTitle, budgetBurnDownView(snapshot).EmptyDetail, "bg-accent")
				} else {
					<div class="grid gap-3">
						<div class="flex items-center justify-between gap-4">
							@plainInlineLabel("Cost burn-down", "font-medium text-sec")
							<span class="font-mono text-xs text-sec">{ budgetBurnDownView(snapshot).PeriodLabel }</span>
						</div>
						@BudgetProjectionChart(budgetBurnDownView(snapshot).Chart)
						<div class="grid grid-cols-3 gap-2 font-mono text-xs text-sec">
							<span>Spend { budgetBurnDownView(snapshot).CurrentLabel }</span>
							<span>Cap { budgetBurnDownView(snapshot).CapLabel }</span>
							<span>Projected { budgetBurnDownView(snapshot).ProjectionLabel }</span>
						</div>
					</div>
				}
				if len(budgetHistoryBars(snapshot.Budget)) == 0 {
					@dashboardEmptyState("No budget history yet.", "Spend bars will appear after daily budget samples are recorded.", "bg-accent")
				} else {
					<div class="grid gap-2">
						<div class="flex items-center justify-between gap-4">
							@plainInlineLabel("Budget history", "font-medium text-sec")
							<span class="font-mono text-xs text-sec">{ budgetHistoryCount(snapshot.Budget) }</span>
						</div>
						<div class="grid h-12 grid-cols-7 items-end gap-1 rounded-md border border-line bg-elev px-2 py-2" aria-label="Spend over the last seven days">
							for _, bar := range budgetHistoryBars(snapshot.Budget) {
								<span class="block min-h-1 rounded-t bg-accent opacity-80" style={ bar.Style } title={ bar.Title }>
									<span class="sr-only">{ bar.Title }</span>
								</span>
							}
						</div>
					</div>
				}
				<div class="grid gap-3 border-t border-line pt-3">
					<div class="flex items-center justify-between gap-4">
						@plainInlineLabel("Projected", "text-sec")
						<strong class="font-mono font-medium text-text">{ budgetBurnDownView(snapshot).ProjectionLabel }</strong>
					</div>
					<div class="flex items-center justify-between gap-4">
						@plainInlineLabel("Daily cap", "text-sec")
						<strong class="font-mono font-medium text-text">{ optionalUSD(snapshot.Budget.PerDayMaxUSD) }</strong>
					</div>
					<div class="flex items-center justify-between gap-4">
						@plainInlineLabel("Issue cap", "text-sec")
						<strong class="font-mono font-medium text-text">{ optionalUSD(snapshot.Budget.PerIssueMaxUSD) }</strong>
					</div>
				</div>
				if len(snapshot.Budget.Refusals) > 0 {
					<div class="grid gap-2 border-t border-line pt-3" aria-label="Budget holds">
						<div class="flex items-center justify-between gap-4">
							@plainInlineLabel("Budget holds", "font-medium text-sec")
							<span class="font-mono text-xs text-sec">{ formatInt(int64(len(snapshot.Budget.Refusals))) }</span>
						</div>
						for _, refusal := range snapshot.Budget.Refusals {
							<div class="grid gap-1 rounded-md border border-line bg-elev px-3 py-2">
								<div class="flex items-center justify-between gap-3">
									<strong class="min-w-0 truncate font-mono text-xs font-medium text-text">{ budgetRefusalLabel(refusal) }</strong>
									<span class={ budgetRefusalBadgeClass(refusal) }>{ budgetRefusalDisposition(refusal) }</span>
								</div>
								<p class="text-xs text-sec">{ budgetRefusalDetail(refusal) }</p>
							</div>
						}
					</div>
				}
			</div>
		}
	</section>
}

templ budgetDisabledNote() {
	<p class="truncate text-sm text-sec">Budget disabled - enable a daily cap in configuration.</p>
}

templ rateLimitsCard(limits *RateLimits) {
	<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5">
		@panelHeader(icon.Gauge(icon.Props{Class: "size-4 shrink-0"}), "Rate limits", helpRateLimits, "rate-limits-card") {
			<span class="shrink-0 rounded-full bg-accent/15 px-2 py-1 text-xs font-medium text-accent">{ rateLimitName(limits) }</span>
		}
		if len(rateLimitRows(limits)) == 0 {
			<div class="mt-4">
				@dashboardEmptyState("No rate-limit snapshot.", "Limits will appear after Codex or the tracker reports quota data.", "bg-accent")
			</div>
		} else {
			<div class="mt-5 grid gap-4">
				for _, row := range rateLimitRows(limits) {
					<div class="grid gap-2">
						<div class="flex items-center justify-between gap-3">
							@plainInlineLabel(row.Name, "font-medium text-text")
							<span class="font-mono text-sm text-sec">{ row.Reset }</span>
						</div>
						<div class="h-2 overflow-hidden rounded-full bg-elev">
							<div class="h-full rounded-full bg-accent transition-all" style={ percentStyle(row.UsedPercent) }></div>
						</div>
						<div class="grid grid-cols-3 gap-2 font-mono text-xs text-sec">
							<span>{ row.Remaining }</span>
							<span>{ row.Used }</span>
							<span>{ row.Limit }</span>
						</div>
					</div>
				}
			</div>
		}
	</section>
}

templ graphQLBudgetCard(data DashboardData) {
	if hasGraphQLBudget(data.Snapshot.RateLimits) {
		<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5" aria-label="GraphQL budget">
			@panelHeader(icon.Github(icon.Props{Class: "size-4 shrink-0"}), "GraphQL budget", helpRateLimits, "graphql-budget-card") {
				<span class="shrink-0 rounded-full bg-warn/15 px-2 py-1 font-mono text-xs font-medium text-warn">{ graphQLBudgetCycleCost(data.Snapshot.RateLimits) }</span>
			}
			<div class="mt-5 grid gap-3">
				<div class="grid grid-cols-2 gap-3 text-sm">
					<div class="grid gap-1">
						<span class="text-sec">Remaining</span>
						<strong class="break-all font-mono text-base font-semibold text-text">{ graphQLBudgetRemaining(data.Snapshot.RateLimits) }</strong>
					</div>
					<div class="grid gap-1">
						<span class="text-sec">Reset</span>
						<strong class="font-mono text-base font-semibold text-text">{ graphQLBudgetReset(data.Snapshot.RateLimits, data.Snapshot.GeneratedAt) }</strong>
						<span class="font-mono text-xs text-sec">{ graphQLBudgetResetAt(data.Snapshot.RateLimits) }</span>
					</div>
				</div>
				<div class="flex items-center justify-between gap-3 border-t border-line pt-3 text-sm">
					<span class="text-sec">Cycle queries</span>
					<strong class="font-mono font-medium text-text">{ graphQLBudgetQueryCount(data.Snapshot.RateLimits) }</strong>
				</div>
				if len(graphQLBudgetContributorRows(data.Snapshot.RateLimits)) == 0 {
					@dashboardEmptyState("No GraphQL query costs this cycle.", "Query contributors will appear after the GitHub connector reports rateLimit cost.", "bg-warn")
				} else {
					<div class="grid gap-2 border-t border-line pt-3">
						for _, row := range graphQLBudgetContributorRows(data.Snapshot.RateLimits) {
							<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 text-sm">
								<span class="truncate font-mono font-medium text-text">{ row.QueryType }</span>
								<span class="font-mono text-sec">{ row.Cost }</span>
								<span class="font-mono text-xs text-sec">{ row.Count }</span>
								<span class="text-right font-mono text-xs text-sec">{ row.Percent }</span>
							</div>
						}
					</div>
				}
			</div>
		</section>
	}
}

templ restBudgetCard(data DashboardData) {
	if hasRESTBudget(data.Snapshot.RateLimits) {
		<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5" aria-label="REST budget">
			@panelHeader(icon.Server(icon.Props{Class: "size-4 shrink-0"}), "REST budget", helpRateLimits, "rest-budget-card") {
				<span class="shrink-0 rounded-full bg-warn/15 px-2 py-1 font-mono text-xs font-medium text-warn">{ restBudgetRequestCount(data.Snapshot.RateLimits) }</span>
			}
			<div class="mt-5 grid gap-3">
				<div class="grid grid-cols-2 gap-3 text-sm">
					<div class="grid gap-1">
						<span class="text-sec">Remaining</span>
						<strong class="break-all font-mono text-base font-semibold text-text">{ restBudgetRemaining(data.Snapshot.RateLimits) }</strong>
					</div>
					<div class="grid gap-1">
						<span class="text-sec">Reset</span>
						<strong class="font-mono text-base font-semibold text-text">{ restBudgetReset(data.Snapshot.RateLimits, data.Snapshot.GeneratedAt) }</strong>
						<span class="font-mono text-xs text-sec">{ restBudgetResetAt(data.Snapshot.RateLimits) }</span>
					</div>
				</div>
				if len(restBudgetContributorRows(data.Snapshot.RateLimits)) == 0 {
					@dashboardEmptyState("No REST requests this cycle.", "REST contributors will appear after GitHub REST endpoints are called.", "bg-warn")
				} else {
					<details class="group border-t border-line pt-3" data-preserve-details="rest-budget-contributors">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm text-sec marker:hidden">
							<span class="font-medium text-text">Endpoint details</span>
							<span class="inline-flex shrink-0 items-center gap-2">
								<span class="rounded-md bg-elev px-2 py-1 font-mono text-xs text-sec">{ formatInt(int64(len(restBudgetContributorRows(data.Snapshot.RateLimits)))) }</span>
								@icon.ChevronDown(icon.Props{Class: "size-3.5 shrink-0 transition-transform group-open:rotate-180"})
							</span>
						</summary>
						<div class="mt-3 grid gap-2">
							for _, row := range restBudgetContributorRows(data.Snapshot.RateLimits) {
								<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 text-sm">
									<span class="truncate font-mono font-medium text-text">{ row.EndpointFamily }</span>
									<span class="font-mono text-sec">{ row.Count }</span>
									<span class="font-mono text-xs text-sec">{ row.Remaining }</span>
									<span class="text-right font-mono text-xs text-sec">{ row.Status }</span>
								</div>
							}
						</div>
					</details>
				}
			</div>
		</section>
	}
}

templ tokenCard(data DashboardData) {
	<section class="dashboard-panel min-w-0 rounded-md border border-line bg-surface p-4 shadow-sm sm:p-5">
		@panelHeader(icon.Coins(icon.Props{Class: "size-4 shrink-0"}), "Tokens", helpTokens, "tokens-card") {
			<span class="shrink-0 rounded-full bg-elev px-2 py-1 font-mono text-xs font-medium text-sec">{ tokenRate(data.Snapshot) }</span>
		}
		<div class="mt-5 grid gap-2">
			<div class="break-all font-mono text-2xl font-semibold text-text sm:text-3xl">{ formatTokens(data.Snapshot.Tokens) }</div>
			<div class="font-mono text-sm text-sec">{ formatTokenBreakdown(data.Snapshot.Tokens) }</div>
		</div>
		<div class="mt-5">
			<div class="mb-2 flex items-center justify-between gap-3 text-sm">
				@plainInlineLabel("Token trend", "font-medium text-sec")
				<span class="font-mono text-xs text-sec">{ formatDuration(data.Snapshot.Tokens.RuntimeSeconds) }</span>
			</div>
			if len(tokenTrendPoints(data.Snapshot)) == 0 {
				@dashboardEmptyState("No token trend yet.", "Input and output token samples will appear after active sessions report usage.", "bg-accent")
			} else {
				@SplitSeriesChart(tokenTrendChart(data.Snapshot))
				<div class="mt-3 flex flex-wrap items-center gap-4 text-xs font-medium text-sec">
					<span class="inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-accent"></span>Input</span>
					<span class="inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-ok"></span>Output</span>
				</div>
			}
		</div>
	</section>
}
