package templates

import (
	"github.com/digitaldrywood/detent/internal/web/ui/components/dialog"
	"github.com/digitaldrywood/detent/internal/web/ui/primitives"
)

// DetailSheetHost is the body-level mount point for the session detail
// sheet. It lives outside #snapshot so SSE morphs can never tear an open
// sheet down.
templ DetailSheetHost() {
	<div id="detail-sheet-host"></div>
}

// BoardCardSheet is the Linear-style right panel opened from board cards
// and exception-strip Review actions: issue identity, state, PR facts,
// blockers, the live session, and the kanban actions the project's mode
// allows.
templ BoardCardSheet(data DashboardData, card projectKanbanCard, boardActions bool, expanded bool, conversation KanbanConversationData, activity BoardActivityData, sessionData BoardSessionData) {
	{{ session := sheetSessionFor(data.Snapshot, card) }}
	{{ receipt, hasReceipt := efficiencyReceiptForCard(data, card) }}
	<div class="fixed inset-0 z-50 flex min-w-0 justify-end overflow-x-hidden" data-detail-sheet>
		<div class="hidden flex-1 bg-page/60 md:block" data-sheet-close aria-hidden="true"></div>
		<aside class={ boardCardSheetClass(expanded) } role="dialog" aria-modal="true" aria-label={ "Details for " + card.IssueNumber }>
			<header class="flex flex-none items-start gap-3 border-b border-line px-4 py-3 md:px-5 md:py-4">
				<div class="flex min-w-0 flex-1 flex-col gap-1">
					<div class="flex min-w-0 items-center gap-2 font-mono text-xs font-medium text-sec">
						<span class="min-w-20 truncate">{ projectKanbanCardProjectID(data, card) }</span>
						@primitives.TrackerReferenceLink(card.IssueNumber, card.URL, "inline-flex min-h-11 max-w-48 flex-none items-center truncate text-text md:min-h-0 md:inline")
					</div>
					<h2 class="text-sm font-medium leading-snug text-text">{ card.Title }</h2>
				</div>
				<button type="button" class="inline-flex size-11 flex-none items-center justify-center rounded-chip text-sec hover:bg-elev hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent md:size-auto md:p-1" data-sheet-close aria-label="Close details">✕</button>
			</header>
			<div class="flex min-h-0 min-w-0 flex-1 flex-col gap-4 overflow-x-hidden overflow-y-auto px-4 py-4 overscroll-contain md:px-5">
				<div class="flex flex-col gap-2 text-xs">
					@sheetRowText("State") {
						<span class={ "flex items-center gap-1.5 " + boardExtraTextClass(sheetStateKind(data, card)) }>
							@primitives.StatusDot(sheetStateKind(data, card), false)
							{ card.Stage }
						</span>
					}
					if card.TimeInStage != "" && card.TimeInStage != "n/a" {
						@sheetRowValue("Time in stage", card.TimeInStage, card.TimeInStageTitle)
					}
					if card.WaitDetail != "" {
						@sheetRowValue("Waiting on", card.WaitDetail, card.WaitDetail)
					}
					@sheetRowLink("Issue", card.Identifier, card.URL)
					if card.HasPullRequest {
						@sheetRowLink("Pull request", card.PullRequestLabel, card.PRURL)
						if card.CIStatus != "" {
							@sheetRowValue("CI", card.CIStatus, "Continuous integration status")
						}
						if card.CodexReviewState != "" {
							@sheetRowValue("Codex review", card.CodexReviewState, "Codex review state")
						}
						if card.MergeableState != "" {
							@sheetRowValue("Merge state", card.MergeableState, "GitHub mergeStateStatus")
						}
					}
				</div>
				if card.AttentionLabel != "" || len(card.Blockers) > 0 || card.ConflictReason != "" {
					<div class="flex flex-col gap-1.5">
						<h3 class="text-2xs font-semibold uppercase tracking-[0.06em] text-dim">Needs attention</h3>
						if card.AttentionLabel != "" {
							@primitives.Chip(primitives.KindErr, sheetAttentionLabel(card))
						}
						for _, blocker := range card.Blockers {
							@primitives.Chip(primitives.KindErr, "blocked — "+blocker)
						}
						if card.ConflictReason != "" {
							@primitives.Chip(primitives.KindWarn, card.ConflictReason)
						}
					</div>
				}
				if session.Present {
					<div class="flex flex-col gap-2">
						<h3 class="text-2xs font-semibold uppercase tracking-[0.06em] text-dim">Session</h3>
						<div class="flex flex-col gap-2 rounded-card border border-line bg-elev p-3 text-xs">
							@sheetRowText("Status") {
								<span class={ "flex items-center gap-1.5 " + boardExtraTextClass(session.Kind) }>
									@primitives.StatusDot(session.Kind, session.Kind == primitives.KindOK)
									{ session.State }
								</span>
							}
							@sheetRowValue("Agent system", runtimeIdentityString(runtimeIdentitySystemName(session.RuntimeIdentity.BackendKind)), "")
							@sheetRowValue("Backend profile", runtimeIdentityString(session.RuntimeIdentity.BackendID), "")
							if session.RuntimeIdentity.Role != "" {
								@sheetRowValue("Agent role", session.RuntimeIdentity.Role, "")
							}
							@sheetRowValue("Provider", runtimeIdentityDetailValue(session.RuntimeIdentity.Provider), "")
							@sheetRowValue("Model", runtimeIdentityDetailValue(runtimeIdentityModelValue(session.RuntimeIdentity)), "")
							if session.RuntimeIdentity.RequestedDiffers() {
								@sheetRowValue("Requested model", runtimeIdentityDetailValue(session.RuntimeIdentity.RequestedModel), "")
							}
							@sheetRowValue("Effort", runtimeIdentityDetailValue(session.RuntimeIdentity.ReasoningEffort), "")
							if !session.RuntimeIdentity.ServiceTier.IsZero() {
								@sheetRowValue("Service tier", runtimeIdentityDetailValue(session.RuntimeIdentity.ServiceTier), "")
							}
							if session.Runtime != "" {
								@sheetRowValue("Runtime", session.Runtime+" · "+session.Turns+" turns", "")
							}
							if session.Host != "" {
								@sheetRowValue("Worker", session.Host, "")
							}
							if session.SessionID != "" {
								@sheetRowValue("Session", session.SessionID, session.SessionID)
							}
							if session.LastEvent != "" {
								@sheetRowValue("Last event", session.LastEvent, session.Message)
							}
							if session.Error != "" {
								<p class="break-words text-err [overflow-wrap:anywhere]">{ session.Error }</p>
							}
						</div>
					</div>
				}
				if hasReceipt {
					<div id="efficiency-receipt" class="flex flex-col gap-2">
						<div class="flex items-center justify-between gap-2">
							<h3 class="text-2xs font-semibold uppercase tracking-[0.06em] text-dim">Efficiency receipt</h3>
							if receipt.Anomalous() {
								@primitives.Chip(primitives.KindWarn, "Anomaly")
							}
						</div>
						<div class="flex flex-col gap-2 rounded-card border border-line bg-elev p-3 text-xs">
							@sheetRowValue("Sessions · attempts", formatInt(receipt.Sessions)+" · "+formatInt(receipt.Attempts), "")
							@sheetRowValue("Tokens", formatInt(receipt.TotalTokens), formatInt(receipt.FreshInputTokens())+" fresh input · "+formatInt(receipt.CachedInputTokens)+" cached input · "+formatInt(receipt.OutputTokens)+" output")
							@sheetRowValue("Cache share", reportCacheReadFraction(receipt.CacheShare()), "")
							@sheetRowValue("Estimated cost", formatUSD(receipt.EstimatedCostUSD), "")
							@sheetRowValue("Wall clock", formatDuration(float64(receipt.WallSeconds)), "")
							@sheetRowValue("Dwell", formatDuration(float64(receipt.WorkingSeconds))+" working · "+formatDuration(float64(receipt.GateWaitSeconds))+" gate · "+formatDuration(float64(receipt.MergeTrainSeconds))+" merge · "+formatDuration(float64(receipt.ParkedSeconds))+" parked", "")
							@sheetRowValue("Retries", formatInt(receipt.Redispatches)+" redispatches · "+formatInt(receipt.CIReruns)+" CI reruns · "+formatInt(receipt.BreakerTrips)+" breakers", "")
						</div>
					</div>
				}
				@BoardActivityTabs(activity, sessionData)
				if len(card.Labels) > 0 {
					@sheetTagRow("Labels", card.Labels)
				}
				if len(card.Assignees) > 0 {
					@sheetTagRow("Assignees", card.Assignees)
				}
				@KanbanConversation(conversation)
			</div>
			if sheetHasActions(data, card, boardActions) {
				<footer class="flex flex-none flex-wrap items-center gap-2 border-t border-line px-4 py-3 md:flex-nowrap md:px-5">
					<div id="kanban-feedback" role="status" aria-live="polite" hidden></div>
					if projectKanbanCardCanMove(data, card) {
						@dialog.Trigger(dialog.TriggerProps{For: kanbanActionDialogID}) {
							<button
								type="button"
								class="min-h-11 rounded-card border border-line px-3 py-1.5 text-xs font-medium text-text hover:border-accent hover:text-accent md:min-h-0"
								hx-get={ projectKanbanMoveDialogPath(data, card) }
								hx-target={ kanbanDialogTargetSelector() }
								hx-swap="innerHTML"
							>Move</button>
						}
					}
					if projectKanbanCardCanCommentOnIssue(data, card) {
						@sheetCommentTrigger(data, card, "issue", "Comment on issue")
					}
					if projectKanbanCardCanCommentOnPullRequest(data, card) && conversation.PRCommentsSupported {
						@sheetCommentTrigger(data, card, "pr", "Comment on PR")
					}
					if projectKanbanCardCanRemove(data, card) {
						<form class="inline-flex" hx-post="/api/v1/kanban/remove" hx-target="#kanban-feedback" hx-swap="outerHTML" hx-confirm="Remove this item from the project?">
							<input type="hidden" name="project_id" value={ projectKanbanCardProjectID(data, card) }/>
							<input type="hidden" name="issue_id" value={ card.IssueID }/>
							<input type="hidden" name="current_state" value={ card.Stage }/>
							<button type="submit" class="min-h-11 rounded-card border border-err/40 px-3 py-1.5 text-xs font-medium text-err hover:bg-err/15 md:min-h-0">Remove</button>
						</form>
					}
					<span class="flex-1"></span>
					if card.URL != "" {
						<a href={ card.URL } target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-xs font-medium text-accent hover:underline md:inline md:min-h-0">Open on GitHub ↗</a>
					}
				</footer>
			} else if card.URL != "" {
				<footer class="flex flex-none items-center justify-end border-t border-line px-4 py-3 md:px-5">
					<a href={ card.URL } target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-xs font-medium text-accent hover:underline md:inline md:min-h-0">Open on GitHub ↗</a>
				</footer>
			}
		</aside>
	</div>
}

// sheetCommentTrigger opens the shared kanban comment dialog for the card's
// issue or PR, preserving the pre-redesign operator comment workflow.
templ sheetCommentTrigger(data DashboardData, card projectKanbanCard, target string, label string) {
	@dialog.Trigger(dialog.TriggerProps{For: kanbanActionDialogID}) {
		<button
			type="button"
			class="min-h-11 rounded-card border border-line px-3 py-1.5 text-xs font-medium text-text hover:border-accent hover:text-accent md:min-h-0"
			hx-get={ projectKanbanCommentDialogPath(data, card, target) }
			hx-target={ kanbanDialogTargetSelector() }
			hx-swap="innerHTML"
			aria-label={ label + " " + card.IssueNumber }
			title={ label }
		>
			if target == "pr" {
				Comment · PR
			} else {
				Comment
			}
		</button>
	}
}

templ sheetRowText(label string) {
	<div class="flex min-w-0 flex-col items-start gap-1 md:flex-row md:items-center md:justify-between md:gap-3" data-sheet-row={ label }>
		<span class="flex-none text-sec">{ label }</span>
		{ children... }
	</div>
}

templ sheetRowValue(label string, value string, title string) {
	<div class="flex min-w-0 flex-col items-start gap-1 md:flex-row md:items-center md:justify-between md:gap-3" data-sheet-row={ label }>
		<span class="flex-none text-sec">{ label }</span>
		<span class="w-full min-w-0 break-words font-mono text-text tabular-nums [overflow-wrap:anywhere] md:w-auto md:truncate" title={ title } data-sheet-row-value>{ value }</span>
	</div>
}

templ sheetRowLink(label string, value string, href string) {
	if value != "" {
		<div class="flex min-w-0 flex-col items-start gap-1 md:flex-row md:items-center md:justify-between md:gap-3" data-sheet-row={ label }>
			<span class="flex-none text-sec">{ label }</span>
			@primitives.TrackerReferenceLink(value, href, "inline-flex min-h-11 w-full min-w-0 items-center break-words font-mono text-text [overflow-wrap:anywhere] md:inline md:min-h-0 md:w-auto md:truncate")
		</div>
	}
}

templ sheetTagRow(label string, values []string) {
	<div class="flex flex-col gap-1.5">
		<h3 class="text-2xs font-semibold uppercase tracking-[0.06em] text-dim">{ label }</h3>
		<div class="flex flex-wrap gap-1.5">
			for _, value := range values {
				<span class="inline-flex min-h-11 max-w-full items-center break-words rounded-chip bg-elev px-2 py-0.5 font-mono text-2xs whitespace-normal text-sec [overflow-wrap:anywhere] md:min-h-0 md:max-w-48 md:truncate" title={ value }>{ value }</span>
			}
		</div>
	</div>
}
