package primitives

// Chip is a passive tinted chip: 15% alpha semantic background, colored
// text, 4px radius, prefixed with the status glyph so color never carries
// the state alone. Chips are reserved for action-required states — callers
// must not render one for a zero count or a passive fact.
templ Chip(kind Kind, label string) {
	<span class={ "inline-flex items-center gap-1.5 rounded-chip px-2 py-0.5 text-2xs font-medium " + kind.chipClass() }>
		<span aria-hidden="true">{ kind.Glyph() }</span>
		{ label }
	</span>
}
